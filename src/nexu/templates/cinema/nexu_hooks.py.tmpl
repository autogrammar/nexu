def append_policy_entry(stage: int, keep, delete, status: str, model: str, **kwargs):
    cinema = Path(__file__).resolve().parent
    active = load_active_project(cinema) or {}
    project_id = str(active.get("id") or "").strip()
    project_kind = str(active.get("kind") or "").strip().lower()
    domain = "calculator" if project_kind == "calculator" else "web"
    return append_iteration_ledger_entry(
        ROOT,
        CAPSULE,
        stage=stage,
        keep=keep,
        delete=delete,
        status=status,
        model=model,
        domain=domain,
        project_id=project_id,
        focus_scope=str(kwargs.get("focus_scope") or "").strip(),
        cinema_dir=cinema,
    )


def append_goal_policy_entry(stage: int, goal: str, **kwargs):
    cinema = Path(__file__).resolve().parent
    active = load_active_project(cinema) or {}
    ctx = str(kwargs.pop("project_context", "") or "").strip()
    kind = str(kwargs.pop("project_kind", "") or active.get("kind") or "").strip()
    if not ctx and active:
        title = str(active.get("title") or active.get("id") or "").strip()
        active_kind = str(active.get("kind") or "").strip()
        ctx = f"{title} ({active_kind})".strip() if active_kind else title
    return append_goal_ledger_entry(
        ROOT,
        CAPSULE,
        stage=stage,
        goal=goal,
        project_context=ctx,
        project_kind=kind,
        **kwargs,
    )


