                return

        elif self.path == '/promote':
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            try:
                data = json.loads(post_data.decode('utf-8', errors='replace')) if post_data else {}
                alt_name = str(data.get('alt', 'alt_a.html')).split('?')[0]
                stage = int(data.get('stage', 0))
                allowed_alts = {'alt_a.html', 'alt_b.html', 'alt_c.html'}
                if alt_name not in allowed_alts:
                    payload = {"error": f"unsupported option file: {alt_name}"}
                elif stage < 0 or stage > 2:
                    payload = {"error": f"unsupported stage: S{stage}"}
                else:
                    alt_path = DIRECTORY / alt_name
                    stage_path = DIRECTORY / f'stage{stage}.html'
                    if not alt_path.exists():
                        payload = {"error": f"option file not found: {alt_name}"}
                    else:
                        stage_path.write_text(alt_path.read_text(encoding='utf-8'), encoding='utf-8')
                        options_sync = _patch_option_previews(stage)
                        history_entry = _save_history_checkpoint(
                            action='promote',
                            stage=stage,
                            status='promoted',
                            extra=alt_name,
                        )
                        payload = {
                            "status": "promoted",
                            "alt": alt_name,
                            "stage": stage,
                            "stage_path": str(stage_path.name),
                            "history_checkpoint": history_entry,
                            "options_sync": options_sync,
                        }
                self.send_response(200)
                self.send_header('Content-type', 'application/json; charset=utf-8')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(json.dumps(payload, ensure_ascii=False).encode('utf-8'))
                return
            except Exception as e:
                self.send_response(500)
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(str(e).encode('utf-8'))
                return

        elif self.path == '/iterate':
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            try:
                data = json.loads(post_data.decode('utf-8', errors='replace'))
                spatial_feedback = data.get('prompt', '')
                current_stage = int(data.get('current_stage', 0))
                annotations = data.get('annotations', [])
                user_hints = data.get('user_hints', [])
                if not isinstance(user_hints, list):
                    user_hints = []
                normalized_hints = [str(item).strip() for item in user_hints if str(item).strip()]
                hints_block = "\n".join(f"- {hint}" for hint in normalized_hints) if normalized_hints else "none provided"
                
                # Read current active stage HTML
                stage_file = DIRECTORY / f'stage{current_stage}.html'
                current_html = stage_file.read_text(encoding='utf-8') if stage_file.exists() else '<p>No stage found</p>'
                
                # Build structured LLM prompt from spatial annotations
                pending_goal = bool(data.get('pending_goal', False))
                requested_mode = str(data.get('iteration_mode', '') or '').strip()
                session_keep = [a['id'] for a in annotations if a.get('type') == 'KEEP']
                session_delete = [a['id'] for a in annotations if a.get('type') == 'DELETE']
                if session_delete or session_keep:
                    pending_goal = False
                policy_payload = _load_policy_payload()
                ledger_ui = policy_payload.get("effective_ui") or {}
                ledger_keep = list(ledger_ui.get("keep") or [])
                ledger_delete = list(ledger_ui.get("delete") or [])
                keep_els, delete_els = _merge_ui_constraints(
                    ledger_keep, ledger_delete, session_keep, session_delete
                )
                if delete_els or keep_els or requested_mode == 'active_workspace':
                    apply_active = bool(delete_els or keep_els)
                    apply_options = False
                elif (pending_goal or requested_mode == 'goal_options') and normalized_hints:
                    apply_active = False
                    apply_options = True
                elif normalized_hints:
                    apply_active = False
                    apply_options = True
                else:
                    apply_active = False
                    apply_options = False

                def _build_llm_prompt(*, variant_note: str = "") -> str:
                    variant_block = f"Variant direction:\n{variant_note}\n\n" if variant_note else ""
                    ledger_block = ""
                    if ledger_keep or ledger_delete:
                        ledger_block = (
                            "Accumulated policy contracts from earlier Cinema iterations (MUST respect):\n"
                            "- KEEP from ledger: " + (', '.join(ledger_keep) if ledger_keep else 'none') + "\n"
                            "- DELETE from ledger: " + (', '.join(ledger_delete) if ledger_delete else 'none') + "\n\n"
                        )
                    prompt = (
                        "You are evolving a calculator web UI. Below is the current HTML.\n\n"
                        "Current HTML:\n```html\n" + current_html + "\n```\n\n"
                        + variant_block
                        + ledger_block
                        + "Effective UI constraints for this request (ledger + current marks):\n"
                        "- KEEP these elements (user likes them): "
                        + (', '.join(keep_els) if keep_els else 'none specified') + "\n"
                        "- REDESIGN/DELETE these elements (user wants them changed or removed): "
                        + (', '.join(delete_els) if delete_els else 'none specified') + "\n\n"
                        "User goal/hints:\n" + hints_block + "\n\n"
                        "Additional context: " + spatial_feedback + "\n\n"
                        "Rules:\n"
                        "1. Return ONLY the complete evolved HTML document, nothing else.\n"
                        "2. Keep the same overall structure (full <!DOCTYPE html> page).\n"
                        "3. Preserve elements marked KEEP - do not change their function.\n"
                        "4. For DELETE elements: remove ONLY those buttons from the HTML — do not remove anything else.\n"
                        "5. Do NOT simplify the calculator or drop scientific buttons unless they are in the DELETE list.\n"
                        "6. Improve visual design only when explicitly asked in hints; otherwise preserve layout.\n"
                        "7. Keep the same CSS class names (.btn, .btn-sci, .btn-sci-excess, .btn-op, .screen) so buttons work.\n"
                        "8. Do NOT include any <script> tags — runtime is injected by Nexu after generation.\n"
                        "9. Each option variant must be visually and functionally distinct.\n"
                        "10. Use id=screen for the display and class=btn / btn-sci / btn-op on buttons.\n"
                        "11. When generating chemical-calculator variants, still include buttons listed under KEEP "
                        "(e.g. sin, cos, tan, log, ln) unless they appear under DELETE.\n"
                    )
                    if keep_els and apply_options:
                        trig = [t for t in keep_els if t in ('sin', 'cos', 'tan', 'log', 'ln')]
                        if trig:
                            prompt += (
                                "\n\nCRITICAL: These controls were explicitly kept and must appear in the HTML: "
                                + ", ".join(trig) + "."
                            )
                    if delete_els and not variant_note:
                        delete_list = ", ".join(delete_els)
                        prompt += (
                            "\n\nCRITICAL: Remove ONLY these controls: "
                            + delete_list
                            + ". Every other button (sin, cos, tan, log, ln, EXP, pi, digits, operators) must remain."
                        )
                    prompt += "\n\nReturn the full HTML:"
                    return prompt

                def _apply_spatial_patch(html: str, delete_els: list) -> tuple[str | None, list]:
                    try:
                        import nexu_hooks
                    except ImportError:
                        return None, []
                    return nexu_hooks.apply_spatial_patch(html, delete_els)

                def _finalize_llm_html(html: str) -> str:
                    import re
                    if not html:
                        return html
                    cleaned = re.sub(
                        r'<script\b[^>]*>[\s\S]*?</script>', '', html, flags=re.I
                    )
                    inject = ''
                    for name in ('_inject_shield.html', '_inject_runtime.html'):
                        path = DIRECTORY / name
                        if path.exists():
                            inject += path.read_text(encoding='utf-8')
                    lower = cleaned.lower()
                    if '</body>' in lower:
                        idx = lower.rfind('</body>')
                        return cleaned[:idx] + inject + cleaned[idx:]
                    return cleaned.rstrip() + inject + '\n</body>\n</html>\n'

                def _call_llm(prompt: str) -> tuple[str | None, str | None]:
                    _ensure_api_key_env()
                    api_key = os.environ.get(API_KEY_ENV, '')
                    model = _resolve_model()
                    if not ALLOW_NETWORK_CALLS:
                        return None, 'llm.allow_network_calls disabled in nexu.yaml'
                    if not _litellm_available():
                        return None, (
                            'litellm is not installed for the cinema server Python '
                            f'({SYS_EXE}). From the nexu repo run: uv sync && make cinema'
                        )
                    if not api_key:
                        return None, f'{API_KEY_ENV} not set'
                    try:
                        from litellm import completion as llm_completion
                        response = llm_completion(
                            model=model,
                            messages=[
                                {"role": "system", "content": "You are a UI evolution engine. Return only complete HTML documents. No markdown fences, no explanation."},
                                {"role": "user", "content": prompt},
                            ],
                            temperature=0.35,
                            max_tokens=MAX_TOKENS,
                            timeout=90,
                            api_key=api_key,
                            api_base='https://openrouter.ai/api/v1',
                        )
                        content = _extract_llm_content(response)
                        if content is None:
                            return None, 'LLM returned empty content'
                        raw = _strip_markdown_fences(str(content))
                        if raw and '<!DOCTYPE' in raw.upper()[:50]:
                            return _finalize_llm_html(raw), None
                        return None, 'Invalid HTML returned'
                    except ModuleNotFoundError:
                        return None, (
                            'litellm is not installed for the cinema server Python '
                            f'({SYS_EXE}). From the nexu repo run: uv sync && make cinema'
                        )
                    except Exception as llm_exc:
                        return None, _compact_llm_error(str(llm_exc))

                _ensure_api_key_env()
                model = _resolve_model()
                evolved_html = None
                llm_error = None
                options_written: list[str] = []
                spatial_removed: list[str] = []
                iteration_mode = "none"

                if not apply_active and not apply_options:
                    status_msg = 'llm_skipped: no spatial feedback or goal provided'
                elif apply_options:
                    iteration_mode = "options_only"
                    hints_text = "; ".join(normalized_hints)
                    goal_focus = (" Primary user goal: " + hints_text + ".") if hints_text else ""
                    if any("chem" in h.lower() for h in normalized_hints):
                        goal_focus += (
                            " Build chemical-calculator UIs: element buttons (H,O,C,N),"
                            " molar mass display, formula entry."
                        )
                        if keep_els:
                            goal_focus += (
                                " Preserve all KEEP controls from policy: "
                                + ", ".join(keep_els[:24])
                                + ("…" if len(keep_els) > 24 else "")
                                + "."
                            )
                    option_variants = [
                        (
                            "alt_a.html",
                            "Option A (minimal)",
                            "Minimalist UI: fewer buttons, clean layout, essential functions only." + goal_focus,
                        ),
                        (
                            "alt_b.html",
                            "Option B (balanced)",
                            "Balanced calculator implementing the user goal with moderate complexity." + goal_focus,
                        ),
                        (
                            "alt_c.html",
                            "Option C (expanded)",
                            "Expanded UI: richer feature set toward the user goal." + goal_focus,
                        ),
                    ]
                    for filename, label, variant_note in option_variants:
                        prompt = _build_llm_prompt(variant_note=variant_note)
                        html, err = _call_llm(prompt)
                        if html:
                            (DIRECTORY / filename).write_text(html, encoding="utf-8")
                            options_written.append(label)
                        elif not llm_error:
                            llm_error = err
                    if options_written:
                        status_msg = 'proposed_options_by_llm'
                        llm_error = None
                    else:
                        status_msg = f'llm_skipped: {llm_error or "No option HTML generated"}'
                else:
                    iteration_mode = "active_workspace"
                    if delete_els:
                        evolved_html, spatial_removed = _apply_spatial_patch(current_html, delete_els)
                    if delete_els and spatial_removed:
                        stage_file.write_text(evolved_html, encoding="utf-8")
                        status_msg = 'evolved_by_spatial_patch'
                        llm_error = None
                    else:
                        evolved_html, llm_error = _call_llm(_build_llm_prompt())
                        if evolved_html:
                            stage_file.write_text(evolved_html, encoding="utf-8")
                            status_msg = 'evolved_by_llm'
                        else:
                            status_msg = f'llm_skipped: {llm_error or "Invalid HTML returned"}'
                
                # Log iteration
                file_exists = LOG_CSV.exists()
                with open(LOG_CSV, mode='a', newline='', encoding='utf-8') as f:
                    writer = csv.writer(f)
                    if not file_exists:
                        writer.writerow(['timestamp', 'action', 'details'])
                    writer.writerow([datetime.now().isoformat(), 'ITERATION_LLM', f"Stage: {current_stage} | Status: {status_msg} | Keep: {len(keep_els)} | Delete: {len(delete_els)}" ])

                options_sync = None
                if status_msg in ('evolved_by_spatial_patch', 'evolved_by_llm') or (
                    status_msg == 'proposed_options_by_llm' and options_written
                ):
                    options_sync = _patch_option_previews(current_stage)

                policy_entry = None
                intract_validation = None
                if keep_els or delete_els:
                    policy_entry = _append_policy_entry(
                        current_stage, keep_els, delete_els, status_msg, model
                    )
                if evolved_html and policy_entry:
                    intract_validation = _validate_intract_artifact(
                        evolved_html,
                        policy_entry.get("proposed_contracts", []),
                        f"stage{current_stage}.html",
                    )

                history_checkpoint = None
                if status_msg in (
                    'proposed_options_by_llm',
                    'evolved_by_llm',
                    'evolved_by_spatial_patch',
                    'promoted',
                ):
                    extra = ', '.join(options_written) if options_written else ''
                    history_checkpoint = _save_history_checkpoint(
                        action='iterate',
                        stage=current_stage,
                        status=status_msg,
                        keep=keep_els,
                        delete=delete_els,
                        extra=extra,
                    )
                
                self.send_response(200)
                self.send_header('Content-type', 'application/json; charset=utf-8')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(json.dumps({
                    "status": status_msg,
                    "mode": iteration_mode,
                    "new_stage": current_stage,
                    "keep_count": len(keep_els),
                    "delete_count": len(delete_els),
                    "ledger_keep": ledger_keep,
                    "ledger_delete": ledger_delete,
                    "session_keep": session_keep,
                    "session_delete": session_delete,
                    "options_written": options_written,
                    "spatial_removed": spatial_removed,
                    "error": llm_error,
                    "policy_updated": policy_entry is not None,
                    "intract_validation": intract_validation,
                    "history_checkpoint": history_checkpoint,
                    "options_sync": options_sync,
                }).encode('utf-8'))
                return
            except Exception as e:
                import traceback
                traceback.print_exc()
                self.send_response(500)
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                self.wfile.write(str(e).encode('utf-8'))
                return
                
        super().do_POST()

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()

socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(('127.0.0.1', PORT), CustomHTTPRequestHandler) as httpd:
    httpd.serve_forever()
