                const url = s.url || ('http://127.0.0.1:' + (s.port || '') + '/');
                const sid = (s.id || '').replace(/'/g, "\\'");
                return `
                <article class="service-card" data-id="${s.id}">
                    <div class="service-card-top">
                        <div>
                            <h3 class="service-title">${s.title || s.id}</h3>
                            <p class="service-meta">${s.project_id || ''} · stage S${s.stage ?? 0} · port ${s.port || '—'}</p>
                        </div>
                        <div class="service-badges">
                            <span class="badge-publish">publish</span>
                            ${s.markpact ? '<span class="project-badge">markpact</span>' : ''}
                            <span class="project-badge ${statusClass}">${statusLabel}</span>
                        </div>
                    </div>
