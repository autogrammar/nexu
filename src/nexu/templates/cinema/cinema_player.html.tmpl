<!DOCTYPE html>
<html>
<head>
    <title>Nexu — Projects · Editor · Services</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            background: #05070c;
            color: #f1f5f9;
            font-family: 'Outfit', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .header {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 12px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            z-index: 10;
            flex-shrink: 0;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            min-width: 0;
        }
        .header h1 {
            margin: 0;
            font-size: 1.4rem;
            color: #38bdf8;
            font-weight: 600;
            white-space: nowrap;
        }
        .header-tabs {
            display: flex;
            gap: 4px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 3px;
        }
        .header-tab {
            padding: 6px 14px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: #94a3b8;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .header-tab:hover:not(:disabled) { color: #e2e8f0; background: rgba(255,255,255,0.05); }
        .header-tab.active { background: #38bdf8; color: #0f172a; }
        .header-tab:disabled { opacity: 0.35; cursor: not-allowed; }
        .projects-shell {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 24px 30px 32px;
            background: radial-gradient(ellipse at top, rgba(56, 189, 248, 0.08), transparent 55%), #090d16;
        }
        .projects-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .projects-search {
            flex: 1;
            min-width: 220px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(15, 23, 42, 0.9);
            color: #f1f5f9;
            font-family: inherit;
            font-size: 0.9rem;
        }
        .filter-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .filter-chip {
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(30, 41, 59, 0.8);
            color: #cbd5e1;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }
        .filter-chip.active {
            background: rgba(56, 189, 248, 0.2);
            border-color: #38bdf8;
            color: #7dd3fc;
        }
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }
        @media (max-width: 1100px) {
            .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .project-card {
            background: rgba(30, 41, 59, 0.65);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: 140px;
        }
        .project-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        }
        .project-card.selected {
            border-color: #38bdf8;
            box-shadow: 0 0 0 1px #38bdf8;
        }
        .project-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
        }
        .project-emoji { font-size: 1.6rem; line-height: 1; }
        .project-badges { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
        .project-badge {
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.9);
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .project-title { font-size: 1rem; font-weight: 600; color: #f8fafc; margin: 0; }
        .project-subtitle { font-size: 0.82rem; color: #94a3b8; margin: 0; line-height: 1.4; flex: 1; }
        .projects-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: #64748b;
            padding: 48px 16px;
        }
        .project-active-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(56, 189, 248, 0.35);
            background: rgba(15, 23, 42, 0.85);
        }
        .project-active-bar[hidden] { display: none !important; }
        .project-active-info { flex: 1; min-width: 200px; }
        .project-active-title { margin: 0; font-size: 1rem; color: #f8fafc; font-weight: 600; }
        .project-active-meta { margin: 4px 0 0; font-size: 0.8rem; color: #94a3b8; }
        .project-active-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
        .btn-publish {
            background: #22c55e;
            color: #052e16;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .btn-publish:hover { background: #4ade80; transform: scale(1.05); }
        .btn-publish:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
        .services-shell {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 24px 30px 32px;
            background: radial-gradient(ellipse at top, rgba(34, 197, 94, 0.06), transparent 55%), #090d16;
        }
        .services-shell[hidden] { display: none !important; }
        .services-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .services-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
        @media (max-width: 900px) {
            .services-grid { grid-template-columns: 1fr; }
        }
        .service-card {
            background: rgba(30, 41, 59, 0.65);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .service-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
        }
        .service-title { margin: 0; font-size: 1rem; font-weight: 600; color: #f8fafc; }
        .service-meta { font-size: 0.78rem; color: #94a3b8; margin: 0; line-height: 1.4; }
        .service-badges { display: flex; flex-wrap: wrap; gap: 6px; }
        .badge-publish {
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(34, 197, 94, 0.2);
            color: #86efac;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }
        .badge-status-running {
            background: rgba(34, 197, 94, 0.25);
            color: #4ade80;
        }
        .badge-status-stopped {
            background: rgba(148, 163, 184, 0.2);
            color: #94a3b8;
        }
        .service-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
        .btn-service {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(30, 41, 59, 0.9);
            color: #e2e8f0;
        }
        .btn-service:hover { border-color: #38bdf8; color: #7dd3fc; }
        .btn-service-primary { background: #0ea5e9; color: #0f172a; border-color: transparent; }
        .btn-service-primary:hover { background: #38bdf8; color: #0f172a; }
        .services-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: #64748b;
            padding: 48px 16px;
        }
        .editor-app-shell {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .editor-app-shell[hidden],
        .projects-shell[hidden],
        .services-shell[hidden] { display: none !important; }
        .controls {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .btn {
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            font-size: 0.85rem;
        }
        .btn-stage { background: #334155; color: #fff; }
        .btn-stage.active { background: #38bdf8; color: #0f172a; }
        .btn-action { background: #2ed573; color: #fff; }
        .btn-action:disabled { background: #1e293b; color: #64748b; cursor: not-allowed; }
        
        .workspace-shell {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .main-container {
            display: flex;
            flex: 1;
            min-height: 0;
            overflow: hidden;
            background: #090d16;
        }
        .bottom-panels-row {
            flex: 0 0 18vh;
            min-height: 130px;
            max-height: 26vh;
            display: flex;
            border-top: 1px solid rgba(129, 140, 248, 0.35);
            background: rgba(2, 6, 23, 0.95);
            min-width: 0;
        }
        .history-panel,
        .intract-policy-panel {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .history-panel {
            border-right: 1px solid rgba(255,255,255,0.06);
        }
        .bottom-panel-header {
            flex: 0 0 auto;
            padding: 6px 12px;
            font-size: 0.72rem;
            font-weight: 600;
            color: #a5b4fc;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono', monospace;
        }
        .history-panel-body,
        .intract-policy-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 6px 10px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.66rem;
            line-height: 1.4;
            color: #cbd5e1;
        }
        .history-entry {
            padding: 6px 8px;
            margin-bottom: 6px;
            border-radius: 6px;
            background: rgba(56, 189, 248, 0.06);
            border-left: 3px solid #38bdf8;
            cursor: pointer;
        }
        .history-entry:hover { background: rgba(56, 189, 248, 0.12); }
        .history-entry.selected { border-left-color: #2ed573; background: rgba(46, 213, 115, 0.08); }
        .history-entry-label { color: #e2e8f0; font-weight: 600; font-size: 0.68rem; }
        .history-entry-meta { color: #64748b; font-size: 0.62rem; margin-top: 2px; }
        .btn-restore {
            margin-top: 4px;
            background: rgba(46, 213, 115, 0.2);
            color: #86efac;
            border: 1px solid rgba(46, 213, 115, 0.4);
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.62rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-restore:hover { background: rgba(46, 213, 115, 0.35); }
        .btn-restore:disabled { opacity: 0.45; cursor: not-allowed; }
        .intract-policy-panel {
            /* right column — contracts */
        }
        .intract-policy-header {
            flex: 0 0 auto;
            padding: 6px 16px;
            font-size: 0.72rem;
            font-weight: 600;
            color: #a5b4fc;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            font-family: 'JetBrains Mono', monospace;
        }
        .intract-policy-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .btn-policy {
            background: rgba(129, 140, 248, 0.2);
            color: #c7d2fe;
            border: 1px solid rgba(129, 140, 248, 0.35);
            border-radius: 4px;
            padding: 3px 8px;
            font-size: 0.62rem;
            font-weight: 600;
            cursor: pointer;
            text-transform: none;
            letter-spacing: 0;
        }
        .btn-policy:hover { background: rgba(129, 140, 248, 0.35); }
        .btn-policy:disabled { opacity: 0.5; cursor: not-allowed; }
        .intract-policy-meta {
            color: #64748b;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.68rem;
        }
        .policy-section-title {
            color: #818cf8;
            font-weight: 600;
            margin: 8px 0 4px;
        }
        .policy-section-title:first-child { margin-top: 0; }
        .policy-status-ok { color: #2ed573; }
        .policy-status-miss { color: #ff6b81; }
        .policy-contract-line {
            display: block;
            padding: 3px 0;
            border-bottom: 1px dashed rgba(255,255,255,0.04);
            word-break: break-word;
        }
        .policy-ledger-entry {
            margin-bottom: 8px;
            padding: 6px 8px;
            border-radius: 6px;
            background: rgba(129, 140, 248, 0.06);
            border-left: 3px solid #818cf8;
        }
        .policy-ledger-entry.skipped { border-left-color: #fbbf24; }
        .policy-ledger-entry.evolved { border-left-color: #2ed573; }
        
        /* Left Column: Active Workspace (Window 1) */
        .active-column {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 15px;
            overflow: hidden;
        }
        
        /* Middle Column: Stacked Options A, B, C (Windows 2-4) */
        .options-column {
            width: 320px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 15px;
            border-left: 1px solid rgba(255,255,255,0.08);
            border-right: 1px solid rgba(255,255,255,0.08);
            background: rgba(2, 6, 23, 0.4);
            overflow: hidden;
        }
        
        .panel {
            background: #020617;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            cursor: pointer;
        }
        
        /* Left main panel style */
        .active-panel {
            flex: 1;
            border: 2px solid #38bdf8;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
            cursor: default;
        }
        
        /* Middle panel stacked dynamic expansion */
        .option-panel {
            flex: 1;
            height: 0;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .option-panel:hover {
            flex: 2; /* dynamically grow while other panels shrink */
            border-color: #818cf8;
            box-shadow: 0 0 15px rgba(129, 140, 248, 0.2);
        }
        
        .panel-header {
            background: rgba(15,23,42,0.8);
            padding: 8px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #94a3b8;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            z-index: 200;
        }
        .panel-body {
            flex: 1;
            position: relative;
            overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            transform-origin: center center;
        }
        
        .option-panel:hover .panel-body {
            transform: scale(1.08);
        }
        
        iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: transparent;
            pointer-events: auto;
        }
        
        /* Right Column: Chat & Feedback Controls */
        .side-panel {
            width: 380px;
            background: #05070c;
            display: flex;
            flex-direction: column;
            padding: 15px;
            overflow-y: auto;
        }
        .side-header {
            color: #94a3b8;
            font-size: 0.75rem;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 6px;
            font-family: 'JetBrains+Mono', monospace;
        }
        
        /* Interactive Chat & Action Logs */
        .chat-logs {
            background: rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 8px;
            padding: 10px;
            font-size: 0.8rem;
            line-height: 1.4;
            max-height: 150px;
            overflow-y: auto;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .chat-msg {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
        }
        .chat-msg.user {
            background: rgba(56, 189, 248, 0.1);
            color: #38bdf8;
            border-left: 3px solid #38bdf8;
            align-self: flex-start;
        }
        .chat-msg.system {
            background: rgba(46, 213, 115, 0.1);
            color: #2ed573;
            border-left: 3px solid #2ed573;
            align-self: flex-start;
        }
        
        .feedback-list {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
        }
        .feedback-item {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 6px;
            padding: 8px 12px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
        }
        .feedback-tag {
            font-weight: 600;
            font-size: 0.75rem;
            padding: 1px 5px;
            border-radius: 3px;
        }
        .feedback-tag.keep { background: rgba(46, 213, 115, 0.15); color: #2ed573; }
        .feedback-tag.redesign { background: rgba(255, 71, 87, 0.15); color: #ff4757; }
        
        .prompt-box {
            background: rgba(56, 189, 248, 0.05);
            border: 1px solid rgba(56, 189, 248, 0.15);
            border-radius: 6px;
            padding: 10px;
            font-size: 0.8rem;
            color: #38bdf8;
            font-family: 'JetBrains+Mono', monospace;
            white-space: pre-wrap;
            max-height: 120px;
            overflow-y: auto;
        }
        .hint-input {
            width: 100%;
            min-height: 64px;
            resize: vertical;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 6px;
            color: #e2e8f0;
            padding: 8px;
            font-size: 0.8rem;
            font-family: 'JetBrains+Mono', monospace;
            margin-bottom: 8px;
        }
        .hint-input:focus {
            outline: none;
            border-color: #38bdf8;
        }
        .btn-hint {
            width: 100%;
            margin-bottom: 10px;
            background: #0ea5e9;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 8px 10px;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
        }
        .btn-hint:hover { background: #0284c7; }
        .btn-review {
            width: 100%;
            margin-bottom: 10px;
            background: rgba(129, 140, 248, 0.25);
            color: #c7d2fe;
            border: 1px solid rgba(129, 140, 248, 0.45);
            border-radius: 6px;
            padding: 8px 10px;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
        }
        .btn-review:hover { background: rgba(129, 140, 248, 0.4); }
        .btn-review.active { background: #6366f1; color: #fff; border-color: #818cf8; }
        
        .promote-indicator {
            color: #818cf8;
            font-size: 0.7rem;
            background: rgba(129, 140, 248, 0.1);
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: normal;
        }
        .btn-copy {
            background: #818cf8;
            color: #fff;
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-size: 0.85rem;
            transition: all 0.2s;
            margin-left: 12px;
        }
        .btn-copy:hover { background: #6366f1; transform: scale(1.05); }
        .btn-copy.copied { background: #2ed573; }
        .btn-markpact {
            background: #0ea5e9;
            color: #0f172a;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .btn-markpact:hover { background: #38bdf8; transform: scale(1.05); }
        .btn-markpact:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
        .toast-notification {
            position: fixed;
            top: 16px;
            right: 16px;
            background: #2ed573;
            color: #0f172a;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 99999;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            pointer-events: none;
        }
        .toast-notification.show {
            opacity: 1;
            transform: translateY(0);
        }
        .workflow-guide {
            display: flex;
            gap: 10px;
            padding: 10px 16px;
            background: rgba(15, 23, 42, 0.85);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            align-items: stretch;
        }
        .wf-step {
            flex: 1;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.08);
            font-size: 0.78rem;
            color: #94a3b8;
            line-height: 1.35;
        }
        .wf-step strong { color: #e2e8f0; display: block; margin-bottom: 2px; font-size: 0.82rem; }
        .wf-step.active { border-color: #38bdf8; background: rgba(56, 189, 248, 0.08); color: #cbd5e1; }
        .wf-step.done { border-color: rgba(46, 213, 115, 0.35); color: #86efac; }
        .workflow-hint {
            padding: 0 16px 10px;
            font-size: 0.8rem;
            color: #64748b;
            background: rgba(15, 23, 42, 0.85);
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .intract-policy-panel.collapsed .intract-policy-body,
        .intract-policy-panel.collapsed .intract-policy-actions,
        .intract-policy-panel.collapsed .intract-policy-meta { display: none; }
        .btn-action:disabled { opacity: 0.45; cursor: not-allowed; }
    </style>
</head>
<body>
    <div id="toast" class="toast-notification">📋 JSON copied to clipboard!</div>
    <div class="header">
        <div class="header-left">
            <h1>🎬 Nexu</h1>
            <div class="header-tabs" role="tablist">
                <button type="button" class="header-tab active" id="tab-projects" data-tab="projects" onclick="switchMainTab('projects')">Projects</button>
                <button type="button" class="header-tab" id="tab-editor" data-tab="editor" onclick="switchMainTab('editor')" disabled title="Pick a project to open the editor">Editor</button>
                <button type="button" class="header-tab" id="tab-services" data-tab="services" onclick="switchMainTab('services')">Services</button>
            </div>
        </div>
        <div class="controls" id="editor-header-controls" hidden>
            <button class="btn btn-stage active" onclick="switchStage(0)" title="Load a saved baseline template into the workspace">S0 baseline</button>
            <button class="btn btn-stage" onclick="switchStage(1)" title="Load mid template">S1 template</button>
            <button class="btn btn-stage" onclick="switchStage(2)" title="Load evolved template">S2 template</button>
            <button class="btn btn-copy" id="copy-btn" onclick="copyStateToClipboard()">📋 Copy session</button>
            <button class="btn btn-markpact" id="markpact-btn-editor" onclick="downloadMarkpactExport()" title="Download README.md for Markpact shell">⬇ Markpact</button>
            <button class="btn btn-publish" id="publish-btn-editor" onclick="publishCurrentProject()" title="Deploy stage via Markpact to Services">🚀 Publish</button>
        </div>
    </div>

    <div id="projects-shell" class="projects-shell">
        <div id="project-active-bar" class="project-active-bar" hidden>
            <div class="project-active-info">
                <h2 class="project-active-title" id="project-active-title">Current project</h2>
                <p class="project-active-meta" id="project-active-meta">Open Editor to refine, then deploy to Services via Markpact.</p>
            </div>
            <div class="project-active-actions">
                <button type="button" class="btn btn-service btn-service-primary" onclick="switchMainTab('editor')" title="Edit workspace, options, and policy">Open editor →</button>
                <button type="button" class="btn btn-markpact" id="markpact-btn" onclick="downloadMarkpactExport()" title="Download Markpact README for current stage">⬇ Markpact</button>
                <button type="button" class="btn btn-publish" id="publish-btn" onclick="publishCurrentProject()" title="Deploy stage via Markpact to Services">🚀 Publish</button>
                <button type="button" class="btn btn-service" onclick="switchMainTab('services')">Services →</button>
            </div>
        </div>
        <div class="projects-toolbar">
            <input type="search" id="projects-search" class="projects-search" placeholder="Filter examples…" oninput="renderProjectsGrid()">
            <div class="filter-chips" id="domain-filters"></div>
            <div class="filter-chips" id="kind-filters"></div>
        </div>
        <div class="projects-grid" id="projects-grid">
            <div class="projects-empty">Loading example projects…</div>
        </div>
    </div>

    <div id="services-shell" class="services-shell" hidden>
        <div class="services-toolbar">
            <p style="margin:0; flex:1; color:#94a3b8; font-size:0.85rem;">Services deployed from the Editor (Markpact). Start/stop local HTTP on ports 9200–9298.</p>
            <button type="button" class="btn btn-service" onclick="loadServicesCatalog()">↻ Refresh</button>
        </div>
        <div class="services-grid" id="services-grid">
            <div class="services-empty">Loading services…</div>
        </div>
    </div>

    <div id="editor-app-shell" class="editor-app-shell" hidden>
    <div class="workflow-guide" id="workflow-guide">
        <div class="wf-step active" id="wf-step-1"><strong>1. Goal or marks</strong>Describe intent or drag on workspace (keep/remove).</div>
        <div class="wf-step" id="wf-step-2"><strong>2. Options A–C</strong>Refreshed live after each change — workspace unchanged.</div>
        <div class="wf-step" id="wf-step-3"><strong>3. Promote</strong>Click A, B, or C → refine with more marks or goals.</div>
    </div>
    <div class="workflow-hint" id="workflow-hint">Each goal or mark sends feedback to AI and updates Options A–C within a moment.</div>
    
    <div class="workspace-shell">
    <div class="main-container">
        <!-- 1. Left Column: Active Workspace -->
        <div class="active-column">
            <div class="panel active-panel">
                <div class="panel-header" style="color: #38bdf8;">
                    <span>🔵 1. ACTIVE WORKSPACE</span>
                    <span id="workspace-hint" style="font-size: 0.65rem;">[Drag: left = keep · right = remove]</span>
                </div>
                <div class="panel-body">
                    <iframe id="active-frame" name="active-frame" src="stage0.html?role=workspace&amp;active=true&amp;mark=1&amp;calc=0&amp;review=0&amp;stage=0"></iframe>
                </div>
            </div>
        </div>
        
        <!-- 2. Middle Column: Stacked Alternative Options -->
        <div class="options-column">
            <!-- Option A -->
            <div class="panel option-panel" onclick="promoteAlt('alt_a.html', 'Option A')">
                <div class="panel-header">
                    <span>⚡ OPTION A (Minimalist)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-a-frame" name="alt-a-frame" src="alt_a.html?role=option&amp;pane=a&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
            
            <!-- Option B -->
            <div class="panel option-panel" onclick="promoteAlt('alt_b.html', 'Option B')">
                <div class="panel-header">
                    <span>⚡ OPTION B (Standard)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-b-frame" name="alt-b-frame" src="alt_b.html?role=option&amp;pane=b&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
            
            <!-- Option C -->
            <div class="panel option-panel" onclick="promoteAlt('alt_c.html', 'Option C')">
                <div class="panel-header">
                    <span>⚡ OPTION C (Expanded)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-c-frame" name="alt-c-frame" src="alt_c.html?role=option&amp;pane=c&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
        </div>
        
        <!-- 3. Right Column: Chat & Settings -->
        <div class="side-panel">
            <div class="side-header">💬 Live Chat & Automated Logs</div>
            <div class="chat-logs" id="chat-logs">
                <div class="chat-msg system"><strong>System:</strong> Type a goal or drag on the workspace — <strong>Options A–C</strong> refresh automatically. Click A/B/C to promote, then keep marking to get the next three variants.</div>
            </div>

            <div class="side-header">1. Your goal</div>
            <textarea id="hint-input" class="hint-input" placeholder="e.g. chemical calculator with element keys and molar mass…"></textarea>
            <button class="btn-hint" onclick="addUserHint()">➕ Add goal</button>
            
            <div class="side-header">2. Mark workspace (drag)</div>
            <button type="button" class="btn-review" id="btn-review-mode" onclick="toggleElementReviewMode()">🖱️ Drag marking (default)</button>
            <div class="feedback-list" id="feedback-list">
                <div style="color: #64748b; font-size: 0.85rem; text-align: center; margin-top: 40px;">
                    Drag over controls: <strong>left mouse</strong> = keep (green), <strong>right mouse</strong> = remove (red). Box can cover many buttons at once.
                </div>
            </div>
            
            <div class="side-header">Summary for AI</div>
            <div class="prompt-box" id="prompt-box">Add a goal to begin.</div>
            
            <button class="btn btn-action" id="action-btn" style="margin-top: 15px; width: 100%;" disabled onclick="runLiveIteration({ manual: true })">
                Add a goal or mark to start
            </button>
        </div>
    </div>
    </div>

    <div class="bottom-panels-row">
        <div class="history-panel" id="history-panel">
            <div class="bottom-panel-header">
                <span>🕐 Change history</span>
                <span class="intract-policy-meta" id="history-meta">0 checkpoints</span>
            </div>
            <div class="history-panel-body" id="history-panel-body">
                Loading history…
            </div>
        </div>
        <div class="intract-policy-panel" id="intract-policy-panel">
            <div class="intract-policy-header">
                <span>📜 Policy contracts</span>
                <div class="intract-policy-actions">
                    <button class="btn-policy" onclick="applyLedgerToManifest(false, 'project')">⬆ Project</button>
                    <button class="btn-policy" onclick="applyLedgerToManifest(false, 'capsule')">⬆ Capsule</button>
                    <button class="btn-policy" id="btn-apply-manifest" onclick="applyLedgerToManifest(false, 'both')">⬆ Both</button>
                    <button class="btn-policy" onclick="applyLedgerToManifest(true, 'both')">Dry-run</button>
                    <button class="btn-policy" id="btn-verify-capsule" onclick="verifyCapsuleWorkspace()">✓ Verify</button>
                    <button class="btn-policy" id="btn-propose-llm" onclick="proposeContractsLlm()">🤖 Propose</button>
                </div>
                <span class="intract-policy-meta" id="intract-policy-meta">loading…</span>
            </div>
            <div class="intract-policy-body" id="intract-policy-body">
                Loading contracts…
            </div>
        </div>
    </div>
    </div>

    <script>
        let activeStage = 0;
        let annotations = [];
        let annotationHistory = [];
        let lastIteration = null;
        let userHints = [];
        let pendingGoalOptions = false;
        let workspaceEngaged = false;
        let intractPolicyData = null;
        let historyCheckpoints = [];
        let ledgerArchive = [];
        let selectedHistoryId = null;
        let elementReviewMode = false;
        let mainTab = 'projects';
        let projectCatalog = [];
        let projectFilters = { domains: [], kinds: [], tags: [] };
        let activeProjectId = null;
        let selectedDomainFilter = 'all';
        let selectedKindFilter = 'all';
        let servicesCatalog = [];

        function logEvent(action, details) {
            const ts = new Date().toISOString();
            const payload = typeof details === 'object' && details !== null
                ? { tab: mainTab, project: activeProjectId, stage: activeStage, review: elementReviewMode, annotations: annotations.length, ...details }
                : { tab: mainTab, project: activeProjectId, stage: activeStage, review: elementReviewMode, annotations: annotations.length, msg: String(details || '') };
            console.log('[NEXU]', ts, action, payload);
            fetch('/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action, details: JSON.stringify(payload) })
            }).catch(err => console.warn('[NEXU] Logger API unreachable:', err.message));
        }

        function buildFrameQuery(spec) {
            const p = new URLSearchParams();
            if (spec.role) p.set('role', spec.role);
            if (spec.active) p.set('active', 'true');
            if (spec.pane) p.set('pane', spec.pane);
            if (spec.mark != null) p.set('mark', spec.mark ? '1' : '0');
            if (spec.calc != null) p.set('calc', spec.calc ? '1' : '0');
            if (spec.review != null) p.set('review', spec.review ? '1' : '0');
            if (spec.stage != null) p.set('stage', String(spec.stage));
            p.set('t', String(spec.t != null ? spec.t : Date.now()));
            return '?' + p.toString();
        }

        function frameUrl(file, spec) {
            return file + buildFrameQuery(spec);
        }

        function updatePlayerUrl() {
            const p = new URLSearchParams();
            p.set('tab', mainTab);
            if (activeProjectId) p.set('project', activeProjectId);
            p.set('stage', String(activeStage));
            p.set('review', elementReviewMode ? '1' : '0');
            p.set('mark', '1');
            p.set('annotations', String(annotations.length));
            if (pendingGoalOptions) p.set('pending', '1');
            if (workspaceEngaged) p.set('workspace', '1');
            p.set('mode', resolveIterationMode());
            const qs = p.toString();
            const next = 'cinema_player.html' + (qs ? '?' + qs : '');
            if (location.pathname.endsWith('cinema_player.html') && location.search !== '?' + qs) {
                history.replaceState(null, '', next);
            }
        }

        function bindFrameLoad(id, label) {
            const fr = document.getElementById(id);
            if (!fr || fr.dataset.nexuBound === '1') return;
            fr.dataset.nexuBound = '1';
            fr.addEventListener('load', () => {
                logEvent('FRAME_LOAD', { frame: label, src: fr.src });
                lastIframeSyncKey = '';
                syncAllIframeVisuals();
            });
        }

        let cinemaServerOnline = false;

        (function applyBootUrlParams() {
            const boot = new URLSearchParams(location.search);
            if (boot.has('review')) elementReviewMode = boot.get('review') !== '0';
            if (boot.has('stage')) {
                const s = parseInt(boot.get('stage'), 10);
                if (!isNaN(s)) activeStage = s;
            }
        })();

        logEvent('PAGE_LOAD', { href: location.href, review: elementReviewMode, stage: activeStage });
        syncReviewModeToFrames();
        document.addEventListener('click', (e) => {
            const t = e.target;
            if (!t || !t.closest) return;
            const tag = (t.tagName || '').toLowerCase();
            const role = t.getAttribute('role');
            const id = t.id || '';
            const cls = typeof t.className === 'string' ? t.className : '';
            if (tag === 'iframe' || t.closest('iframe')) return;
            if (['button', 'a'].includes(tag) || role === 'button' || t.closest('button, .btn-stage, .project-card, .tab-btn, .nexu-review-btn')) {
                logEvent('UI_CLICK', {
                    tag: tag,
                    id: id,
                    class: cls.slice(0, 80),
                    text: (t.innerText || '').trim().slice(0, 40)
                });
            }
        }, true);
        bindFrameLoad('active-frame', 'workspace');
        bindFrameLoad('alt-a-frame', 'option_a');
        bindFrameLoad('alt-b-frame', 'option_b');
        bindFrameLoad('alt-c-frame', 'option_c');
        loadProjectsCatalog();
        pingCinemaServer().then(() => {
            return fetch('/projects/active').then(res => res.ok ? res.json() : null);
        }).then(data => {
            if (data && data.active && data.active.id) {
                activeProjectId = data.active.id;
                document.getElementById('tab-editor').disabled = false;
                updateProjectActiveBar();
                switchMainTab('editor', { skipLog: true });
            }
        }).catch(() => {});

        function switchMainTab(tab, opts) {
            const options = opts || {};
            if (tab === 'editor' && !activeProjectId) return;
            mainTab = tab;
            const projectsShell = document.getElementById('projects-shell');
            const editorShell = document.getElementById('editor-app-shell');
            const servicesShell = document.getElementById('services-shell');
            const editorControls = document.getElementById('editor-header-controls');
            document.getElementById('tab-projects').classList.toggle('active', tab === 'projects');
            document.getElementById('tab-editor').classList.toggle('active', tab === 'editor');
            document.getElementById('tab-services').classList.toggle('active', tab === 'services');
            if (projectsShell) projectsShell.hidden = tab !== 'projects';
            if (editorShell) editorShell.hidden = tab !== 'editor';
            if (servicesShell) servicesShell.hidden = tab !== 'services';
            if (editorControls) editorControls.hidden = tab !== 'editor';
            if (tab === 'projects') updateProjectActiveBar();
            if (tab === 'editor') {
                refreshIntractPolicy();
                refreshHistory();
                reloadCinemaFrames();
                syncReviewModeToFrames();
            }
            if (tab === 'services') loadServicesCatalog();
            if (!options.skipLog) {
                logEvent('MAIN_TAB', { tab: tab });
            }
            updatePlayerUrl();
        }

        function activeProjectRecord() {
            return projectCatalog.find(p => p.id === activeProjectId) || null;
        }

        function currentUserGoal() {
            const prompt = document.getElementById('prompt-box');
            if (prompt && prompt.innerText.trim()) return prompt.innerText.trim();
            const hint = document.getElementById('hint-input');
            if (hint && hint.value.trim()) return hint.value.trim();
            const proj = activeProjectRecord();
            return (proj && proj.subtitle) ? proj.subtitle : '';
        }

        function updateProjectActiveBar() {
            const bar = document.getElementById('project-active-bar');
            const titleEl = document.getElementById('project-active-title');
            const metaEl = document.getElementById('project-active-meta');
            if (!bar) return;
            if (!activeProjectId) {
                bar.hidden = true;
                return;
            }
            const proj = activeProjectRecord();
            bar.hidden = false;
            if (titleEl) titleEl.textContent = proj ? proj.title : activeProjectId;
            if (metaEl) {
                metaEl.textContent = (proj ? proj.subtitle + ' · ' : '') + 'Stage S' + activeStage + ' — open Editor or deploy to Services (Markpact).';
            }
        }

        function loadServicesCatalog() {
            const grid = document.getElementById('services-grid');
            if (grid) grid.innerHTML = '<div class="services-empty">Loading services…</div>';
            return fetch('/services/catalog')
                .then(res => {
                    if (!res.ok) throw new Error('catalog HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    servicesCatalog = Array.isArray(data.services) ? data.services : [];
                    renderServicesGrid();
                })
                .catch(err => {
                    if (grid) {
                        grid.innerHTML = '<div class="services-empty">Could not load services: ' + err.message + '</div>';
                    }
                });
        }

        function renderServicesGrid() {
            const grid = document.getElementById('services-grid');
            if (!grid) return;
            if (!servicesCatalog.length) {
                grid.innerHTML = '<div class="services-empty">No deployed services yet. <strong>Projects</strong> → <strong>Editor</strong> → <strong>Publish</strong> (Markpact).</div>';
                return;
            }
            grid.innerHTML = servicesCatalog.map(s => {
                const running = s.status === 'running';
                const statusClass = running ? 'badge-status-running' : 'badge-status-stopped';
                const statusLabel = running ? 'running' : 'stopped';
                const url = s.url || ('http://127.0.0.1:' + (s.port || '') + '/');
                const sid = (s.id || '').replace(/'/g, "\\'");
                return `
                <article class="service-card" data-id="${s.id}">
                    <div class="service-card-top">
                        <div>
                            <h3 class="service-title">${s.title || s.id}</h3>
                            <p class="service-meta">${s.project_id || ''} · stage S${s.stage ?? 0} · port ${s.port || '—'}</p>
                        </div>
                        <div class="service-badges">
                            <span class="badge-publish">publish</span>
                            ${s.markpact ? '<span class="project-badge">markpact</span>' : ''}
                            <span class="project-badge ${statusClass}">${statusLabel}</span>
                        </div>
                    </div>
                    <div class="service-actions">
                        ${running
                            ? `<a class="btn-service btn-service-primary" href="${url}" target="_blank" rel="noopener">Open</a>
                               <button type="button" class="btn-service" onclick="stopPublishedService('${sid}')">Stop</button>`
                            : `<button type="button" class="btn-service btn-service-primary" onclick="startPublishedService('${sid}')">Start</button>`}
                        <button type="button" class="btn-service" onclick="switchMainTab('editor')">Editor</button>
                        <button type="button" class="btn-service" onclick="switchMainTab('projects')">Projects</button>
                    </div>
                </article>`;
            }).join('');
        }

        function publishCurrentProject() {
            if (!activeProjectId) {
                addChatLog('system', '❌ <strong>Select a project first.</strong>');
                return;
            }
            const proj = activeProjectRecord();
            const btnIds = ['publish-btn', 'publish-btn-editor'];
            const buttons = btnIds.map(id => document.getElementById(id)).filter(Boolean);
            buttons.forEach(b => { b.disabled = true; b.innerText = '⏳ Publishing…'; });
            fetch('/services/publish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    stage: activeStage,
                    project_id: activeProjectId,
                    project_title: proj ? proj.title : activeProjectId,
                    goal: currentUserGoal()
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                const svc = data.service || {};
                addChatLog('system', `🚀 <strong>Published:</strong> ${svc.title || svc.id} on <a href="${svc.url}" target="_blank">${svc.url}</a>`);
                logEvent('SERVICE_PUBLISH', svc.id || '');
                loadServicesCatalog();
                switchMainTab('services', { skipLog: true });
            })
            .catch(err => {
                addChatLog('system', '❌ <strong>Publish failed: ' + err.message + '</strong>');
            })
            .finally(() => {
                buttons.forEach(b => { b.disabled = false; b.innerText = '🚀 Publish'; });
            });
        }

        function startPublishedService(serviceId) {
            fetch('/services/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_id: serviceId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                loadServicesCatalog();
                logEvent('SERVICE_START', serviceId);
            })
            .catch(err => addChatLog('system', '❌ <strong>Start failed: ' + err.message + '</strong>'));
        }

        function stopPublishedService(serviceId) {
            fetch('/services/stop', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_id: serviceId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                loadServicesCatalog();
                logEvent('SERVICE_STOP', serviceId);
            })
            .catch(err => addChatLog('system', '❌ <strong>Stop failed: ' + err.message + '</strong>'));
        }

        function loadProjectsCatalog() {
            fetch('/projects/catalog')
                .then(res => {
                    if (!res.ok) throw new Error('catalog HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    projectCatalog = Array.isArray(data.projects) ? data.projects : [];
                    projectFilters = data.filters || projectFilters;
                    renderFilterChips();
                    renderProjectsGrid();
                    updateProjectActiveBar();
                })
                .catch(err => {
                    const grid = document.getElementById('projects-grid');
                    if (grid) {
                        grid.innerHTML = '<div class="projects-empty">Could not load projects: ' + err.message + '</div>';
                    }
                });
        }

        function renderFilterChips() {
            const domainHost = document.getElementById('domain-filters');
            const kindHost = document.getElementById('kind-filters');
            if (!domainHost || !kindHost) return;
            const mk = (label, value, group) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'filter-chip' + ((group === 'domain' ? selectedDomainFilter : selectedKindFilter) === value ? ' active' : '');
                btn.textContent = label;
                btn.onclick = () => {
                    if (group === 'domain') selectedDomainFilter = value;
                    else selectedKindFilter = value;
                    renderFilterChips();
                    renderProjectsGrid();
                };
                return btn;
            };
            domainHost.innerHTML = '';
            domainHost.appendChild(mk('All domains', 'all', 'domain'));
            (projectFilters.domains || []).forEach(d => domainHost.appendChild(mk(d, d, 'domain')));
            kindHost.innerHTML = '';
            kindHost.appendChild(mk('All kinds', 'all', 'kind'));
            (projectFilters.kinds || []).forEach(k => kindHost.appendChild(mk(k, k, 'kind')));
        }

        function projectMatchesFilters(project) {
            const q = (document.getElementById('projects-search')?.value || '').trim().toLowerCase();
            if (selectedDomainFilter !== 'all' && project.domain !== selectedDomainFilter) return false;
            if (selectedKindFilter !== 'all' && project.kind !== selectedKindFilter) return false;
            if (!q) return true;
            const hay = [project.title, project.subtitle, project.domain, project.kind, ...(project.tags || [])].join(' ').toLowerCase();
            return hay.includes(q);
        }

        function renderProjectsGrid() {
            const grid = document.getElementById('projects-grid');
            if (!grid) return;
            const visible = projectCatalog.filter(projectMatchesFilters);
            if (!visible.length) {
                grid.innerHTML = '<div class="projects-empty">No examples match your filters.</div>';
                return;
            }
            grid.innerHTML = visible.map(p => `
                <article class="project-card${p.id === activeProjectId ? ' selected' : ''}" data-id="${p.id}" onclick="activateProject('${p.id}')">
                    <div class="project-card-top">
                        <span class="project-emoji">${p.emoji || '📦'}</span>
                        <div class="project-badges">
                            <span class="project-badge">${p.domain}</span>
                            <span class="project-badge">${p.kind}</span>
                        </div>
                    </div>
                    <h3 class="project-title">${p.title}</h3>
                    <p class="project-subtitle">${p.subtitle}</p>
                </article>
            `).join('');
        }

        function activateProject(projectId) {
            const card = document.querySelector('.project-card[data-id="' + projectId + '"]');
            if (card) card.classList.add('selected');
            fetch('/projects/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: projectId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    addChatLog('system', '❌ <strong>Project load failed: ' + data.error + '</strong>');
                    return;
                }
                activeProjectId = projectId;
                pendingGoalOptions = true;
                workspaceEngaged = false;
                annotations = [];
                userHints = [];
                updateFeedbackList();
                document.getElementById('tab-editor').disabled = false;
                const hint = document.getElementById('hint-input');
                if (hint && !hint.value.trim()) {
                    hint.value = (data.project && data.project.subtitle) ? data.project.subtitle : '';
                }
                reloadCinemaFrames();
                switchMainTab('editor');
                updateWorkflowUI();
                addChatLog('system', `✏️ <strong>Editor:</strong> ${data.project.title} — refine the workspace, then publish to Services.`);
                logEvent('PROJECT_ACTIVATE', projectId);
                renderProjectsGrid();
                updateProjectActiveBar();
            })
            .catch(err => {
                addChatLog('system', '❌ <strong>Project activate error: ' + err.message + '</strong>');
            });
        }

        function pingCinemaServer(silent) {
            return fetch('/health', { method: 'GET' })
                .then(res => {
                    if (!res.ok) throw new Error('health ' + res.status);
                    cinemaServerOnline = true;
                    return res.json();
                })
                .catch(() => {
                    cinemaServerOnline = false;
                    if (!silent) {
                        addChatLog('system', '⚠️ <strong>Editor server offline.</strong> In terminal: <code>make cinema-stop && make cinema</code>, then reload this page.');
                    }
                    throw new Error('server offline');
                });
        }

        function refreshHistory() {
            fetch('/history')
                .then(res => {
                    if (!res.ok) throw new Error('history HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    historyCheckpoints = Array.isArray(data.checkpoints) ? data.checkpoints : [];
                    ledgerArchive = Array.isArray(data.ledger_archive) ? data.ledger_archive : [];
                    renderHistoryPanel();
                })
                .catch(err => {
                    const body = document.getElementById('history-panel-body');
                    const meta = document.getElementById('history-meta');
                    if (body) body.textContent = 'Could not load history: ' + err.message;
                    if (meta) meta.textContent = 'offline';
                });
        }

        function renderHistoryPanel() {
            const body = document.getElementById('history-panel-body');
            const meta = document.getElementById('history-meta');
            if (!body) return;
            let html = '';
            if (!historyCheckpoints.length && !ledgerArchive.length) {
                body.innerHTML = '<span class="policy-status-miss">No checkpoints yet — run an iteration or promote an option.</span>';
                if (meta) meta.textContent = '0 checkpoints';
                return;
            }
            html += '<div class="policy-section-title">Restorable checkpoints</div>';
            if (!historyCheckpoints.length) {
                html += '<span class="policy-status-miss">(none yet)</span><br>';
            }
            historyCheckpoints.forEach(cp => {
                const sel = cp.id === selectedHistoryId ? ' selected' : '';
                const ts = (cp.timestamp || '').replace('T', ' ').slice(0, 19);
                html += `<div class="history-entry${sel}" data-id="${cp.id}" onclick="selectHistoryEntry('${cp.id}')">`;
                html += `<div class="history-entry-label">${cp.label || cp.id}</div>`;
                html += `<div class="history-entry-meta">${ts} · ledger ${cp.ledger_length || 0} · ${cp.action || ''}</div>`;
                html += `<button type="button" class="btn-restore" onclick="event.stopPropagation(); restoreHistoryCheckpoint('${cp.id}')">↩ Restore UI + policy</button>`;
                html += '</div>';
            });
            if (ledgerArchive.length) {
                html += '<div class="policy-section-title">Ledger archive (no HTML snapshot)</div>';
                ledgerArchive.slice(0, 12).forEach(entry => {
                    const ts = (entry.timestamp || '').replace('T', ' ').slice(0, 19);
                    html += '<div class="history-entry" style="border-left-color:#64748b;opacity:0.85;">';
                    html += `<div class="history-entry-label">${entry.label || entry.id}</div>`;
                    html += `<div class="history-entry-meta">${ts} · read-only</div>`;
                    html += '</div>';
                });
                if (ledgerArchive.length > 12) {
                    html += `<div class="history-entry-meta">… +${ledgerArchive.length - 12} older ledger entries</div>`;
                }
            }
            body.innerHTML = html;
            if (meta) {
                meta.textContent = `${historyCheckpoints.length} restore · ${ledgerArchive.length} archive`;
            }
        }

        function selectHistoryEntry(id) {
            selectedHistoryId = id;
            renderHistoryPanel();
            const cp = historyCheckpoints.find(c => c.id === id);
            if (cp) {
                addChatLog('system', `🕐 <strong>Selected:</strong> ${cp.label || id}`);
            }
        }

        function reloadCinemaFrames() {
            const t = Date.now();
            const ws = {
                role: 'workspace',
                active: true,
                mark: 1,
                calc: 0,
                review: elementReviewMode ? 1 : 0,
                stage: activeStage,
                t: t
            };
            document.getElementById('active-frame').src = frameUrl('stage' + activeStage + '.html', ws);
            document.getElementById('alt-a-frame').src = frameUrl('alt_a.html', { role: 'option', pane: 'a', mark: 0, calc: 0, review: 0, t: t });
            document.getElementById('alt-b-frame').src = frameUrl('alt_b.html', { role: 'option', pane: 'b', mark: 0, calc: 0, review: 0, t: t });
            document.getElementById('alt-c-frame').src = frameUrl('alt_c.html', { role: 'option', pane: 'c', mark: 0, calc: 0, review: 0, t: t });
            logEvent('FRAMES_RELOAD', ws);
            updatePlayerUrl();
        }

        function restoreHistoryCheckpoint(checkpointId) {
            const btn = document.querySelector(`.history-entry[data-id="${checkpointId}"] .btn-restore`);
            if (btn) btn.disabled = true;
            addChatLog('system', `↩ <strong>Restoring checkpoint ${checkpointId}…</strong> (UI + ledger + manifest)`);
            fetch('/history/restore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    checkpoint_id: checkpointId,
                    apply_manifest: true,
                    target: 'both'
                })
            })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Restore failed: ' + data.error + '</strong>');
                    return;
                }
                selectedHistoryId = checkpointId;
                reloadCinemaFrames();
                refreshIntractPolicy();
                refreshHistory();
                const added = data.manifest && data.manifest.added_total != null
                    ? data.manifest.added_total
                    : 0;
                addChatLog('system', `✅ <strong>Restored:</strong> ${data.label || checkpointId}. Manifest +${added} contract(s).`);
                logEvent('HISTORY_RESTORE', checkpointId);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>Restore error: ' + err.message + '</strong>');
            });
        }

        function refreshIntractPolicy() {
            fetch('/policy')
                .then(res => {
                    if (!res.ok) throw new Error('policy HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    intractPolicyData = data;
                    renderIntractPolicy(data);
                })
                .catch(err => {
                    const body = document.getElementById('intract-policy-body');
                    const meta = document.getElementById('intract-policy-meta');
                    if (body) body.textContent = 'Could not load intract policy: ' + err.message;
                    if (meta) meta.textContent = 'offline';
                });
        }

        function renderIntractPolicy(data) {
            const body = document.getElementById('intract-policy-body');
            const meta = document.getElementById('intract-policy-meta');
            if (!body) return;

            const snap = data.snapshot || {};
            const ledger = Array.isArray(data.ledger) ? data.ledger : [];
            const project = snap.project || {};
            const capsule = snap.capsule || {};
            const baseline = snap.baseline_contracts || {};

            const yes = '<span class="policy-status-ok">yes</span>';
            const no = '<span class="policy-status-miss">no</span>';

            let html = '';
            html += '<div class="policy-section-title">Project</div>';
            html += `root: ${project.root || '—'}<br>`;
            html += `name: ${project.name || '—'} | nexu.yaml: ${project.has_nexu_yaml ? yes : no} | intract.yaml: ${project.has_intract_yaml ? yes : no} | .nexu/: ${project.has_nexu_dir ? yes : no}<br>`;
            if (project.intract_path) html += `manifest: ${project.intract_path}<br>`;

            html += '<div class="policy-section-title">Capsule</div>';
            html += `name: ${capsule.name || '—'} | exists: ${capsule.exists ? yes : no} | intract.yaml: ${capsule.has_intract_yaml ? yes : no}<br>`;
            if (capsule.path) html += `path: ${capsule.path}<br>`;
            if (capsule.intract_path) html += `manifest: ${capsule.intract_path}<br>`;

            const renderBaseline = (title, items) => {
                html += `<div class="policy-section-title">Baseline — ${title}</div>`;
                if (!items || !items.length) {
                    html += '<span class="policy-status-miss">(none — add contracts to intract.yaml)</span><br>';
                    return;
                }
                items.forEach(c => {
                    const line = c.line || `@intract.v1 id:${c.id} intent:${c.intent}`;
                    html += `<code class="policy-contract-line">${line}</code>`;
                });
            };
            renderBaseline('project', baseline.project);
            renderBaseline('capsule', baseline.capsule);

            html += '<div class="policy-section-title">Active evolution contracts (ledger)</div>';
            if (!ledger.length) {
                html += '<span class="policy-status-miss">(none — iterate or restore a checkpoint)</span><br>';
            } else {
                ledger.forEach(entry => {
                    (entry.proposed_contracts || []).forEach(p => {
                        const line = p.line || p.delta_text || `@intract.v1 id:${p.id || 'unknown'}`;
                        html += `<code class="policy-contract-line">${line}</code>`;
                    });
                });
            }

            body.innerHTML = html;
            if (meta) {
                const pCount = (baseline.project || []).length;
                const cCount = (baseline.capsule || []).length;
                meta.textContent = `baseline ${pCount}+${cCount} · ledger ${ledger.length}`;
            }
        }

        function applyLedgerToManifest(dryRun, target) {
            const btn = document.getElementById('btn-apply-manifest');
            if (btn) btn.disabled = true;
            const tgt = target || 'both';
            addChatLog('system', dryRun
                ? `📋 <strong>Dry-run: ledger → ${tgt} manifest(s)…</strong>`
                : `⬆ <strong>Applying ledger to ${tgt} intract.yaml…</strong>`);
            fetch('/manifest/apply-ledger', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ dry_run: dryRun, target: tgt })
            })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Manifest apply failed: ' + data.error + '</strong>');
                    return;
                }
                const results = data.results || [data];
                const addedTotal = data.added_total != null
                    ? data.added_total
                    : results.reduce((n, r) => n + ((r.added || []).length), 0);
                addChatLog('system', `✅ <strong>Manifest ${dryRun ? 'dry-run' : 'updated'} (${tgt}): +${addedTotal} contract(s)</strong>`);
                results.forEach(r => {
                    const label = r.target || tgt;
                    (r.added || []).forEach(id => addChatLog('system', `↳ [${label}] added: ${id}`));
                    if (r.skipped && r.skipped.length) {
                        addChatLog('system', `↳ [${label}] skipped ${r.skipped.length}`);
                    }
                });
                refreshIntractPolicy();
                logEvent('MANIFEST_APPLY', `dry_run=${dryRun} target=${tgt} added=${addedTotal}`);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>Manifest apply error: ' + err.message + '</strong>');
            });
        }

        function verifyCapsuleWorkspace() {
            const btn = document.getElementById('btn-verify-capsule');
            if (btn) btn.disabled = true;
            addChatLog('system', '✓ <strong>Running nexu capsule verify…</strong>');
            fetch('/capsule/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Verify failed: ' + data.error + '</strong>');
                    return;
                }
                addChatLog('system', `✓ <strong>Capsule verify: ${data.status} (score ${data.score})</strong>`);
                (data.findings || []).slice(0, 5).forEach(f => {
                    addChatLog('system', `↳ ${f.status || ''}: ${f.message || f.code || ''}`);
                });
                logEvent('CAPSULE_VERIFY', `status=${data.status} score=${data.score}`);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>Verify error: ' + err.message + '</strong>');
            });
        }

        function proposeContractsLlm() {
            const btn = document.getElementById('btn-propose-llm');
            if (btn) btn.disabled = true;
            const goal = document.getElementById('prompt-box').innerText.trim();
            addChatLog('system', '🤖 <strong>LLM proposing @intract.v1 contracts for current stage…</strong>');
            fetch('/propose/llm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ current_stage: activeStage, goal: goal })
            })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>LLM propose failed: ' + data.error + '</strong>');
                    return;
                }
                addChatLog('system', `✅ <strong>LLM proposed ${data.count || 0} contract line(s)</strong>`);
                refreshIntractPolicy();
                logEvent('PROPOSE_LLM', `stage=S${activeStage} count=${data.count || 0}`);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>LLM propose error: ' + err.message + '</strong>');
            });
        }

        // Globally block context menu popup on the parent dashboard page
        document.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            e.stopPropagation();
        }, true);

        let isIterating = false;
        let pendingAutoIterate = false;
        let autoIterateTimer = null;
        const AUTO_ITERATE_MS = 420;

        function scheduleAutoIteration(reason) {
            if (autoIterateTimer) clearTimeout(autoIterateTimer);
            autoIterateTimer = setTimeout(() => {
                autoIterateTimer = null;
                if (resolveIterationMode() === 'none') return;
                runLiveIteration({ auto: true, reason: reason || 'activity' });
            }, AUTO_ITERATE_MS);
        }

        // Ultimate cross-origin postMessage listener
        window.addEventListener('message', (e) => {
            if (!e.data) return;

            if (e.data.type === 'nexu_log') {
                const ev = e.data.event || 'log';
                const quiet = ['sync', 'review_mode'];
                const debug = new URLSearchParams(location.search).get('debug') === '1';
                if (debug || !quiet.includes(ev)) {
                    logEvent('IFRAME_' + ev, e.data.detail || { href: e.data.href });
                }
                return;
            }

            if (['annotation', 'promote', 'selection_updated'].includes(e.data.type)) {
                logEvent('IFRAME_MSG', { type: e.data.type, origin: e.origin || '' });
            }

            if (e.data.type === 'annotation') {
                handleAnnotation(e.data.elementId, e.data.action);
            }
            
            if (e.data.type === 'promote') {
                const label = e.data.altSrc.includes('alt_a') ? 'Option A (Minimalist)' :
                              e.data.altSrc.includes('alt_b') ? 'Option B (Standard)' : 'Option C (Expanded)';
                promoteAlt(e.data.altSrc, label);
            }

            if (e.data.type === 'selection_updated') {
                updatePromptBox();
                updateWorkflowUI();
            }
        });

        function updateWorkflowUI() {
            const mode = resolveIterationMode();
            const btn = document.getElementById('action-btn');
            const hintEl = document.getElementById('workflow-hint');
            [1, 2, 3].forEach(n => {
                const el = document.getElementById('wf-step-' + n);
                if (el) el.classList.remove('active', 'done');
            });
            if (mode === 'goal_options') {
                document.getElementById('wf-step-1')?.classList.add('done');
                document.getElementById('wf-step-2')?.classList.add('active');
                if (workspaceEngaged) {
                    document.getElementById('wf-step-3')?.classList.add('active');
                }
                if (btn) {
                    btn.disabled = isIterating;
                    btn.innerText = isIterating ? '⏳ Updating A–C…' : '↻ Refresh Options A–C now';
                }
                if (hintEl) {
                    hintEl.textContent = isIterating
                        ? 'Sending your latest marks and goals to AI…'
                        : 'Options A–C update after each goal or mark. Promote one to change the workspace.';
                }
            } else {
                document.getElementById('wf-step-1')?.classList.add('active');
                if (btn) {
                    btn.disabled = true;
                    btn.innerText = isIterating ? '⏳ Working…' : 'Add a goal or mark to start';
                }
                if (hintEl) {
                    hintEl.textContent = 'Type a goal (Enter or Add goal) or drag on workspace buttons to start live options.';
                }
            }
        }

        function addChatLog(sender, text) {
            const container = document.getElementById('chat-logs');
            const msg = document.createElement('div');
            msg.className = 'chat-msg ' + sender;
            msg.innerHTML = sender === 'user' ? `<strong>User:</strong> ${text}` : `<strong>System:</strong> ${text}`;
            container.appendChild(msg);
            container.scrollTop = container.scrollHeight;
        }

        function resolveIterationMode() {
            if (userHints.length > 0 || annotations.length > 0) return 'goal_options';
            if (pendingGoalOptions) return 'goal_options';
            return 'none';
        }

        function addUserHint() {
            const input = document.getElementById('hint-input');
            const hint = input.value.trim();
            if (!hint) return;
            userHints.push(hint);
            if (!workspaceEngaged) {
                pendingGoalOptions = true;
            }
            updateFeedbackList();
            syncAllIframeVisuals();
            addChatLog('user', hint);
            addChatLog('system', '🧭 <strong>Goal saved.</strong> Updating Options A–C…');
            logEvent('USER_HINT', hint.length > 180 ? hint.slice(0, 180) + '...' : hint);
            input.value = '';
            updatePromptBox();
            updateWorkflowUI();
            scheduleAutoIteration('hint');
        }

        function switchStage(stageNum) {
            activeStage = stageNum;
            document.querySelectorAll('.btn-stage').forEach((btn, idx) => {
                if(idx === stageNum) btn.classList.add('active');
                else btn.classList.remove('active');
            });
            
            const activeFrame = document.getElementById('active-frame');
            activeFrame.src = frameUrl('stage' + stageNum + '.html', {
                role: 'workspace',
                active: true,
                mark: 1,
                calc: 0,
                review: elementReviewMode ? 1 : 0,
                stage: stageNum,
                t: Date.now()
            });
            addChatLog('system', '🔄 Loaded stage S' + stageNum + ' template.');
            logEvent('SWITCH_STAGE', { stage: stageNum, src: activeFrame.src });
            updateProjectActiveBar();
            updatePlayerUrl();
        }

        function handleAnnotation(elementId, type) {
            if (pendingGoalOptions && !workspaceEngaged) {
                logEvent('ANNOTATE_PRE_OPTIONS', { elementId: elementId, type: type });
            }
            const existingIdx = annotations.findIndex(a => a.id === elementId);
            if (existingIdx >= 0) {
                annotations.splice(existingIdx, 1);
            }

            const entry = { id: elementId, type: type, at: new Date().toISOString(), stage: activeStage };
            annotations.push(entry);
            annotationHistory.push(entry);

            // Post annotation log
            if (type === 'KEEP') {
                addChatLog('system', `✓ Element <strong>${elementId}</strong> accepted.`);
            } else {
                addChatLog('system', `✗ Element <strong>${elementId}</strong> marked for redesign.`);
            }

            logEvent('ANNOTATE', { elementId: elementId, type: type, total: annotations.length });

            syncAllIframeVisuals();
            updateFeedbackList();
            updatePromptBox();
            updateWorkflowUI();
            updatePlayerUrl();
            scheduleAutoIteration('mark');
        }

        function syncReviewModeToFrames() {
            document.querySelectorAll('iframe').forEach(iframe => {
                if (iframe.contentWindow) {
                    iframe.contentWindow.postMessage({
                        type: 'review_mode',
                        enabled: elementReviewMode
                    }, '*');
                }
            });
            const btn = document.getElementById('btn-review-mode');
            const hint = document.getElementById('workspace-hint');
            if (btn) {
                btn.classList.toggle('active', elementReviewMode);
                btn.textContent = elementReviewMode
                    ? '👆 One-by-one review (✓ / ✗)'
                    : '🖱️ Drag selection (default)';
            }
            if (hint) {
                hint.textContent = elementReviewMode
                    ? '[Review: tap control → ✓ keep · ✗ remove · swipe or ← →]'
                    : '[Drag: left = keep · right = remove]';
            }
        }

        function toggleElementReviewMode() {
            elementReviewMode = !elementReviewMode;
            syncReviewModeToFrames();
            addChatLog('system', elementReviewMode
                ? '👆 <strong>One-by-one review ON</strong> — tap each control, then ✓ or ✗.'
                : '🖱️ <strong>Drag selection</strong> — draw a box: left = keep, right = remove (many at once).');
            logEvent('REVIEW_MODE', { enabled: elementReviewMode });
            updatePlayerUrl();
        }

        let lastIframeSyncKey = '';

        function syncAllIframeVisuals() {
            const syncKey = JSON.stringify({
                n: annotations.length,
                a: annotations.map(x => x.id + ':' + x.type).join(','),
                r: elementReviewMode ? 1 : 0
            });
            if (syncKey === lastIframeSyncKey) return;
            lastIframeSyncKey = syncKey;
            document.querySelectorAll('iframe').forEach(iframe => {
                if (iframe.contentWindow) {
                    iframe.contentWindow.postMessage({
                        type: 'sync',
                        annotations: annotations
                    }, '*');
                    iframe.contentWindow.postMessage({
                        type: 'review_mode',
                        enabled: elementReviewMode
                    }, '*');
                }
            });
        }

        function updateFeedbackList() {
            const list = document.getElementById('feedback-list');
            list.innerHTML = '';
            
            if (annotations.length === 0) {
                list.innerHTML = `<div style="color: #64748b; font-size: 0.85rem; text-align: center; margin-top: 40px;">No elements marked yet. Drag on the workspace: left = keep, right = remove.</div>`;
                updatePromptBox();
                return;
            }

            annotations.forEach(a => {
                const item = document.createElement('div');
                item.className = 'feedback-item';
                item.style.borderLeft = a.type === 'KEEP' ? '4px solid #2ed573' : '4px solid #ff4757';
                
                const label = document.createElement('span');
                label.innerText = a.id;
                
                const tag = document.createElement('span');
                tag.className = 'feedback-tag ' + (a.type === 'KEEP' ? 'keep' : 'redesign');
                tag.innerText = a.type;

                item.appendChild(label);
                item.appendChild(tag);
                list.appendChild(item);
            });
            
            updatePromptBox();
        }

        function updatePromptBox() {
            const box = document.getElementById('prompt-box');
            const deletes = annotations.filter(a => a.type === 'DELETE').map(a => a.id);
            const keeps = annotations.filter(a => a.type === 'KEEP').map(a => a.id);
            
            let promptText = `### SPATIAL FEEDBACK COMPILED\n\n`;
            if (userHints.length > 0) {
                promptText += `🧭 GOAL / HINTS:\n`;
                userHints.forEach(h => promptText += `  - ${h}\n`);
                promptText += `\n`;
            }
            if (keeps.length > 0) {
                promptText += `✓ RETAIN:\n`;
                keeps.forEach(k => promptText += `  - Keep function: #${k}\n`);
            }
            if (deletes.length > 0) {
                promptText += `\n✗ DELETE / REDESIGN:\n`;
                deletes.forEach(d => promptText += `  - Delete button: #${d}\n`);
            }
            if (userHints.length === 0 && keeps.length === 0 && deletes.length === 0) {
                promptText += `Add a goal to begin, or mark buttons after promoting an option.`;
            }
            box.innerText = promptText;
        }

        function promoteAlt(altSrc, optName) {
            const altFile = altSrc.split('?')[0];
            fetch('/promote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ alt: altFile, stage: activeStage })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    addChatLog('system', '❌ <strong>Promote failed: ' + data.error + '</strong>');
                    return;
                }
                reloadCinemaFrames();
                pendingGoalOptions = false;
                workspaceEngaged = true;
                syncReviewModeToFrames();
                addChatLog('system', `🌟 <strong>Promoted ${optName} → workspace saved.</strong> Drag or add goals — Options A–C refresh automatically.`);
                updateWorkflowUI();
                refreshHistory();
                logEvent('PROMOTE', `Option: ${optName} | Source: ${altFile} | Stage: S${activeStage}`);
            })
            .catch(err => {
                addChatLog('system', '❌ <strong>Promote error: ' + err.message + '</strong>');
            });
        }

        function runLiveIteration(opts) {
            opts = opts || {};
            if (isIterating) {
                if (opts.auto) pendingAutoIterate = true;
                return;
            }
            isIterating = true;

            const promptBox = document.getElementById('prompt-box');
            const actionBtn = document.getElementById('action-btn');
            
            const iterationMode = resolveIterationMode();
            if (iterationMode === 'goal_options') {
                if (!opts.auto) {
                    addChatLog('system', '✨ <strong>Refreshing Options A–C…</strong> (workspace unchanged)');
                }
            } else {
                if (!opts.auto) {
                    addChatLog('system', '⚠️ <strong>Add a goal, or mark buttons on the workspace.</strong>');
                }
                isIterating = false;
                updateWorkflowUI();
                return;
            }
            logEvent('ITERATION_STARTED', `mode=${iterationMode} auto=${!!opts.auto} spatial=${annotations.length} hints=${userHints.length}`);
            
            if (actionBtn) {
                actionBtn.disabled = true;
                actionBtn.innerText = '⏳ Updating A–C…';
            }
            updateWorkflowUI();

            const runIterate = () => fetch('/iterate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    prompt: promptBox.innerText,
                    current_stage: activeStage,
                    annotations: annotations,
                    user_hints: userHints,
                    iteration_mode: iterationMode,
                    pending_goal: pendingGoalOptions
                })
            })
            .then(res => {
                if (!res.ok) throw new Error('Iteration request failed: ' + res.status);
                return res.json();
            })
            .then(data => {
                isIterating = false;
                updateWorkflowUI();
                const rerun = pendingAutoIterate;
                pendingAutoIterate = false;
                
                lastIteration = {
                    at: new Date().toISOString(),
                    mode: iterationMode,
                    status: data.status,
                    options_written: data.options_written || [],
                    keep_count: data.keep_count,
                    delete_count: data.delete_count,
                    spatial_removed: data.spatial_removed || [],
                    error: data.error || null
                };
                if (data.status === 'proposed_options_by_llm' || data.status === 'proposed_options_offline') {
                    pendingGoalOptions = false;
                    const opts = (data.options_written || []).join(', ') || 'A, B, C';
                    document.getElementById('wf-step-2')?.classList.add('done');
                    document.getElementById('wf-step-3')?.classList.add('active');
                    const offlineNote = data.status === 'proposed_options_offline'
                        ? ' (offline templates — LLM disabled)'
                        : '';
                    if (!opts.auto) {
                        addChatLog('system', `✨ <strong>Options ready (${opts}).</strong>${offlineNote} Click A, B, or C to promote.`);
                    }
                    logEvent('ITERATION_OPTIONS', `status=${data.status} options=${opts}`);
                    reloadCinemaFrames();
                    refreshHistory();
                } else if (data.status === 'evolved_by_llm' || data.status === 'evolved_by_spatial_patch') {
                    const removed = (data.spatial_removed || []).join(', ');
                    const patchNote = data.status === 'evolved_by_spatial_patch'
                        ? ` (precise remove: ${removed})`
                        : '';
                    addChatLog('system', `🎯 <strong>Workspace updated.</strong> Kept: ${data.keep_count}, removed: ${data.delete_count}${patchNote}`);
                    logEvent('ITERATION_COMPLETED_LLM', `Stage: S${data.new_stage} | status=${data.status}`);

                    if (annotations.length) {
                        annotationHistory.push({
                            batch: 'applied_to_workspace',
                            at: new Date().toISOString(),
                            stage: activeStage,
                            marks: annotations.slice()
                        });
                    }
                    annotations = [];
                    updateFeedbackList();

                    reloadCinemaFrames();
                    refreshHistory();
                } else {
                    const errMsg = (data.error || data.status || 'unknown').replace(/^llm_skipped:\\s*/i, '');
                    addChatLog('system', `⚠️ <strong>Could not run AI: ${errMsg}</strong>`);
                    logEvent('ITERATION_SKIPPED', data.error || data.status);
                    addChatLog('system', '📝 <strong>Your marks were kept — adjust and try again.</strong>');
                }
                if (data.policy_updated) {
                    refreshIntractPolicy();
                }
                if (data.intract_validation) {
                    const iv = data.intract_validation;
                    addChatLog('system', `📜 <strong>Intract validation: ${iv.status} (score ${iv.score})</strong>`);
                    if (iv.issues && iv.issues.length) {
                        iv.issues.slice(0, 3).forEach(issue => {
                            addChatLog('system', `↳ ${issue.severity || 'info'}: ${issue.message || issue.rule || ''}`);
                        });
                    }
                }
                if (rerun) {
                    scheduleAutoIteration('queued');
                }
            })
            .catch(err => {
                isIterating = false;
                pendingAutoIterate = false;
                updateWorkflowUI();
                const msg = String(err.message || err);
                if (msg.includes('Failed to fetch') || msg.includes('NetworkError')) {
                    cinemaServerOnline = false;
                    addChatLog('system', '❌ <strong>Cannot reach editor server</strong> (connection refused). Run <code>make cinema-stop && make cinema</code>, open the new URL from the log, then click Apply again — your ✓/✗ marks are still in this session.');
                } else {
                    addChatLog('system', '❌ <strong>Error: ' + msg + '</strong>');
                }
                console.error('[NEXU SYSTEM] Iteration error:', err);
            });

            pingCinemaServer(true).then(() => runIterate()).catch(() => {
                isIterating = false;
                updateWorkflowUI();
            });
        }

        const HTML_PREVIEW_MAX_CHARS = 5000;

        function effectiveAnnotationsFromPolicy(policyData) {
            const byEl = policyData?.effective_ui?.by_element || {};
            return Object.keys(byEl).map(id => ({
                id: id,
                type: byEl[id] === 'delete' ? 'DELETE' : 'KEEP',
                source: 'policy_ledger'
            }));
        }

        function buildPolicyContractsExport(data) {
            if (!data) return null;
            const snap = data.snapshot || {};
            const ledger = Array.isArray(data.ledger) ? data.ledger : [];
            const pick = (c) => ({
                id: c.id,
                intent: c.intent,
                line: c.line || ''
            });
            return {
                effectiveUi: data.effective_ui || { keep: [], delete: [] },
                baselineContracts: {
                    project: (snap.baseline_contracts?.project || []).map(pick),
                    capsule: (snap.baseline_contracts?.capsule || []).map(pick)
                },
                ledgerRecent: ledger.slice(-25).map(e => ({
                    timestamp: e.timestamp,
                    status: e.status,
                    stage: e.stage,
                    keep: e.keep || [],
                    delete: e.delete || [],
                    contractLines: (e.proposed_contracts || [])
                        .map(p => p.line || p.id)
                        .filter(Boolean)
                }))
            };
        }

        function stripScriptsFromHtml(html) {
            return html.replace(/<script\b[\s\S]*?<\/script>/gi, '');
        }

        async function fetchHtmlPreview(relativePath) {
            const sep = relativePath.includes('?') ? '&' : '?';
            const url = relativePath + sep + '_export=' + Date.now();
            try {
                const res = await fetch(url);
                if (!res.ok) {
                    return { path: relativePath, error: 'HTTP ' + res.status };
                }
                const raw = await res.text();
                const withoutScripts = stripScriptsFromHtml(raw);
                const originalLength = withoutScripts.length;
                const truncated = originalLength > HTML_PREVIEW_MAX_CHARS;
                const preview = truncated
                    ? withoutScripts.slice(0, HTML_PREVIEW_MAX_CHARS) + '\n<!-- truncated -->'
                    : withoutScripts;
                return {
                    path: relativePath,
                    originalLength: originalLength,
                    truncated: truncated,
                    preview: preview
                };
            } catch (err) {
                return { path: relativePath, error: err.message };
            }
        }

        function downloadMarkpactExport() {
            const btnIds = ['markpact-btn', 'markpact-btn-editor'];
            const buttons = btnIds.map(id => document.getElementById(id)).filter(Boolean);
            const prevLabel = '⬇ Markpact';
            buttons.forEach(b => { b.disabled = true; b.innerText = '⏳ Export…'; });
            const goal = currentUserGoal();
            const params = new URLSearchParams({
                stage: String(activeStage),
                goal: goal
            });
            fetch('/export/markpact?' + params.toString())
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const disposition = res.headers.get('Content-Disposition') || '';
                    const match = disposition.match(/filename="?([^";]+)"?/i);
                    return res.text().then(text => ({
                        text: text,
                        filename: match ? match[1] : ('nexu-S' + activeStage + '-markpact.md')
                    }));
                })
                .then(({ text, filename }) => {
                    const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                    addChatLog('system', `⬇ <strong>Markpact export downloaded:</strong> ${filename} — run <code>markpact ${filename}</code> in a shell.`);
                    logEvent('MARKPACT_DOWNLOAD', filename);
                })
                .catch(err => {
                    addChatLog('system', '❌ <strong>Markpact export failed: ' + err.message + '</strong>');
                })
                .finally(() => {
                    buttons.forEach(b => { b.disabled = false; b.innerText = prevLabel; });
                });
        }

        async function copyStateToClipboard() {
            const btn = document.getElementById('copy-btn');
            const prevLabel = btn ? btn.innerText : '📋 Copy session';
            if (btn) {
                btn.disabled = true;
                btn.innerText = '⏳ Gathering…';
            }

            const chatMsgs = [];
            document.querySelectorAll('#chat-logs .chat-msg').forEach(msg => {
                chatMsgs.push(msg.innerText);
            });

            const activePath = 'stage' + activeStage + '.html?active=true';
            let policyForExport = intractPolicyData;
            if (!policyForExport) {
                try {
                    const polRes = await fetch('/policy');
                    if (polRes.ok) policyForExport = await polRes.json();
                } catch (_) {}
            }
            const ledgerMarks = effectiveAnnotationsFromPolicy(policyForExport);
            const allMarks = annotations.length ? annotations : ledgerMarks;
            let htmlPreviews = {};
            try {
                const [
                    activeWorkspace,
                    stage0,
                    stage1,
                    stage2,
                    altA,
                    altB,
                    altC
                ] = await Promise.all([
                    fetchHtmlPreview(activePath),
                    fetchHtmlPreview('stage0.html'),
                    fetchHtmlPreview('stage1.html'),
                    fetchHtmlPreview('stage2.html'),
                    fetchHtmlPreview('alt_a.html'),
                    fetchHtmlPreview('alt_b.html'),
                    fetchHtmlPreview('alt_c.html')
                ]);
                htmlPreviews = {
                    activeWorkspace: activeWorkspace,
                    stages: { stage0: stage0, stage1: stage1, stage2: stage2 },
                    alts: { alt_a: altA, alt_b: altB, alt_c: altC }
                };
            } catch (err) {
                htmlPreviews = { error: err.message };
            }

            const state = {
                timestamp: new Date().toISOString(),
                dashboard: 'Nexu',
                activeStage: activeStage,
                activeProjectId: activeProjectId,
                playerUrl: location.href,
                annotations: annotations,
                annotationHistory: annotationHistory,
                effectiveAnnotations: ledgerMarks,
                allAnnotations: allMarks,
                prompt: document.getElementById('prompt-box').innerText,
                chatLog: chatMsgs,
                iterating: isIterating,
                lastIteration: lastIteration,
                session: {
                    pendingGoalOptions: pendingGoalOptions,
                    workspaceEngaged: workspaceEngaged,
                    elementReviewMode: elementReviewMode,
                    iterationMode: resolveIterationMode()
                },
                stageUrls: {
                    stage0: 'stage0.html',
                    stage1: 'stage1.html',
                    stage2: 'stage2.html',
                    active: activePath
                },
                stats: {
                    totalAnnotations: allMarks.length,
                    keepCount: allMarks.filter(a => a.type === 'KEEP').length,
                    deleteCount: allMarks.filter(a => a.type === 'DELETE').length,
                    historyEvents: annotationHistory.length
                },
                userHints: userHints,
                history: {
                    selectedCheckpointId: selectedHistoryId,
                    checkpoints: historyCheckpoints,
                    ledgerArchive: ledgerArchive
                },
                intractPolicy: intractPolicyData,
                policyContracts: buildPolicyContractsExport(intractPolicyData),
                htmlPreviews: htmlPreviews,
                htmlPreviewNote: 'Scripts stripped; each preview capped at ' + HTML_PREVIEW_MAX_CHARS + ' chars'
            };

            const json = JSON.stringify(state, null, 2);
            try {
                await navigator.clipboard.writeText(json);
                if (btn) {
                    btn.classList.add('copied');
                    btn.innerText = '✅ Copied!';
                }
                const toast = document.getElementById('toast');
                toast.classList.add('show');
                setTimeout(() => {
                    if (btn) {
                        btn.classList.remove('copied');
                        btn.innerText = '📋 Copy session';
                    }
                    toast.classList.remove('show');
                }, 2000);
                logEvent('COPY_STATE', `Copied ${json.length} chars (history=${historyCheckpoints.length}, previews=yes)`);
                addChatLog('system', '📋 <strong>Session JSON copied</strong> (history, policy contracts, effective UI, HTML previews).');
            } catch (err) {
                addChatLog('system', '❌ <strong>Clipboard copy failed: ' + err.message + '</strong>');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    if (!btn.classList.contains('copied')) {
                        btn.innerText = prevLabel;
                    }
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            switchMainTab(mainTab, { skipLog: true });
            updateWorkflowUI();
            const hintInput = document.getElementById('hint-input');
            if (hintInput) {
                hintInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        addUserHint();
                    }
                });
            }
        });
    </script>
</body>
</html>