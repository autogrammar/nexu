            background: var(--nexu-bg-elevated);
            color: var(--nexu-text-body);
            border-radius: 6px;
            padding: 7px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            font-weight: 700;
            cursor: pointer;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
