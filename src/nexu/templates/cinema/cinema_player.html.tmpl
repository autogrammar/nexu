        .llm-status-badge.ready { border-color: var(--nexu-success-text); color: var(--nexu-success-text); }
        .llm-status-badge.warn { border-color: var(--nexu-warning); color: var(--nexu-warning); }
        .llm-status-badge.error { border-color: var(--nexu-danger-border); color: var(--nexu-danger-text); }
        .btn {
            padding: 8px 14px;
            min-height: var(--nexu-control-height);
            border-radius: var(--nexu-radius-sm);
