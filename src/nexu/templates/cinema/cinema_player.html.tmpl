                            : `<button type="button" class="btn-service btn-service-primary" onclick="startPublishedService('${sid}')">Start</button>`}
                        <button type="button" class="btn-service" onclick="switchMainTab('editor')">Editor</button>
                        <button type="button" class="btn-service" onclick="switchMainTab('projects')">Projects</button>
                    </div>
                </article>`;
