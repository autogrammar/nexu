            border-color: var(--nexu-warning);
        }
        .element-hint-input {
            border-color: var(--nexu-policy-border);
        }
        .element-hint-input:focus {
            border-color: var(--nexu-policy);
        }
        .btn-goal {
            background: var(--nexu-goal-btn);
            margin-bottom: 14px;
        }
        .btn-goal:hover { background: var(--nexu-goal-btn-hover); }
        .btn-element-hint {
            background: var(--nexu-hint-btn);
            margin-bottom: 10px;
        }
        .btn-element-hint:hover { background: var(--nexu-hint-btn-hover); }
        .btn-element-hint:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }
        .prompt-section-goal { color: var(--nexu-warning); }
        .prompt-section-hint { color: var(--nexu-policy-text); }
        
        .feedback-list {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
        }
        .feedback-item {
            background: var(--nexu-hover-surface);
            border: 1px solid var(--nexu-border-subtle);
            border-radius: 6px;
            padding: 8px 12px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
        }
        .feedback-tag {
            font-weight: 600;
            font-size: 0.75rem;
            padding: 1px 5px;
            border-radius: 3px;
        }
        .feedback-tag.keep { background: var(--nexu-success-soft); color: var(--nexu-success); }
        .feedback-tag.redesign { background: var(--nexu-danger-soft); color: var(--nexu-danger); }
        
        .prompt-box {
            background: var(--nexu-accent-glow);
            border: 1px solid var(--nexu-accent-border);
            border-radius: 6px;
            padding: 10px;
            font-size: 0.8rem;
            color: var(--nexu-accent);
            font-family: 'JetBrains+Mono', monospace;
            white-space: pre-wrap;
            max-height: 120px;
            overflow-y: auto;
        }
        .hint-input {
            width: 100%;
            min-height: 64px;
            resize: vertical;
            background: var(--nexu-bg-inset);
            border: 1px solid var(--nexu-border-strong);
            border-radius: 6px;
            color: var(--nexu-text);
            padding: 8px;
            font-size: 0.8rem;
            font-family: 'JetBrains+Mono', monospace;
            margin-bottom: 8px;
        }
        .hint-input:focus {
            outline: none;
            border-color: var(--nexu-accent);
        }
        .btn-hint {
            width: 100%;
            margin-bottom: 10px;
            background: var(--nexu-primary-btn);
            color: var(--nexu-text-title);
            border: none;
            border-radius: 6px;
            padding: 8px 10px;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
        }
        .btn-hint:hover { background: var(--nexu-primary-btn-hover); }
        .btn-review {
            width: 100%;
            margin-bottom: 10px;
            background: var(--nexu-policy-soft);
            color: var(--nexu-policy-btn-text);
            border: 1px solid var(--nexu-policy-border);
            border-radius: 6px;
            padding: 8px 10px;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
        }
        .btn-review:hover { background: var(--nexu-policy-soft); }
        .btn-review.active { background: var(--nexu-hint-btn); color: var(--nexu-text-title); border-color: var(--nexu-policy); }
        
        .promote-indicator {
            color: var(--nexu-policy);
            font-size: 0.7rem;
            background: var(--nexu-policy-soft);
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: normal;
        }
        .btn-copy {
            background: var(--nexu-policy);
            color: var(--nexu-text-title);
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-size: 0.85rem;
            transition: all 0.2s;
            margin-left: 12px;
        }
        .btn-copy:hover { background: var(--nexu-hint-btn); transform: scale(1.05); }
        .btn-copy.copied { background: var(--nexu-success); }
        .btn-markpact {
            background: var(--nexu-primary-btn);
            color: var(--nexu-accent-contrast);
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .btn-markpact:hover { background: var(--nexu-accent); transform: scale(1.05); }
        .btn-markpact:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
        .toast-notification {
            position: fixed;
            top: 16px;
            right: 16px;
            background: var(--nexu-success);
            color: var(--nexu-accent-contrast);
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 99999;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            pointer-events: none;
        }
        .toast-notification.show {
            opacity: 1;
            transform: translateY(0);
        }
        .workflow-guide {
            display: flex;
            gap: 10px;
            padding: 10px 16px;
            background: var(--nexu-bg-elevated);
            border-bottom: 1px solid var(--nexu-border-subtle);
            align-items: stretch;
        }
        .wf-step {
            flex: 1;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid var(--nexu-border);
            font-size: 0.78rem;
            color: var(--nexu-text-secondary);
            line-height: 1.35;
        }
        .wf-step strong { color: var(--nexu-text); display: block; margin-bottom: 2px; font-size: 0.82rem; }
        .wf-step.active { border-color: var(--nexu-accent); background: var(--nexu-accent-glow); color: var(--nexu-text-body); }
        .wf-step.done { border-color: var(--nexu-success-text); color: var(--nexu-success-text); }
        .workflow-hint {
            padding: 0 16px 10px;
            font-size: 0.8rem;
            color: var(--nexu-text-muted);
            background: var(--nexu-bg-elevated);
            border-bottom: 1px solid var(--nexu-border-subtle);
        }
        .intract-policy-panel.collapsed .intract-policy-body,
        .intract-policy-panel.collapsed .intract-policy-actions,
        .intract-policy-panel.collapsed .intract-policy-meta { display: none; }
        .btn-action:disabled { opacity: 0.45; cursor: not-allowed; }
        .server-offline-banner {
            flex-shrink: 0;
            padding: 10px 30px;
            background: var(--nexu-offline-bg);
            border-bottom: 1px solid var(--nexu-offline-border);
            color: var(--nexu-offline-text);
            font-size: 0.85rem;
            line-height: 1.45;
        }
        .server-offline-banner code {
            background: var(--nexu-bg-inset);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.82rem;
        }
        @media (max-width: 1280px) {
            .main-container {
                grid-template-columns: minmax(500px, 1fr) minmax(280px, 25vw) minmax(300px, 27vw);
            }
            .active-column,
            .options-column,
            .side-panel {
                padding: 10px;
            }
        }
    </style>
</head>
<body>
    <div id="toast" class="toast-notification">📋 JSON copied to clipboard!</div>
    <div id="server-offline-banner" class="server-offline-banner" hidden></div>
    <div class="header">
        <div class="header-left">
            <h1>🎬 Nexu</h1>
            <div class="header-tabs" role="tablist">
                <button type="button" class="header-tab active" id="tab-projects" data-tab="projects" onclick="switchMainTab('projects')">Projects</button>
                <button type="button" class="header-tab" id="tab-editor" data-tab="editor" onclick="switchMainTab('editor')" disabled title="Pick a project to open the editor">Editor</button>
                <button type="button" class="header-tab" id="tab-llm" data-tab="llm" onclick="switchMainTab('llm')">LLM</button>
                <button type="button" class="header-tab" id="tab-services" data-tab="services" onclick="switchMainTab('services')">Services</button>
            </div>
        </div>
        <div class="controls" id="editor-header-controls" hidden>
            <span class="llm-status-badge warn" id="llm-status-badge" title="LLM model status">LLM: loading…</span>
            <button class="btn btn-stage active" onclick="switchStage(0)" title="Load a saved baseline template into the workspace">S0 baseline</button>
            <button class="btn btn-stage" onclick="switchStage(1)" title="Load mid template">S1 template</button>
            <button class="btn btn-stage" onclick="switchStage(2)" title="Load evolved template">S2 template</button>
            <button class="btn btn-copy" id="copy-btn" onclick="copyStateToClipboard()">📋 Copy session</button>
            <button class="btn btn-markpact" id="markpact-btn-editor" onclick="downloadMarkpactExport()" title="Download README.md for Markpact shell">⬇ Markpact</button>
            <button class="btn btn-publish" id="publish-btn-editor" onclick="publishCurrentProject()" title="Deploy stage via Markpact to Services">🚀 Publish</button>
        </div>
        <div class="header-theme" role="group" aria-label="Theme">
            <span class="theme-picker-label">Theme</span>
            <div class="theme-chips filter-chips">
                <button type="button" class="filter-chip theme-chip active" data-theme="dark" onclick="setCinemaTheme('dark')">Dark</button>
                <button type="button" class="filter-chip theme-chip" data-theme="warm" onclick="setCinemaTheme('warm')">Warm</button>
                <button type="button" class="filter-chip theme-chip" data-theme="light" onclick="setCinemaTheme('light')">Light</button>
            </div>
        </div>
    </div>

    <div id="projects-shell" class="projects-shell">
        <div id="project-active-bar" class="project-active-bar" hidden>
            <div class="project-active-info">
                <h2 class="project-active-title" id="project-active-title">Current project</h2>
                <p class="project-active-meta" id="project-active-meta">Open Editor to refine, then deploy to Services via Markpact.</p>
            </div>
            <div class="project-active-actions">
                <button type="button" class="btn btn-service btn-service-primary" onclick="switchMainTab('editor')" title="Edit workspace, options, and policy">Open editor →</button>
                <button type="button" class="btn btn-markpact" id="markpact-btn" onclick="downloadMarkpactExport()" title="Download Markpact README for current stage">⬇ Markpact</button>
                <button type="button" class="btn btn-publish" id="publish-btn" onclick="publishCurrentProject()" title="Deploy stage via Markpact to Services">🚀 Publish</button>
                <button type="button" class="btn btn-service" onclick="switchMainTab('services')">Services →</button>
            </div>
        </div>
        <section class="projects-import" aria-label="Import project">
            <div class="projects-workflow" aria-label="Import workflow">
                <div class="projects-workflow-step"><strong>1. Import</strong>ZIP, Git URL albo HTTP website.</div>
                <div class="projects-workflow-step"><strong>2. Markpact</strong>Nexu zapisuje lokalny README.markpact.md.</div>
                <div class="projects-workflow-step"><strong>3. Editor</strong>Projekt działa lokalnie w pętli ABC.</div>
                <div class="projects-workflow-step"><strong>4. Publish</strong>Aktualny stage można opublikować do Services.</div>
            </div>
            <article class="import-card">
                <h3>📦 Upload ZIP</h3>
                <p>Spakuj projekt lokalnie i zaimportuj do Nexu. Najpierw konwersja do Markpact.</p>
                <input type="file" id="import-zip-file" accept=".zip,application/zip">
                <div class="import-actions">
                    <button type="button" class="btn-import" id="import-zip-btn" onclick="importProjectZip()">Importuj ZIP</button>
                </div>
                <div class="import-status" id="import-zip-status"></div>
            </article>
            <article class="import-card">
                <h3>🔗 Git URL</h3>
                <p>Płytki klon repozytorium (depth 1). Opcjonalna gałąź.</p>
                <input type="url" id="import-git-url" placeholder="https://github.com/org/repo.git">
                <input type="text" id="import-git-branch" placeholder="branch (opcjonalnie)">
                <div class="import-actions">
                    <button type="button" class="btn-import" id="import-git-btn" onclick="importProjectGit()">Importuj Git</button>
                </div>
                <div class="import-status" id="import-git-status"></div>
            </article>
            <article class="import-card">
                <h3>🌐 HTTP website</h3>
                <p>Pobierz stronę WWW i zamień na kontrakt Markpact (wymaga allow_network_calls).</p>
                <input type="url" id="import-http-url" placeholder="https://example.com">
                <div class="import-actions">
                    <button type="button" class="btn-import" id="import-http-btn" onclick="importProjectHttp()">Importuj HTTP</button>
                </div>
                <div class="import-status" id="import-http-status"></div>
            </article>
        </section>
        <div class="projects-toolbar">
            <input type="search" id="projects-search" class="projects-search" placeholder="Filter examples…" oninput="renderProjectsGrid()">
            <div class="filter-chips" id="domain-filters"></div>
            <div class="filter-chips" id="kind-filters"></div>
        </div>
        <div class="projects-grid" id="projects-grid">
            <div class="projects-empty">Loading example projects…</div>
        </div>
        <div class="markpact-modal-backdrop" id="markpact-modal-backdrop" onclick="if (event.target === this) closeMarkpactModal()">
            <div class="markpact-modal" role="dialog" aria-labelledby="markpact-modal-title">
                <header>
                    <h3 id="markpact-modal-title">Kontrakt Markpact</h3>
                    <button type="button" class="btn btn-service" onclick="closeMarkpactModal()">Zamknij</button>
                </header>
                <div class="markpact-modal-md" id="markpact-modal-md">Ładowanie…</div>
            </div>
        </div>
        <div class="markpact-modal-backdrop" id="goal-prompt-modal-backdrop">
            <div class="markpact-modal goal-prompt-modal" role="dialog" aria-labelledby="goal-prompt-modal-title">
                <header>
                    <h3 id="goal-prompt-modal-title">Cel projektu</h3>
                </header>
                <p>Co chcesz zmienić na tej stronie? Opisz cel migracji lub ulepszenia UI.</p>
                <textarea id="goal-prompt-input" placeholder="np. nowa nawigacja, kolory marki, uproszczenie formularza…"></textarea>
                <div class="goal-prompt-actions">
                    <button type="button" class="btn btn-service" onclick="closeGoalPromptModal()">Anuluj</button>
                    <button type="button" class="btn btn-action" onclick="confirmGoalPromptModal()">Zapisz cel</button>
                </div>
            </div>
        </div>
    </div>

    <div id="services-shell" class="services-shell" hidden>
        <div class="services-toolbar">
            <p class="services-toolbar-hint">Services deployed from the Editor (Markpact). Start/stop local HTTP on ports 9200–9298.</p>
            <button type="button" class="btn btn-service" onclick="loadServicesCatalog()">↻ Refresh</button>
        </div>
        <div class="services-grid" id="services-grid">
            <div class="services-empty">Loading services…</div>
        </div>
    </div>

    <div id="llm-shell" class="llm-shell" hidden>
        <div class="llm-trace-list" id="llm-trace-list">
            <div class="services-empty">No LLM traces yet.</div>
        </div>
        <div class="llm-trace-view">
            <div class="llm-trace-toolbar">
                <p>Prompt and response markdown exchanged between Nexu and the configured LLM.</p>
                <div class="llm-trace-actions">
                    <button type="button" class="btn btn-service" onclick="copyLlmRequest()" id="llm-copy-request" disabled>📋 Copy request</button>
                    <button type="button" class="btn btn-service" onclick="downloadLlmRequest()" id="llm-download-request" disabled>⬇ Request.md</button>
                    <button type="button" class="btn btn-service" onclick="downloadLlmTrace()" id="llm-download-trace" disabled>⬇ Trace.md</button>
                    <button type="button" class="btn btn-service" onclick="loadLlmTraces()">↻ Refresh</button>
                </div>
                <div class="llm-trace-stats" id="llm-trace-stats">
                    <div class="llm-stat-card"><strong>Request</strong>0 tokens · 0 B</div>
                    <div class="llm-stat-card"><strong>Response</strong>0 tokens · 0 B</div>
                    <div class="llm-stat-card"><strong>Total</strong>0 tokens · 0 B</div>
                </div>
            </div>
            <div class="llm-trace-md" id="llm-trace-md">Run Refresh Options A–C to capture the next LLM exchange.</div>
        </div>
    </div>

    <div id="editor-app-shell" class="editor-app-shell" hidden>
    <div class="workflow-guide" id="workflow-guide">
        <div class="wf-step active" id="wf-step-1"><strong>1. Goal or marks</strong>Set project goal (yellow) or mark elements (purple hints).</div>
        <div class="wf-step" id="wf-step-2"><strong>2. Options A–C</strong>Updated by iteration after each goal/mark change — workspace unchanged.</div>
        <div class="wf-step" id="wf-step-3"><strong>3. Promote</strong>Click A, B, or C → refine with more marks or goals.</div>
    </div>
    <div class="workflow-hint" id="workflow-hint">Each goal or mark sends feedback to AI and triggers iteration for Options A–C.</div>
    
    <div class="workspace-shell">
    <div class="main-container">
        <!-- 1. Left Column: Active Workspace -->
        <div class="active-column">
            <div class="panel active-panel">
                <div class="panel-header panel-header-accent">
                    <span>🔵 1. ACTIVE WORKSPACE</span>
                    <span id="workspace-hint" style="font-size: 0.65rem;">[Drag: left = keep · right = remove]</span>
                </div>
                <div class="panel-body">
                    <iframe id="active-frame" name="active-frame" src="stage0.html?role=workspace&amp;active=true&amp;mark=1&amp;calc=0&amp;review=0&amp;stage=0"></iframe>
                </div>
            </div>
        </div>
        
        <!-- 2. Middle Column: Stacked Alternative Options -->
        <div class="options-column">
            <div class="scope-options-bar" aria-label="Scope contract filter for Options A-C">
                <div class="scope-options-title">
                    <span>Scope contract</span>
                    <span class="scope-options-active" id="scope-active-label">#functions</span>
                </div>
                <div class="scope-options-chips" id="scope-options-chips"></div>
                <div class="scope-options-help" id="scope-options-help">
                    Filters Options A-C and tells AI which evolution axis to generate now.
                </div>
            </div>
            <!-- Option A -->
            <div class="panel option-panel" onclick="promoteAlt('alt_a.html', 'Option A')">
                <div class="panel-header">
                    <span>⚡ OPTION A (Minimalist)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-a-frame" name="alt-a-frame" src="alt_a.html?role=option&amp;pane=a&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
            
            <!-- Option B -->
            <div class="panel option-panel" onclick="promoteAlt('alt_b.html', 'Option B')">
                <div class="panel-header">
                    <span>⚡ OPTION B (Standard)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-b-frame" name="alt-b-frame" src="alt_b.html?role=option&amp;pane=b&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
            
            <!-- Option C -->
            <div class="panel option-panel" onclick="promoteAlt('alt_c.html', 'Option C')">
                <div class="panel-header">
                    <span>⚡ OPTION C (Expanded)</span>
                    <span class="promote-indicator">🖱️ Click</span>
                </div>
                <div class="panel-body">
                    <iframe id="alt-c-frame" name="alt-c-frame" src="alt_c.html?role=option&amp;pane=c&amp;mark=0&amp;calc=0"></iframe>
                </div>
            </div>
        </div>
        
        <!-- 3. Right Column: Chat & Settings -->
        <div class="side-panel">
            <div class="side-header">💬 Live Chat & Automated Logs</div>
            <div class="chat-logs" id="chat-logs">
                <div class="chat-msg system"><strong>System:</strong> Set a <strong>project goal</strong> (yellow) or mark workspace elements (purple hints) — then run iteration to refresh <strong>Options A–C</strong>.</div>
            </div>

            <div class="side-header">1. Project goal</div>
            <textarea id="goal-input" class="hint-input goal-input" placeholder="Docelowy kierunek projektu — zapisany jako kontrakty Intract (require: freeze.baseline), rozbudowa bez regresji modelu bazowego calc.*"></textarea>
            <button type="button" class="btn-hint btn-goal" onclick="setProjectGoal()">🎯 Set project goal</button>

            <div class="side-header">2. Mark workspace (drag)</div>
            <button type="button" class="btn-review" id="btn-review-mode" onclick="toggleElementReviewMode()">🖱️ Drag marking (default)</button>
            <div class="feedback-list" id="feedback-list">
                <div class="cinema-empty-hint">
                    Drag over controls: <strong>left mouse</strong> = keep (green), <strong>right mouse</strong> = remove (red). Box can cover many buttons at once.
                </div>
            </div>

            <div class="side-header">3. Element hint (optional note)</div>
            <textarea id="element-hint-input" class="hint-input element-hint-input" placeholder="Note about marked elements, e.g. keep digit 5, redesign trig row…"></textarea>
            <button type="button" class="btn-hint btn-element-hint" id="btn-element-hint" onclick="addElementHint()">💡 Add element hint</button>
            
            <div class="side-header">Summary for AI</div>
            <div class="prompt-box" id="prompt-box">Set a project goal or mark elements to begin.</div>
            
            <button class="btn btn-action" id="action-btn" style="margin-top: 15px; width: 100%;" disabled onclick="runLiveIteration({ manual: true })">
                Set a goal or mark elements to start
            </button>
        </div>
    </div>
    </div>

    <div class="bottom-panels-row">
        <div class="history-panel" id="history-panel">
            <div class="bottom-panel-header">
                <span>🕐 Change history</span>
                <span class="intract-policy-meta" id="history-meta">0 checkpoints</span>
            </div>
            <div class="history-panel-body" id="history-panel-body">
                Loading history…
            </div>
        </div>
        <div class="intract-policy-panel" id="intract-policy-panel">
            <div class="intract-policy-header">
                <span>📜 Policy contracts</span>
                <div class="intract-policy-actions">
                    <button class="btn-policy" onclick="applyLedgerToManifest(false, 'project')">⬆ Project</button>
                    <button class="btn-policy" onclick="applyLedgerToManifest(false, 'capsule')">⬆ Capsule</button>
                    <button class="btn-policy" id="btn-apply-manifest" onclick="applyLedgerToManifest(false, 'both')">⬆ Both</button>
                    <button class="btn-policy" onclick="applyLedgerToManifest(true, 'both')">Dry-run</button>
                    <button class="btn-policy" id="btn-verify-capsule" onclick="verifyCapsuleWorkspace()">✓ Verify</button>
                    <button class="btn-policy" id="btn-propose-llm" onclick="proposeContractsLlm()">🤖 Propose</button>
                </div>
                <span class="intract-policy-meta" id="intract-policy-meta">loading…</span>
            </div>
            <div class="intract-policy-body" id="intract-policy-body">
                Loading contracts…
            </div>
        </div>
    </div>
    </div>

    <script>
        let activeStage = 0;
        let annotations = [];
        let scopedAnnotations = {};
        let annotationHistory = [];
        let lastIteration = null;
        let projectGoal = '';
        let elementHints = [];
        let lastTouchedElementIds = [];
        let pendingGoalOptions = false;
        let requireGoalPrompt = false;
        let workspaceEngaged = false;
        let intractPolicyData = null;
        let historyCheckpoints = [];
        let ledgerArchive = [];
        let selectedHistoryId = null;
        let elementReviewMode = false;
        let mainTab = 'projects';
        let projectCatalog = [];
        let projectFilters = { domains: [], kinds: [], tags: [] };
        let activeProjectId = null;
        let selectedDomainFilter = 'all';
        let selectedKindFilter = 'all';
        let servicesCatalog = [];
        const allScopeOptions = [
            { id: 'functions', label: '#functions', help: 'Features, workflows, data behavior, and interactions.' },
            { id: 'keypad', label: '#keypad', help: 'Control set, button grouping, shortcuts, and input surface.' },
            { id: 'display', label: '#display', help: 'Readouts, dashboards, tables, charts, labels, and hierarchy.' },
            { id: 'colors', label: '#colors', help: 'Palette, contrast, state colors, and visual emphasis.' },
            { id: 'shapes', label: '#shapes', help: 'Component geometry, spacing, density, and visual rhythm.' },
            { id: 'orientation', label: '#orientation', help: 'Layout direction, responsive framing, and screen organization.' },
        ];
        let currentFocusScope = 'functions';

        const NEXU_THEME_KEY = 'nexu-cinema-theme';
        const NEXU_THEMES = ['dark', 'warm', 'light'];

        function applyCinemaTheme(theme) {
            const t = NEXU_THEMES.includes(theme) ? theme : 'dark';
            document.documentElement.setAttribute('data-theme', t);
            try { localStorage.setItem(NEXU_THEME_KEY, t); } catch (_) {}
            document.querySelectorAll('.theme-chip').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.theme === t);
            });
        }

        function setCinemaTheme(theme) {
            applyCinemaTheme(theme);
        }

        function initCinemaTheme() {
            let saved = 'dark';
            try {
                const v = localStorage.getItem(NEXU_THEME_KEY);
                if (NEXU_THEMES.includes(v)) saved = v;
            } catch (_) {}
            applyCinemaTheme(saved);
        }

        function scopeAnnotationKey(scopeId) {
            return String(scopeId || currentFocusScope || 'functions').toLowerCase();
        }

        function persistActiveScopeAnnotations() {
            scopedAnnotations[scopeAnnotationKey(currentFocusScope)] = annotations.slice();
        }

        function ledgerEntryMatchesActiveProject(entry, policyData) {
            const snap = (policyData && policyData.snapshot) || {};
            const activeEx = snap.active_example_project || {};
            const activeId = String(activeProjectId || activeEx.id || '').trim();
            const proj = activeProjectRecord();
            const activeKind = String((proj && proj.kind) || activeEx.kind || '').toLowerCase();
            const entryPid = String(entry.project_id || '').trim();
            if (entryPid) {
                return entryPid === activeId;
            }
            if (activeKind === 'imported' || activeId.startsWith('http-')) {
                return false;
            }
            return true;
        }

        function annotationsFromLedgerForScope(scopeId, policyData) {
            if (!policyData) return [];
            const ledger = Array.isArray(policyData.ledger) ? policyData.ledger : [];
            const scope = String(scopeId || '').trim().toLowerCase();
            if (!scope) return [];
            const byEl = {};
            ledger.forEach(entry => {
                if (!entry || typeof entry !== 'object') return;
                if (entry.status === 'goal_defined') return;
                if (!ledgerEntryMatchesActiveProject(entry, policyData)) return;
                if (entry.stage != null && Number(entry.stage) !== activeStage) return;
                const entryScope = String(entry.focus_scope || '').trim().toLowerCase();
                if (!entryScope || entryScope !== scope) return;
                (entry.keep || []).forEach(id => {
                    const key = String(id).trim();
                    if (key) byEl[key] = 'KEEP';
                });
                (entry.delete || []).forEach(id => {
                    const key = String(id).trim();
                    if (key) byEl[key] = 'DELETE';
                });
            });
            return Object.keys(byEl).map(id => ({
                id: id,
                type: byEl[id],
                scope: scopeId,
                source: 'policy_ledger'
            }));
        }

        function loadActiveScopeAnnotations(scopeId, opts) {
            const options = opts || {};
            const key = scopeAnnotationKey(scopeId);
            if (scopedAnnotations[key] && scopedAnnotations[key].length) {
                annotations = scopedAnnotations[key].map(a => ({ ...a }));
                return;
            }
            if (options.preferLedger && intractPolicyData) {
                annotations = annotationsFromLedgerForScope(scopeId, intractPolicyData);
                scopedAnnotations[key] = annotations.slice();
                return;
            }
            if (intractPolicyData) {
                annotations = annotationsFromLedgerForScope(scopeId, intractPolicyData);
                if (annotations.length) {
                    scopedAnnotations[key] = annotations.slice();
                }
                return;
            }
            annotations = [];
        }

        function resetScopedAnnotations() {
            annotations = [];
            scopedAnnotations = {};
            lastTouchedElementIds = [];
        }

        function allowedScopeIdsForKind(kind) {
            const k = String(kind || 'web').toLowerCase();
            const dashboardKinds = ['dashboard', 'monitor', 'ecosystem', 'api', 'mcp', 'frontend', 'slice'];
            if (dashboardKinds.includes(k)) {
                return ['functions', 'display', 'colors', 'shapes', 'orientation'];
            }
            if (k === 'calculator') {
                return ['functions', 'keypad', 'display', 'colors', 'shapes', 'orientation'];
            }
            return ['functions', 'display', 'colors', 'shapes', 'orientation'];
        }

        function defaultScopeForKind(kind) {
            const k = String(kind || 'web').toLowerCase();
            if (['dashboard', 'monitor', 'ecosystem', 'api', 'mcp', 'frontend', 'slice'].includes(k)) {
                return 'functions';
            }
            if (k === 'calculator') return 'keypad';
            return 'functions';
        }

        function visibleScopeOptions() {
            const proj = activeProjectRecord();
            const allowed = new Set(allowedScopeIdsForKind(proj ? proj.kind : 'web'));
            return allScopeOptions.filter(opt => allowed.has(opt.id));
        }

        function normalizeFocusScopeForActiveProject(opts) {
            const options = opts || {};
            const visible = visibleScopeOptions();
            const ids = visible.map(o => o.id);
            const projKind = activeProjectRecord() ? activeProjectRecord().kind : 'web';
            const fallback = options.defaultScope || defaultScopeForKind(projKind);
            const next = ids.includes(currentFocusScope) ? currentFocusScope : fallback;
            if (next !== currentFocusScope || options.force) {
                selectFocusScope(next, { quiet: true, force: true });
            } else {
                renderScopeOptions();
            }
        }

        let pendingLogEvents = [];

        const NEXU_API_ERROR_MAX = 5;
        const sessionDiagnostics = {
            projects_catalog: null,
            last_projects_action: null,
            delete_flow: null,
            last_api_errors: [],
            cinema_runtime: null,
        };

        function pushSessionApiError(entry) {
            const row = {
                url: String(entry.url || ''),
                status: Number(entry.status || 0),
                message: String(entry.message || '').slice(0, 500),
                timestamp: entry.timestamp || new Date().toISOString(),
            };
            if (/api[_-]?key|authorization|bearer|token=/i.test(row.message)) {
                row.message = '[redacted]';
            }
            sessionDiagnostics.last_api_errors.push(row);
            while (sessionDiagnostics.last_api_errors.length > NEXU_API_ERROR_MAX) {
                sessionDiagnostics.last_api_errors.shift();
            }
        }

        function recordProjectsCatalog(data) {
            const projects = Array.isArray(data.projects) ? data.projects : [];
            sessionDiagnostics.projects_catalog = {
                fetched_at: new Date().toISOString(),
                item_count: projects.length,
                imported: projects.filter(p => p.imported).map(p => ({
                    id: p.id,
                    deletable: !!p.deletable,
                    import_kind: p.import_kind || null,
                    path_hint: p.path_hint || null,
                    source_url: p.source_url || null,
                })),
            };
        }

        function recordProjectsAction(action, projectId, details) {
            const d = details || {};
            sessionDiagnostics.last_projects_action = {
                action: action,
                project_id: projectId || null,
                timestamp: new Date().toISOString(),
                request_url: d.requestUrl || null,
                method: d.method || null,
                status: d.status != null ? d.status : null,
                response_body: d.responseBody != null ? String(d.responseBody).slice(0, 800) : null,
                error: d.error || null,
            };
        }

        function snapshotCatalogEntry(projectId) {
            const p = projectCatalog.find(x => x.id === projectId);
            if (!p) return null;
            return {
                id: p.id,
                deletable: !!p.deletable,
                imported: !!p.imported,
                import_kind: p.import_kind || null,
                path_hint: p.path_hint || null,
                source_url: p.source_url || null,
            };
        }

        function buildSessionDiagnostics() {
            const proj = activeProjectRecord();
            const runtime = sessionDiagnostics.cinema_runtime || {};
            return {
                main_tab: mainTab,
                projects_tab: {
                    selected_domain_filter: selectedDomainFilter,
                    selected_kind_filter: selectedKindFilter,
                    search_query: (document.getElementById('projects-search')?.value || '').trim(),
                    visible_count: projectCatalog.filter(projectMatchesFilters).length,
                    catalog_loaded: !!sessionDiagnostics.projects_catalog,
                },
                projects_catalog: sessionDiagnostics.projects_catalog,
                last_projects_action: sessionDiagnostics.last_projects_action,
                delete_flow: sessionDiagnostics.delete_flow,
                active_project: {
                    id: activeProjectId,
                    is_imported: !!(proj && proj.imported),
                    in_catalog: projectCatalog.some(p => p.id === activeProjectId),
                    catalog_entry: snapshotCatalogEntry(activeProjectId),
                },
                last_api_errors: sessionDiagnostics.last_api_errors.slice(),
                cinema_runtime: {
                    cinema_root: runtime.cinema_root || null,
                    capsule: runtime.capsule || null,
                    workspace_root: runtime.workspace_root || null,
                    template_synced_hint: runtime.template_synced_hint || null,
                    cinema_player_mtime: runtime.cinema_player_mtime || null,
                },
                cinema_server_online: cinemaServerOnline,
            };
        }

        (function installNexuFetchDiagnostics() {
            const nativeFetch = window.fetch.bind(window);
            window.fetch = function nexuFetch(input, init) {
                const url = typeof input === 'string' ? input : (input && input.url) || '';
                const method = ((init && init.method) || (input && input.method) || 'GET').toUpperCase();
                const track = url.startsWith('/') || (url && url.indexOf(location.origin) === 0);
                return nativeFetch(input, init).then(async res => {
                    if (track && !res.ok) {
                        let body = '';
                        try {
                            body = (await res.clone().text()).slice(0, 500);
                        } catch (_) {}
                        pushSessionApiError({
                            url: url,
                            method: method,
                            status: res.status,
                            message: body || res.statusText,
                        });
                    }
                    return res;
                }).catch(err => {
                    if (track) {
                        pushSessionApiError({
                            url: url,
                            method: method,
                            status: 0,
                            message: err.message,
                        });
                    }
                    throw err;
                });
            };
        })();

        function postLogEvent(action, payload) {
            fetch('/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action, details: JSON.stringify(payload) })
            }).catch(() => {});
        }

        function flushPendingLogEvents() {
            if (!cinemaServerOnline || !pendingLogEvents.length) return;
            const batch = pendingLogEvents.splice(0);
            batch.forEach(entry => postLogEvent(entry.action, entry.payload));
        }

        function logEvent(action, details) {
            const ts = new Date().toISOString();
            const payload = typeof details === 'object' && details !== null
                ? { tab: mainTab, project: activeProjectId, stage: activeStage, review: elementReviewMode, annotations: annotations.length, ...details }
                : { tab: mainTab, project: activeProjectId, stage: activeStage, review: elementReviewMode, annotations: annotations.length, msg: String(details || '') };
            console.log('[NEXU]', ts, action, payload);
            if (!cinemaServerOnline) {
                pendingLogEvents.push({ action: action, payload: payload });
                return;
            }
            postLogEvent(action, payload);
        }

        function refreshLlmStatus() {
            const badge = document.getElementById('llm-status-badge');
            if (!badge) return;
            fetch('/llm/status')
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    const model = data.model || 'unknown';
                    const provider = data.provider || 'llm';
                    const ready = !!data.allow_network_calls && !!data.api_key_present && !!data.litellm_available;
                    const partial = !!data.allow_network_calls && (!data.api_key_present || !data.litellm_available);
                    badge.classList.remove('ready', 'warn', 'error');
                    badge.classList.add(ready ? 'ready' : (partial ? 'warn' : 'error'));
                    badge.textContent = `LLM: ${provider} · ${model}`;
                    const details = [
                        `provider: ${provider}`,
                        `model: ${model}`,
                        `network: ${data.allow_network_calls ? 'enabled' : 'disabled'}`,
                        `${data.api_key_env || 'API key'}: ${data.api_key_present ? 'present' : 'missing'}`,
                        `litellm: ${data.litellm_available ? 'available' : 'missing'}`,
                    ];
                    if (data.base_url) details.push(`base: ${data.base_url}`);
                    badge.title = details.join('\n');
                })
                .catch(err => {
                    badge.classList.remove('ready', 'warn');
                    badge.classList.add('error');
                    badge.textContent = 'LLM: unavailable';
                    badge.title = 'Could not load LLM status: ' + err.message;
                });
        }

        let selectedLlmTraceId = '';
        let llmProjectFilter = '';
        let currentLlmTraceMarkdown = '';
        let currentLlmTraceFilename = 'llm-trace.md';

        function escapeHtml(text) {
            return String(text || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function renderTraceMarkdown(text) {
            const src = String(text || '');
            const parts = src.split(/(```[\s\S]*?```)/g);
            return parts.map(part => {
                if (part.startsWith('```') && part.endsWith('```')) {
                    const inner = part.slice(3, -3).replace(/^\w*\n?/, '');
                    return '<pre><code>' + escapeHtml(inner.trim()) + '</code></pre>';
                }
                return escapeHtml(part)
                    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
                    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
                    .replace(/^# (.+)$/gm, '<h1>$1</h1>')
                    .replace(/^- (.+)$/gm, '<li>$1</li>')
                    .replace(/(<li>[\s\S]*?<\/li>)/g, block => '<ul>' + block + '</ul>')
                    .replace(/`([^`\n]+)`/g, '<code>$1</code>')
                    .replace(/\n\n+/g, '</p><p>')
                    .replace(/^(.+)$/gm, (line) => {
                        if (/^<(h[123]|ul|pre)/.test(line)) return line;
                        return line ? '<p>' + line + '</p>' : '';
                    });
            }).join('');
        }

        function textMetrics(text) {
            const value = String(text || '');
            return {
                chars: value.length,
                bytes: new Blob([value]).size,
                tokens: value ? Math.max(1, Math.ceil(value.length / 4)) : 0
            };
        }

        function formatBytes(bytes) {
            const n = Number(bytes || 0);
            if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(2) + ' MB';
            if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
            return n + ' B';
        }

        function formatCount(n) {
            return Number(n || 0).toLocaleString('en-US');
        }

        function extractTraceSection(markdown, heading) {
            const src = String(markdown || '');
            const start = src.indexOf(heading);
            if (start < 0) return '';
            const afterHeading = src.slice(start + heading.length);
            const fenceStart = afterHeading.indexOf('```');
            if (fenceStart < 0) return afterHeading.trim();
            const contentStart = afterHeading.indexOf('\n', fenceStart);
            if (contentStart < 0) return '';
            const afterFence = afterHeading.slice(contentStart + 1);
            const fenceEnd = afterFence.indexOf('```');
            return (fenceEnd >= 0 ? afterFence.slice(0, fenceEnd) : afterFence).trim();
        }

        function currentLlmRequestText() {
            return extractTraceSection(currentLlmTraceMarkdown, '## Prompt sent to LLM');
        }

        function currentLlmResponseText() {
            return extractTraceSection(currentLlmTraceMarkdown, '## Response received from LLM');
        }

        function renderLlmTraceStats(markdown, apiMetrics) {
            const requestText = currentLlmRequestText();
            const responseText = currentLlmResponseText();
            const req = {
                chars: apiMetrics?.prompt_chars ?? textMetrics(requestText).chars,
                bytes: apiMetrics?.prompt_bytes ?? textMetrics(requestText).bytes,
                tokens: apiMetrics?.prompt_tokens_est ?? textMetrics(requestText).tokens
            };
            const res = {
                chars: apiMetrics?.output_chars ?? textMetrics(responseText).chars,
                bytes: apiMetrics?.output_bytes ?? textMetrics(responseText).bytes,
                tokens: apiMetrics?.output_tokens_est ?? textMetrics(responseText).tokens
            };
            const total = {
                chars: apiMetrics?.total_chars ?? (Number(req.chars || 0) + Number(res.chars || 0)),
                bytes: apiMetrics?.total_bytes ?? (Number(req.bytes || 0) + Number(res.bytes || 0)),
                tokens: apiMetrics?.total_tokens_est ?? (Number(req.tokens || 0) + Number(res.tokens || 0))
            };
            const full = textMetrics(markdown || '');
            const stats = document.getElementById('llm-trace-stats');
            if (!stats) return;
            stats.innerHTML = `
                <div class="llm-stat-card"><strong>Request</strong>${formatCount(req.tokens)} tokens est · ${formatBytes(req.bytes)}<br>${formatCount(req.chars)} chars</div>
                <div class="llm-stat-card"><strong>Response</strong>${formatCount(res.tokens)} tokens est · ${formatBytes(res.bytes)}<br>${formatCount(res.chars)} chars</div>
                <div class="llm-stat-card"><strong>Total / file</strong>${formatCount(total.tokens)} tokens est · ${formatBytes(total.bytes)}<br>trace file ${formatBytes(full.bytes)}</div>
            `;
        }

        function setLlmTraceActionsEnabled(enabled) {
            ['llm-copy-request', 'llm-download-request', 'llm-download-trace'].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) btn.disabled = !enabled;
            });
        }

        function setLlmTraceMarkdown(text) {
            const out = document.getElementById('llm-trace-md');
            if (!out) return;
            currentLlmTraceMarkdown = String(text || '');
            setLlmTraceActionsEnabled(Boolean(currentLlmRequestText()));
            renderLlmTraceStats(currentLlmTraceMarkdown, null);
            if (!text) {
                out.textContent = '(empty trace)';
                return;
            }
            out.innerHTML = renderTraceMarkdown(text);
        }

        function loadLlmTraces(projectId) {
            const list = document.getElementById('llm-trace-list');
            if (list) {
                list.innerHTML = '<div class="services-empty">Loading LLM traces…</div>';
            }
            if (projectId) {
                llmProjectFilter = projectId;
            }
            const filter = projectId || llmProjectFilter || '';
            const query = filter ? ('?project=' + encodeURIComponent(filter)) : '';
            fetch('/llm/traces' + query)
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    const traces = Array.isArray(data.traces) ? data.traces : [];
                    renderLlmTraceList(traces);
                    if (traces.length && !selectedLlmTraceId) {
                        loadLlmTrace(traces[0].id);
                    } else if (!traces.length) {
                        setLlmTraceMarkdown(filter
                            ? ('Brak śladów LLM dla projektu ' + filter + '. Uruchom iterację w Edytorze.')
                            : 'Run Refresh Options A–C to capture the next LLM exchange.');
                    }
                })
                .catch(err => {
                    if (list) {
                        list.innerHTML = `<div class="services-empty">Could not load traces: ${err.message}</div>`;
                    }
                });
        }

        function renderLlmTraceList(traces) {
            const list = document.getElementById('llm-trace-list');
            if (!list) return;
            if (!traces.length) {
                list.innerHTML = '<div class="services-empty">No LLM traces yet.</div>';
                return;
            }
            list.innerHTML = traces.map(t => {
                const active = t.id === selectedLlmTraceId ? ' active' : '';
                const status = t.status === 'error' ? 'error' : 'ok';
                const ms = t.duration_ms != null ? `${t.duration_ms} ms` : '? ms';
                const reqTokens = t.prompt_tokens_est || Math.ceil((t.prompt_chars || 0) / 4);
                const outTokens = t.output_tokens_est || Math.ceil((t.output_chars || 0) / 4);
                const reqBytes = t.prompt_bytes || t.prompt_chars || 0;
                const outBytes = t.output_bytes || t.output_chars || 0;
                const size = `${formatCount(reqTokens)} → ${formatCount(outTokens)} tok · ${formatBytes(reqBytes)} → ${formatBytes(outBytes)}`;
                return `
                    <button type="button" class="llm-trace-item${active}" onclick='loadLlmTrace(${JSON.stringify(t.id)})'>
                        <strong>${t.label || t.id}</strong>
                        <span>${status} · ${ms}<br>${size}<br>${t.model || ''}</span>
                    </button>
                `;
            }).join('');
        }

        function loadLlmTrace(traceId) {
            selectedLlmTraceId = traceId;
            setLlmTraceMarkdown('Loading trace…');
            fetch('/llm/trace?id=' + encodeURIComponent(traceId))
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    currentLlmTraceFilename = data.filename || (traceId + '.md');
                    setLlmTraceMarkdown(data.markdown || data.error || '(empty trace)');
                    renderLlmTraceStats(data.markdown || '', data.markdown_metrics ? null : data);
                    loadLlmTraces();
                })
                .catch(err => {
                    setLlmTraceMarkdown('Could not load trace: ' + err.message);
                });
        }

        function downloadTextFile(filename, text, mime) {
            const blob = new Blob([text], { type: mime || 'text/markdown;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        function llmRequestFilename() {
            return currentLlmTraceFilename.replace(/\.md$/i, '') + '.request.md';
        }

        function copyLlmRequest() {
            const request = currentLlmRequestText();
            if (!request) return;
            navigator.clipboard.writeText(request)
                .then(() => addChatLog('system', '📋 <strong>LLM request copied to clipboard.</strong>'))
                .catch(err => addChatLog('system', '❌ <strong>Copy failed: ' + err.message + '</strong>'));
        }

        function downloadLlmRequest() {
            const request = currentLlmRequestText();
            if (!request) return;
            downloadTextFile(llmRequestFilename(), request + '\n', 'text/markdown;charset=utf-8');
            addChatLog('system', `⬇ <strong>LLM request downloaded:</strong> ${llmRequestFilename()}`);
        }

        function downloadLlmTrace() {
            if (!currentLlmTraceMarkdown) return;
            downloadTextFile(currentLlmTraceFilename, currentLlmTraceMarkdown, 'text/markdown;charset=utf-8');
            addChatLog('system', `⬇ <strong>LLM trace downloaded:</strong> ${currentLlmTraceFilename}`);
        }

        function calcEnabledForProject() {
            const proj = activeProjectRecord();
            if (!proj) return 0;
            const k = String(proj.kind || '').toLowerCase();
            return k === 'calculator' ? 1 : 0;
        }

        function buildFrameQuery(spec) {
            const p = new URLSearchParams();
            if (spec.role) p.set('role', spec.role);
            if (spec.active) p.set('active', 'true');
            if (spec.pane) p.set('pane', spec.pane);
            if (spec.mark != null) p.set('mark', spec.mark ? '1' : '0');
            if (spec.calc != null) p.set('calc', spec.calc ? '1' : '0');
            if (spec.review != null) p.set('review', spec.review ? '1' : '0');
            if (spec.stage != null) p.set('stage', String(spec.stage));
            p.set('t', String(spec.t != null ? spec.t : Date.now()));
            return '?' + p.toString();
        }

        function frameUrl(file, spec) {
            return file + buildFrameQuery(spec);
        }

        function updatePlayerUrl() {
            const p = new URLSearchParams();
            p.set('tab', mainTab);
            if (activeProjectId) p.set('project', activeProjectId);
            p.set('stage', String(activeStage));
            p.set('review', elementReviewMode ? '1' : '0');
            p.set('mark', '1');
            p.set('annotations', String(annotations.length));
            if (currentFocusScope) p.set('scope', currentFocusScope);
            if (pendingGoalOptions) p.set('pending', '1');
            if (workspaceEngaged) p.set('workspace', '1');
            p.set('mode', resolveIterationMode());
            const qs = p.toString();
            const next = 'cinema_player.html' + (qs ? '?' + qs : '');
            if (location.pathname.endsWith('cinema_player.html') && location.search !== '?' + qs) {
                history.replaceState(null, '', next);
            }
        }

        function bindFrameLoad(id, label) {
            const fr = document.getElementById(id);
            if (!fr || fr.dataset.nexuBound === '1') return;
            fr.dataset.nexuBound = '1';
            fr.addEventListener('load', () => {
                logEvent('FRAME_LOAD', { frame: label, src: fr.src });
                lastIframeSyncKey = '';
                syncAllIframeVisuals();
            });
        }

        let cinemaServerOnline = false;

        let bootProjectId = null;
        let bootTab = null;

        (function applyBootUrlParams() {
            const boot = new URLSearchParams(location.search);
            if (boot.has('review')) elementReviewMode = boot.get('review') !== '0';
            if (boot.has('stage')) {
                const s = parseInt(boot.get('stage'), 10);
                if (!isNaN(s)) activeStage = s;
            }
            if (boot.has('scope')) {
                const scope = boot.get('scope');
                if (allScopeOptions.some(opt => opt.id === scope)) {
                    currentFocusScope = scope;
                }
            }
            if (boot.has('tab')) bootTab = boot.get('tab');
            if (boot.has('project')) bootProjectId = boot.get('project');
        })();

        logEvent('PAGE_LOAD', { href: location.href, review: elementReviewMode, stage: activeStage });
        renderScopeOptions();
        syncReviewModeToFrames();
        document.addEventListener('click', (e) => {
            const t = e.target;
            if (!t || !t.closest) return;
            const tag = (t.tagName || '').toLowerCase();
            const role = t.getAttribute('role');
            const id = t.id || '';
            const cls = typeof t.className === 'string' ? t.className : '';
            if (tag === 'iframe' || t.closest('iframe')) return;
            if (['button', 'a'].includes(tag) || role === 'button' || t.closest('button, .btn-stage, .project-card, .tab-btn, .nexu-review-btn')) {
                logEvent('UI_CLICK', {
                    tag: tag,
                    id: id,
                    class: cls.slice(0, 80),
                    text: (t.innerText || '').trim().slice(0, 40)
                });
            }
        }, true);
        bindFrameLoad('active-frame', 'workspace');
        bindFrameLoad('alt-a-frame', 'option_a');
        bindFrameLoad('alt-b-frame', 'option_b');
        bindFrameLoad('alt-c-frame', 'option_c');
        loadProjectsCatalog().then(() => {
            const finishBoot = (projectId) => {
                if (!projectId) return;
                activeProjectId = projectId;
                normalizeFocusScopeForActiveProject();
                const tabEditor = document.getElementById('tab-editor');
                if (tabEditor) tabEditor.disabled = false;
                updateProjectActiveBar();
                const needsGoal = activeProjectRequiresGoal();
                const requestedTab = ['projects', 'editor', 'llm', 'services'].includes(bootTab)
                    ? bootTab
                    : '';
                const tab = requestedTab || 'editor';
                switchMainTab(tab, { skipLog: true });
                if (needsGoal && tab === 'editor') {
                    promptForRequiredGoalOnEditor({ quiet: true });
                }
            };
            const activateBootProject = () => {
                if (!bootProjectId) return Promise.resolve(null);
                return activateProject(bootProjectId, { skipEditorSwitch: true, quiet: true }).catch(() => null);
            };
            return pingCinemaServer()
                .then(() => fetch('/projects/active').then(res => res.ok ? res.json() : null))
                .then(data => {
                    const serverId = data && data.active && data.active.id ? data.active.id : null;
                    const needsGoalPrompt = (id) => {
                        const proj = projectCatalog.find(p => p.id === id);
                        return !!(proj && proj.imported && proj.import_kind === 'http');
                    };
                    if (bootProjectId && bootProjectId !== serverId) {
                        return activateBootProject().then(() => finishBoot(bootProjectId));
                    }
                    if (serverId) {
                        if (needsGoalPrompt(serverId)) {
                            return activateProject(serverId, { skipEditorSwitch: true, quiet: true })
                                .then(() => finishBoot(serverId))
                                .catch(() => finishBoot(serverId));
                        }
                        finishBoot(serverId);
                        return;
                    }
                    if (bootProjectId) {
                        return activateBootProject().then(() => finishBoot(bootProjectId));
                    }
                });
        }).catch(() => {});

        function switchMainTab(tab, opts) {
            const options = opts || {};
            if (tab === 'editor' && !activeProjectId) return;
            mainTab = tab;
            const projectsShell = document.getElementById('projects-shell');
            const editorShell = document.getElementById('editor-app-shell');
            const servicesShell = document.getElementById('services-shell');
            const llmShell = document.getElementById('llm-shell');
            const editorControls = document.getElementById('editor-header-controls');
            document.getElementById('tab-projects').classList.toggle('active', tab === 'projects');
            document.getElementById('tab-editor').classList.toggle('active', tab === 'editor');
            document.getElementById('tab-llm').classList.toggle('active', tab === 'llm');
            document.getElementById('tab-services').classList.toggle('active', tab === 'services');
            if (projectsShell) projectsShell.hidden = tab !== 'projects';
            if (editorShell) editorShell.hidden = tab !== 'editor';
            if (llmShell) llmShell.hidden = tab !== 'llm';
            if (servicesShell) servicesShell.hidden = tab !== 'services';
            if (editorControls) editorControls.hidden = tab !== 'editor';
            if (tab !== 'editor') {
                closeGoalPromptModal();
            }
            if (tab === 'projects') updateProjectActiveBar();
            if (tab === 'editor') {
                refreshIntractPolicy();
                refreshHistory();
                reloadCinemaFrames();
                syncReviewModeToFrames();
            }
            if (tab === 'llm') loadLlmTraces();
            if (tab === 'services') loadServicesCatalog();
            if (!options.skipLog) {
                logEvent('MAIN_TAB', { tab: tab });
            }
            updatePlayerUrl();
        }

        function activeProjectRecord() {
            return projectCatalog.find(p => p.id === activeProjectId) || null;
        }

        function isPlaceholderGoal(text) {
            const t = String(text || '').trim().toLowerCase();
            if (!t) return true;
            const placeholders = [
                'markpact migration workspace',
                'markpact migration',
                'migration workspace',
                'imported project',
                'chemical & scientific keypad',
                'keypad evolution',
            ];
            return placeholders.some(p => t.includes(p));
        }

        function activeProjectRequiresGoal() {
            const proj = activeProjectRecord();
            return !!(proj && proj.imported && proj.import_kind === 'http');
        }

        function projectNeedsGoalPrompt(data) {
            if (data && data.goal_required) return true;
            const proj = data && data.project ? data.project : activeProjectRecord();
            return !!(proj && proj.imported && proj.import_kind === 'http');
        }

        function clearGoalFields() {
            projectGoal = '';
            const goalEl = document.getElementById('goal-input');
            if (goalEl) goalEl.value = '';
        }

        function showGoalPromptModal() {
            if (mainTab !== 'editor') return;
            const backdrop = document.getElementById('goal-prompt-modal-backdrop');
            const input = document.getElementById('goal-prompt-input');
            if (input) input.value = '';
            if (backdrop) backdrop.classList.add('open');
            if (input) input.focus();
        }

        function closeGoalPromptModal() {
            const backdrop = document.getElementById('goal-prompt-modal-backdrop');
            if (backdrop) backdrop.classList.remove('open');
            updateWorkflowUI();
        }

        function confirmGoalPromptModal() {
            const input = document.getElementById('goal-prompt-input');
            const text = (input && input.value.trim()) || '';
            if (!text || isPlaceholderGoal(text)) return;
            const goalEl = document.getElementById('goal-input');
            if (goalEl) goalEl.value = text;
            requireGoalPrompt = false;
            closeGoalPromptModal();
            setProjectGoal();
        }

        function promptForRequiredGoalOnEditor(opts) {
            const options = opts || {};
            if (!activeProjectRequiresGoal()) {
                requireGoalPrompt = false;
                return;
            }
            clearGoalFields();
            requireGoalPrompt = true;
            pendingGoalOptions = false;
            updateWorkflowUI();
            updatePromptBox();
            const openModal = () => showGoalPromptModal();
            if (mainTab !== 'editor') {
                closeGoalPromptModal();
                return;
            } else {
                openModal();
            }
        }

        function currentUserGoal() {
            if (requireGoalPrompt && !projectGoal) return '';
            if (projectGoal) return projectGoal;
            const goalEl = document.getElementById('goal-input');
            if (goalEl && goalEl.value.trim()) return goalEl.value.trim();
            if (activeProjectRequiresGoal()) return '';
            const fromLedger = ledgerGoalFromPolicy(intractPolicyData);
            if (fromLedger && !isPlaceholderGoal(fromLedger)) return fromLedger;
            const proj = activeProjectRecord();
            const subtitle = (proj && proj.subtitle) ? proj.subtitle : '';
            return subtitle && !isPlaceholderGoal(subtitle) ? subtitle : '';
        }

        function ledgerGoalFromPolicy(data) {
            const ledger = Array.isArray(data?.ledger) ? data.ledger : [];
            for (let i = ledger.length - 1; i >= 0; i--) {
                const entry = ledger[i];
                if (entry && entry.status === 'goal_defined' && entry.user_goal) {
                    return String(entry.user_goal).trim();
                }
            }
            return '';
        }

        function ledgerHasEffectiveUi(data) {
            const eff = data?.effective_ui || {};
            return Boolean((eff.keep || []).length || (eff.delete || []).length);
        }

        function syncGoalFromLedger(data) {
            if (requireGoalPrompt || activeProjectRequiresGoal()) return;
            if (projectGoal) return;
            const fromLedger = ledgerGoalFromPolicy(data);
            if (!fromLedger || isPlaceholderGoal(fromLedger)) return;
            projectGoal = fromLedger;
            const goalEl = document.getElementById('goal-input');
            if (goalEl && !goalEl.value.trim()) goalEl.value = fromLedger;
        }

        function hasIterationContext() {
            if (requireGoalPrompt && !projectGoal) {
                if (annotations.length > 0 || elementHints.length > 0) return true;
                return false;
            }
            if (projectGoal || elementHints.length > 0 || annotations.length > 0) return true;
            if (pendingGoalOptions) return true;
            if (currentUserGoal()) return true;
            if (ledgerHasEffectiveUi(intractPolicyData)) return true;
            if (ledgerGoalFromPolicy(intractPolicyData)) return true;
            return false;
        }

        function updateServerOfflineBanner(offline) {
            const banner = document.getElementById('server-offline-banner');
            if (!banner) return;
            if (!offline) {
                banner.hidden = true;
                return;
            }
            const port = location.port || (location.protocol === 'https:' ? '443' : '80');
            banner.hidden = false;
            banner.innerHTML =
                'Editor server unreachable at <strong>' + location.hostname + ':' + port + '</strong>. '
                + 'This tab may use a stale port — run <code>make cinema-stop && make cinema</code> '
                + 'and open the new URL from the terminal, then reload.';
        }

        function focusScopeRecord() {
            const visible = visibleScopeOptions();
            return visible.find(opt => opt.id === currentFocusScope) || visible[0] || allScopeOptions[0];
        }

        function renderScopeOptions() {
            const chips = document.getElementById('scope-options-chips');
            const activeLabel = document.getElementById('scope-active-label');
            const help = document.getElementById('scope-options-help');
            const active = focusScopeRecord();
            if (activeLabel) activeLabel.textContent = active.label;
            if (help) help.textContent = active.help;
            if (!chips) return;
            chips.innerHTML = '';
            visibleScopeOptions().forEach(opt => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'scope-chip' + (opt.id === currentFocusScope ? ' active' : '');
                btn.textContent = opt.label;
                btn.title = opt.help;
                btn.onclick = (event) => {
                    event.stopPropagation();
                    selectFocusScope(opt.id);
                };
                chips.appendChild(btn);
            });
        }

        function selectFocusScope(scopeId, opts) {
            const options = opts || {};
            if (!visibleScopeOptions().some(opt => opt.id === scopeId)) return;
            const changed = currentFocusScope !== scopeId;
            if (changed) {
                persistActiveScopeAnnotations();
            }
            currentFocusScope = scopeId;
            if (changed) {
                loadActiveScopeAnnotations(scopeId);
                lastTouchedElementIds = annotations.map(a => a.id).slice(-24);
                syncAllIframeVisuals(true);
            }
            if (changed && !options.quiet) {
                pendingGoalOptions = true;
            }
            renderScopeOptions();
            updateFeedbackList();
            updateElementHintButton();
            updatePromptBox();
            updateWorkflowUI();
            updatePlayerUrl();
            if ((!changed && !options.force) || options.quiet) return;
            const active = focusScopeRecord();
            addChatLog('system', `<strong>Scope contract:</strong> ${active.label} — Options A–C will focus on ${active.help.toLowerCase()}`);
            logEvent('SCOPE_CONTRACT', { scope: active.id, label: active.label });
            scheduleAutoIteration('scope');
        }

        function goalContractPayload() {
            const goalEl = document.getElementById('goal-input');
            let goalText = (goalEl && goalEl.value.trim()) || projectGoal || '';
            if (!goalText && !requireGoalPrompt && !activeProjectRequiresGoal()) {
                goalText = currentUserGoal();
            }
            if (isPlaceholderGoal(goalText)) goalText = '';
            const proj = activeProjectRecord();
            const projectContext = proj
                ? `${proj.title} (${proj.kind}/${proj.domain})`
                : String(activeProjectId || '');
            const scope = focusScopeRecord();
            return {
                goal: goalText,
                user_goal: goalText,
                current_stage: activeStage,
                focus_scope: scope.id,
                focus_scope_label: scope.label,
                current_state: `Current project slice: ${scope.label} for ${projectContext}`,
                expected_version: goalText,
                project_context: projectContext,
            };
        }

        function buildLegacyHintsPayload() {
            const out = [];
            const goal = projectGoal || currentUserGoal();
            if (goal) out.push(goal);
            elementHints.forEach(h => {
                const text = (h && h.text) ? String(h.text).trim() : '';
                if (text) out.push(text);
            });
            return out;
        }

        function recentMarkedElementIds() {
            const ids = [];
            const seen = new Set();
            [...lastTouchedElementIds].reverse().forEach(id => {
                if (id && !seen.has(id)) {
                    seen.add(id);
                    ids.push(id);
                }
            });
            annotations.forEach(a => {
                if (a.id && !seen.has(a.id)) {
                    seen.add(a.id);
                    ids.push(a.id);
                }
            });
            return ids;
        }

        function updateElementHintButton() {
            const btn = document.getElementById('btn-element-hint');
            const ids = recentMarkedElementIds();
            if (!btn) return;
            btn.disabled = ids.length === 0;
            btn.title = ids.length
                ? 'Applies to: ' + ids.join(', ')
                : 'Mark workspace elements first';
        }

        function updateProjectActiveBar() {
            const bar = document.getElementById('project-active-bar');
            const titleEl = document.getElementById('project-active-title');
            const metaEl = document.getElementById('project-active-meta');
            if (!bar) return;
            if (!activeProjectId) {
                bar.hidden = true;
                return;
            }
            const proj = activeProjectRecord();
            bar.hidden = false;
            if (titleEl) titleEl.textContent = proj ? proj.title : activeProjectId;
            if (metaEl) {
                if (proj && proj.imported) {
                    const source = proj.import_kind ? proj.import_kind.toUpperCase() : 'IMPORT';
                    const path = proj.path_hint ? ' · ' + proj.path_hint : '';
                    metaEl.textContent = source + path + ' · README.markpact.md ready · Stage S' + activeStage + ' — local Editor or Publish.';
                } else {
                    metaEl.textContent = (proj ? proj.subtitle + ' · ' : '') + 'Stage S' + activeStage + ' — open Editor or deploy to Services (Markpact).';
                }
            }
        }

        function loadServicesCatalog() {
            const grid = document.getElementById('services-grid');
            if (grid) grid.innerHTML = '<div class="services-empty">Loading services…</div>';
            return fetch('/services/catalog')
                .then(res => {
                    if (!res.ok) throw new Error('catalog HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    servicesCatalog = Array.isArray(data.services) ? data.services : [];
                    renderServicesGrid();
                })
                .catch(err => {
                    if (grid) {
                        grid.innerHTML = '<div class="services-empty">Could not load services: ' + err.message + '</div>';
                    }
                });
        }

        function renderServicesGrid() {
            const grid = document.getElementById('services-grid');
            if (!grid) return;
            if (!servicesCatalog.length) {
                grid.innerHTML = '<div class="services-empty">No deployed services yet. <strong>Projects</strong> → <strong>Editor</strong> → <strong>Publish</strong> (Markpact).</div>';
                return;
            }
            grid.innerHTML = servicesCatalog.map(s => {
                const running = s.status === 'running';
                const statusClass = running ? 'badge-status-running' : 'badge-status-stopped';
                const statusLabel = running ? 'running' : 'stopped';
                const url = s.url || ('http://127.0.0.1:' + (s.port || '') + '/');
                const sid = (s.id || '').replace(/'/g, "\\'");
                return `
                <article class="service-card" data-id="${s.id}">
                    <div class="service-card-top">
                        <div>
                            <h3 class="service-title">${s.title || s.id}</h3>
                            <p class="service-meta">${s.project_id || ''} · stage S${s.stage ?? 0} · port ${s.port || '—'}</p>
                        </div>
                        <div class="service-badges">
                            <span class="badge-publish">publish</span>
                            ${s.markpact ? '<span class="project-badge">markpact</span>' : ''}
                            <span class="project-badge ${statusClass}">${statusLabel}</span>
                        </div>
                    </div>
                    <div class="service-actions">
                        ${running
                            ? `<a class="btn-service btn-service-primary" href="${url}" target="_blank" rel="noopener">Open</a>
                               <button type="button" class="btn-service" onclick="stopPublishedService('${sid}')">Stop</button>`
                            : `<button type="button" class="btn-service btn-service-primary" onclick="startPublishedService('${sid}')">Start</button>`}
                        <button type="button" class="btn-service" onclick="switchMainTab('editor')">Editor</button>
                        <button type="button" class="btn-service" onclick="switchMainTab('projects')">Projects</button>
                    </div>
                </article>`;
            }).join('');
        }

        function publishCurrentProject() {
            if (!activeProjectId) {
                addChatLog('system', '❌ <strong>Select a project first.</strong>');
                return;
            }
            const proj = activeProjectRecord();
            const btnIds = ['publish-btn', 'publish-btn-editor'];
            const buttons = btnIds.map(id => document.getElementById(id)).filter(Boolean);
            buttons.forEach(b => { b.disabled = true; b.innerText = '⏳ Publishing…'; });
            fetch('/services/publish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    stage: activeStage,
                    project_id: activeProjectId,
                    project_title: proj ? proj.title : activeProjectId,
                    goal: currentUserGoal()
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                const svc = data.service || {};
                addChatLog('system', `🚀 <strong>Published:</strong> ${svc.title || svc.id} on <a href="${svc.url}" target="_blank">${svc.url}</a>`);
                logEvent('SERVICE_PUBLISH', svc.id || '');
                loadServicesCatalog();
                switchMainTab('services', { skipLog: true });
            })
            .catch(err => {
                addChatLog('system', '❌ <strong>Publish failed: ' + err.message + '</strong>');
            })
            .finally(() => {
                buttons.forEach(b => { b.disabled = false; b.innerText = '🚀 Publish'; });
            });
        }

        function startPublishedService(serviceId) {
            fetch('/services/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_id: serviceId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                loadServicesCatalog();
                logEvent('SERVICE_START', serviceId);
            })
            .catch(err => addChatLog('system', '❌ <strong>Start failed: ' + err.message + '</strong>'));
        }

        function stopPublishedService(serviceId) {
            fetch('/services/stop', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_id: serviceId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                loadServicesCatalog();
                logEvent('SERVICE_STOP', serviceId);
            })
            .catch(err => addChatLog('system', '❌ <strong>Stop failed: ' + err.message + '</strong>'));
        }

        function loadProjectsCatalog() {
            return fetch('/projects/catalog')
                .then(res => {
                    if (!res.ok) throw new Error('catalog HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    projectCatalog = Array.isArray(data.projects) ? data.projects : [];
                    projectFilters = data.filters || projectFilters;
                    recordProjectsCatalog(data);
                    renderFilterChips();
                    renderProjectsGrid();
                    updateProjectActiveBar();
                })
                .catch(err => {
                    recordProjectsAction('catalog_load_failed', null, {
                        method: 'GET',
                        requestUrl: '/projects/catalog',
                        error: err.message,
                    });
                    const grid = document.getElementById('projects-grid');
                    if (grid) {
                        grid.innerHTML = '<div class="projects-empty">Could not load projects: ' + err.message + '</div>';
                    }
                });
        }

        function setImportStatus(kind, message, isError) {
            const el = document.getElementById('import-' + kind + '-status');
            if (!el) return;
            el.textContent = message || '';
            el.classList.toggle('error', !!isError);
            el.classList.toggle('ok', !!message && !isError);
        }

        function setImportBusy(kind, busy) {
            const btn = document.getElementById('import-' + kind + '-btn');
            if (btn) btn.disabled = !!busy;
        }

        function handleImportResult(data, kind) {
            if (data.error) {
                setImportStatus(kind, data.error, true);
                addChatLog('system', '❌ <strong>Import failed:</strong> ' + data.error);
                return null;
            }
            const project = data.project || {};
            const markpactPath = project.markpact_path || '';
            const localPath = project.path_hint || (project.id ? 'imported_projects/' + project.id : '');
            let statusHtml = 'Zaimportowano: <strong>' + escapeHtml(project.title || project.id || 'project') + '</strong>';
            if (localPath) statusHtml += '<br>Lokalnie: <code>' + escapeHtml(localPath) + '</code>';
            if (markpactPath) statusHtml += '<br>Markpact: <code>' + escapeHtml(markpactPath.split('/').slice(-3).join('/')) + '</code>';
            statusHtml += '<br>Gotowe do edycji i publikacji.';
            const statusEl = document.getElementById('import-' + kind + '-status');
            if (statusEl) {
                statusEl.innerHTML = statusHtml;
                statusEl.classList.remove('error');
                statusEl.classList.add('ok');
            } else {
                setImportStatus(kind, 'Zaimportowano: ' + (project.title || project.id || 'project'), false);
            }
            activeProjectId = project.id || activeProjectId;
            loadProjectsCatalog().then(() => {
                if (project.id) {
                    const rec = projectCatalog.find(p => p.id === project.id) || project;
                    const httpImport = !!(rec.imported && rec.import_kind === 'http');
                    activateProject(project.id, {
                        skipEditorSwitch: !httpImport,
                        quiet: true,
                    });
                }
            });
            addChatLog('system', `📦 <strong>Imported:</strong> ${project.title || project.id} — Markpact migration ready. Use ⬇ Markpact or 🚀 Publish.`);
            logEvent('PROJECT_IMPORT', project.id || kind);
            updateProjectActiveBar();
            return data;
        }

        function importProjectZip() {
            const input = document.getElementById('import-zip-file');
            const file = input && input.files && input.files[0];
            if (!file) {
                setImportStatus('zip', 'Wybierz plik .zip', true);
                return;
            }
            setImportBusy('zip', true);
            setImportStatus('zip', 'Wysyłanie…', false);
            const form = new FormData();
            form.append('file', file, file.name);
            fetch('/projects/import/zip', { method: 'POST', body: form })
                .then(res => res.json())
                .then(data => handleImportResult(data, 'zip'))
                .catch(err => setImportStatus('zip', err.message, true))
                .finally(() => setImportBusy('zip', false));
        }

        function importProjectGit() {
            const url = (document.getElementById('import-git-url')?.value || '').trim();
            const branch = (document.getElementById('import-git-branch')?.value || '').trim();
            if (!url) {
                setImportStatus('git', 'Podaj URL repozytorium Git', true);
                return;
            }
            setImportBusy('git', true);
            setImportStatus('git', 'Klonowanie…', false);
            fetch('/projects/import/git', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: url, branch: branch || undefined })
            })
                .then(res => res.json())
                .then(data => handleImportResult(data, 'git'))
                .catch(err => setImportStatus('git', err.message, true))
                .finally(() => setImportBusy('git', false));
        }

        function importProjectHttp() {
            const url = (document.getElementById('import-http-url')?.value || '').trim();
            if (!url) {
                setImportStatus('http', 'Podaj adres HTTP(S)', true);
                return;
            }
            setImportBusy('http', true);
            setImportStatus('http', 'Pobieranie strony…', false);
            fetch('/projects/import/http', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: url })
            })
                .then(res => res.json())
                .then(data => handleImportResult(data, 'http'))
                .catch(err => setImportStatus('http', err.message, true))
                .finally(() => setImportBusy('http', false));
        }

        function renderFilterChips() {
            const domainHost = document.getElementById('domain-filters');
            const kindHost = document.getElementById('kind-filters');
            if (!domainHost || !kindHost) return;
            const mk = (label, value, group) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'filter-chip' + ((group === 'domain' ? selectedDomainFilter : selectedKindFilter) === value ? ' active' : '');
                btn.textContent = label;
                btn.onclick = () => {
                    if (group === 'domain') selectedDomainFilter = value;
                    else selectedKindFilter = value;
                    renderFilterChips();
                    renderProjectsGrid();
                };
                return btn;
            };
            domainHost.innerHTML = '';
            domainHost.appendChild(mk('All domains', 'all', 'domain'));
            (projectFilters.domains || []).forEach(d => domainHost.appendChild(mk(d, d, 'domain')));
            kindHost.innerHTML = '';
            kindHost.appendChild(mk('All kinds', 'all', 'kind'));
            (projectFilters.kinds || []).forEach(k => kindHost.appendChild(mk(k, k, 'kind')));
        }

        function projectMatchesFilters(project) {
            const q = (document.getElementById('projects-search')?.value || '').trim().toLowerCase();
            if (selectedDomainFilter !== 'all' && project.domain !== selectedDomainFilter) return false;
            if (selectedKindFilter !== 'all' && project.kind !== selectedKindFilter) return false;
            if (!q) return true;
            const hay = [project.title, project.subtitle, project.domain, project.kind, ...(project.tags || [])].join(' ').toLowerCase();
            return hay.includes(q);
        }

        function formatProjectSize(bytes) {
            const n = Number(bytes || 0);
            if (!n) return '—';
            return formatBytes(n);
        }

        function renderImportedProjectMeta(project) {
            if (!project.imported) return '';
            const url = project.source_url || '';
            const files = project.file_count != null ? project.file_count : '—';
            const size = formatProjectSize(project.total_bytes);
            const pathHint = project.path_hint || '';
            const markpact = project.markpact_path ? project.markpact_path.split('/').slice(-2).join('/') : '';
            let html = '<div class="project-meta">';
            if (url) {
                html += `<div><strong>URL:</strong> <span class="project-meta-url">${escapeHtml(url)}</span></div>`;
            }
            html += `<div><strong>Pliki:</strong> ${escapeHtml(String(files))} · <strong>Rozmiar:</strong> ${escapeHtml(size)}</div>`;
            if (pathHint) {
                html += `<div><strong>Ścieżka:</strong> ${escapeHtml(pathHint)}</div>`;
            }
            if (markpact) {
                html += `<div><strong>Markpact:</strong> ${escapeHtml(markpact)}</div>`;
            }
            const cssKb = project.visual_css_bytes != null ? Math.max(1, Math.round(Number(project.visual_css_bytes) / 1024)) : null;
            const outlineNodes = project.outline_node_count != null ? project.outline_node_count : null;
            if (cssKb != null || outlineNodes != null) {
                const cssLabel = cssKb != null ? `CSS wizualny: ${cssKb} KB` : '';
                const outlineLabel = outlineNodes != null ? `szkielet: ${outlineNodes} węzłów` : '';
                const sep = cssLabel && outlineLabel ? ', ' : '';
                html += `<div><strong>LLM:</strong> ${escapeHtml(cssLabel + sep + outlineLabel)}</div>`;
            }
            html += '</div>';
            return html;
        }

        function renderImportedProjectActions(project) {
            if (!project.deletable) return '';
            const idJson = JSON.stringify(project.id);
            const importedButtons = project.imported ? `
                    <button type="button" class="btn-project-action" onclick='event.stopPropagation(); previewImportedMarkpact(${idJson})'>Kontrakt</button>
                    <button type="button" class="btn-project-action" onclick='event.stopPropagation(); openProjectLlmHistory(${idJson})'>Historia LLM</button>
            ` : '';
            return `
                <div class="project-card-actions">
                    <button type="button" class="btn-project-action" onclick='event.stopPropagation(); activateProject(${idJson})'>Editor</button>
                    <button type="button" class="btn-project-action" onclick='event.stopPropagation(); publishImportedProject(${idJson})'>Publish</button>
                    ${importedButtons}
                    <button type="button" class="btn-project-action danger" onclick='event.stopPropagation(); deleteProject(${idJson})'>Usuń</button>
                </div>
            `;
        }

