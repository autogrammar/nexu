        /* Left main panel style */
        .active-panel {
            flex: 1;
            border: 2px solid var(--nexu-accent);
            box-shadow: 0 0 20px var(--nexu-accent-glow);
            cursor: default;
        }
        
        /* Middle panel stacked dynamic expansion */
        .option-panel {
            flex: 1;
            height: 0;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .option-panel:hover {
            flex: 2; /* dynamically grow while other panels shrink */
            border-color: var(--nexu-policy);
            box-shadow: 0 0 15px var(--nexu-policy-soft);
        }
        
        .panel-header {
            background: var(--nexu-bg-elevated);
            padding: 8px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--nexu-text-secondary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--nexu-border-subtle);
            z-index: 200;
            gap: 8px;
        }
        .panel-header span:first-child {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .panel-body {
            flex: 1;
            position: relative;
            overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            transform-origin: center center;
        }
        
        .option-panel:hover .panel-body {
            transform: scale(1.08);
        }

        /* Option A/B/C: full-width miniature preview at 30% scale */
        .option-panel .panel-body {
            transform-origin: top center;
        }
        .option-panel iframe {
            width: calc(100% / 0.3);
            height: calc(100% / 0.3);
            transform: scale(0.3);
            transform-origin: top left;
            pointer-events: none;
