    <div id="services-shell" class="services-shell" hidden>
        <div class="services-toolbar">
            <p style="margin:0; flex:1; color:#94a3b8; font-size:0.85rem;">Services deployed from the Editor (Markpact). Start/stop local HTTP on ports 9200–9298.</p>
