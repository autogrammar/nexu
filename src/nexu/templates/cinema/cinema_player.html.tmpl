            border-color: var(--nexu-warning);
            background: var(--nexu-warning-soft);
            color: var(--nexu-warning-text);
        }
        .scope-options-help {
            color: var(--nexu-text-muted);
            font-size: 0.7rem;
            line-height: 1.35;
