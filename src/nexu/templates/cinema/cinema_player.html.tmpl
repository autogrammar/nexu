        :root {
            --nexu-radius-sm: 6px;
            --nexu-radius-md: 8px;
            --nexu-radius-lg: 12px;
            --nexu-control-height: 34px;
        }
        * {
            box-sizing: border-box;
            scrollbar-color: var(--nexu-scrollbar-thumb) var(--nexu-bg-base);
        }
        *::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        *::-webkit-scrollbar-thumb {
            background: var(--nexu-scrollbar-thumb);
            border-radius: 4px;
        }
        body {
            margin: 0;
            background: var(--nexu-bg-base);
            color: var(--nexu-text);
            font-family: 'Outfit', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .header {
            background: var(--nexu-bg-muted);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--nexu-border);
            padding: 12px 30px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            z-index: 10;
            flex-shrink: 0;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            min-width: 0;
            position: relative;
            z-index: 2;
        }
        .header h1 {
            margin: 0;
            font-size: 1.4rem;
            color: var(--nexu-accent);
            font-weight: 600;
            white-space: nowrap;
        }
        .header-tabs {
            display: flex;
            gap: 4px;
            background: var(--nexu-bg-elevated);
            border: 1px solid var(--nexu-border);
            border-radius: 8px;
            padding: 3px;
        }
        .header-tab {
            padding: 6px 14px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: var(--nexu-text-secondary);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .header-tab:hover:not(:disabled) { color: var(--nexu-text); background: var(--nexu-hover-surface); }
        .header-tab.active { background: var(--nexu-accent); color: var(--nexu-accent-contrast); }
        .header-theme {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            margin-left: auto;
        }
        .theme-picker-label {
            font-size: 0.72rem;
            color: var(--nexu-text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 600;
            white-space: nowrap;
        }
        .theme-chips {
            display: flex;
            gap: 4px;
        }
        .theme-chip {
            padding: 6px 12px;
            font-size: 0.75rem;
            min-height: var(--nexu-control-height);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .header-theme .filter-chips {
            align-items: center;
        }
        .header-tab:disabled { opacity: 0.35; cursor: not-allowed; }
        .projects-shell {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 24px 30px 32px;
            background: var(--nexu-surface-gradient), var(--nexu-bg-surface);
        }
        .projects-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .projects-search {
            flex: 1;
            min-width: 220px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid var(--nexu-border-strong);
            background: var(--nexu-bg-elevated);
            color: var(--nexu-text);
            font-family: inherit;
            font-size: 0.9rem;
        }
        .filter-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .filter-chip {
            padding: 6px 12px;
            min-height: var(--nexu-control-height);
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            border: 1px solid var(--nexu-border-strong);
            background: var(--nexu-bg-card);
            color: var(--nexu-text-body);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }
        .filter-chip.active {
            background: var(--nexu-accent-soft);
            border-color: var(--nexu-accent);
            color: var(--nexu-accent);
        }
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }
        @media (max-width: 1100px) {
            .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .project-card {
            background: var(--nexu-bg-card);
            border: 1px solid var(--nexu-border);
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: 140px;
        }
        .project-card:hover {
            transform: translateY(-2px);
            border-color: var(--nexu-accent-border);
            box-shadow: var(--nexu-shadow-card);
        }
        .project-card.selected {
            border-color: var(--nexu-accent);
            box-shadow: 0 0 0 1px var(--nexu-accent);
        }
        .project-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
        }
        .project-emoji { font-size: 1.6rem; line-height: 1; }
        .project-badges { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
        .project-badge {
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: var(--nexu-bg-elevated);
            color: var(--nexu-text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .project-title { font-size: 1rem; font-weight: 600; color: var(--nexu-text-title); margin: 0; }
        .project-subtitle { font-size: 0.82rem; color: var(--nexu-text-secondary); margin: 0; line-height: 1.4; flex: 1; }
        .project-meta {
            display: grid;
            gap: 4px;
            font-size: 0.72rem;
            color: var(--nexu-text-secondary);
            line-height: 1.35;
            word-break: break-word;
        }
        .project-meta strong { color: var(--nexu-text-body); font-weight: 600; }
        .project-meta-url { color: var(--nexu-link); }
        .project-card-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 4px;
        }
        .project-card-actions .btn-project-action {
            font-size: 0.68rem;
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid var(--nexu-border-strong);
            background: var(--nexu-bg-elevated);
            color: var(--nexu-text-body);
            cursor: pointer;
        }
        .project-card-actions .btn-project-action:hover {
            border-color: var(--nexu-accent);
            color: var(--nexu-text);
        }
        .project-card-actions .btn-project-action.danger {
            border-color: var(--nexu-danger-border);
            color: var(--nexu-danger-text);
        }
        .project-card-actions .btn-project-action.danger:hover {
            border-color: var(--nexu-danger);
            color: var(--nexu-danger-text);
        }
        .markpact-modal-backdrop {
            position: fixed;
            inset: 0;
            background: var(--nexu-overlay);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 12000;
            padding: 24px;
        }
        .markpact-modal-backdrop.open { display: flex; }
        .markpact-modal {
            width: min(920px, 100%);
            max-height: min(80vh, 900px);
            overflow: auto;
            background: var(--nexu-code-bg);
            border: 1px solid var(--nexu-border-strong);
            border-radius: 12px;
            padding: 18px 20px;
        }
        .markpact-modal header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        .markpact-modal header h3 { margin: 0; color: var(--nexu-text-title); }
        .markpact-modal-md {
            color: var(--nexu-text-body);
            font-size: 0.85rem;
            line-height: 1.5;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .goal-prompt-modal textarea {
            width: 100%;
            min-height: 110px;
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid var(--nexu-border-strong);
            background: var(--nexu-bg-elevated);
            color: var(--nexu-text-title);
            font-family: inherit;
            font-size: 0.9rem;
            resize: vertical;
        }
        .goal-prompt-modal .goal-prompt-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 14px;
        }
        .goal-prompt-modal p {
            margin: 0;
            color: var(--nexu-text-secondary);
            font-size: 0.85rem;
            line-height: 1.45;
        }
        .projects-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: var(--nexu-text-muted);
            padding: 48px 16px;
        }
        .projects-import {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 22px;
        }
        @media (max-width: 1100px) {
            .projects-import { grid-template-columns: 1fr; }
        }
        .import-card {
            background: var(--nexu-bg-elevated);
            border: 1px solid var(--nexu-border);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .import-card h3 {
            margin: 0;
            font-size: 0.95rem;
            color: var(--nexu-text);
        }
        .import-card p {
            margin: 0;
            color: var(--nexu-text-secondary);
            font-size: 0.78rem;
            line-height: 1.45;
        }
        .import-card input[type="url"],
        .import-card input[type="text"] {
            width: 100%;
            padding: 9px 11px;
            border-radius: 8px;
            border: 1px solid var(--nexu-border-strong);
            background: var(--nexu-input-bg);
            color: var(--nexu-text);
            font-family: inherit;
            font-size: 0.82rem;
        }
        .import-card input[type="file"] {
            font-size: 0.78rem;
            color: var(--nexu-text-body);
        }
        .import-actions {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }
        .btn-import {
            padding: 8px 12px;
            border-radius: 8px;
            border: 0;
            background: var(--nexu-accent);
            color: var(--nexu-accent-contrast);
            font-weight: 700;
            font-size: 0.78rem;
            cursor: pointer;
        }
        .btn-import:disabled { opacity: 0.45; cursor: not-allowed; }
        .import-status {
            min-height: 1.1rem;
            font-size: 0.75rem;
            color: var(--nexu-text-secondary);
        }
        .import-status.error { color: var(--nexu-danger); }
        .import-status.ok { color: var(--nexu-success); }
        .import-status code {
            color: var(--nexu-link);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            word-break: break-all;
        }
        .projects-workflow {
            display: grid;
            grid-column: 1 / -1;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 14px;
        }
        .projects-workflow-step {
            border: 1px solid var(--nexu-accent-border);
            border-radius: 8px;
            padding: 9px 10px;
            background: var(--nexu-accent-glow);
            color: var(--nexu-text-body);
            font-size: 0.74rem;
            line-height: 1.35;
        }
        .projects-workflow-step strong {
