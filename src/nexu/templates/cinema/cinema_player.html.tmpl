            border-left: 3px solid var(--nexu-accent);
            align-self: flex-start;
        }
        .chat-msg.system {
            background: var(--nexu-success-soft);
            color: var(--nexu-success);
            border-left: 3px solid var(--nexu-success);
            align-self: flex-start;
        }
        .chat-msg.goal {
            background: var(--nexu-warning-soft);
            color: var(--nexu-warning);
            border-left: 3px solid var(--nexu-warning);
            align-self: flex-start;
        }
