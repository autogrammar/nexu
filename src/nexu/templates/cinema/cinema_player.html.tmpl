        .policy-ledger-entry.evolved { border-left-color: var(--nexu-success); }
        
        /* Left Column: Active Workspace (Window 1) */
        .active-column {
            display: flex;
            flex-direction: column;
            padding: 15px;
            overflow: hidden;
            min-width: 0;
        }
        
        /* Middle Column: Stacked Options A, B, C (Windows 2-4) */
        .options-column {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 15px;
            border-left: 1px solid var(--nexu-border);
            border-right: 1px solid var(--nexu-border);
            background: var(--nexu-options-column-bg);
            overflow: hidden;
            min-width: 0;
        }

        .scope-options-bar {
            flex: 0 0 auto;
            border: 1px solid var(--nexu-accent-border);
            background: var(--nexu-bg-elevated);
