        .btn-service-primary { background: var(--nexu-primary-btn); color: var(--nexu-accent-contrast); border-color: transparent; }
        .btn-service-primary:hover { background: var(--nexu-accent); color: var(--nexu-accent-contrast); }
        .services-empty {
