        function applyLedgerToManifest(dryRun, target) {
            const btn = document.getElementById('btn-apply-manifest');
            if (btn) btn.disabled = true;
            const tgt = target || 'both';
            addChatLog('system', dryRun
                ? `📋 <strong>Dry-run: ledger → ${tgt} manifest(s)…</strong>`
                : `⬆ <strong>Applying ledger to ${tgt} intract.yaml…</strong>`);
            fetch('/manifest/apply-ledger', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ dry_run: dryRun, target: tgt })
            })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Manifest apply failed: ' + data.error + '</strong>');
                    return;
                }
                const results = data.results || [data];
                const addedTotal = data.added_total != null
                    ? data.added_total
                    : results.reduce((n, r) => n + ((r.added || []).length), 0);
                addChatLog('system', `✅ <strong>Manifest ${dryRun ? 'dry-run' : 'updated'} (${tgt}): +${addedTotal} contract(s)</strong>`);
                results.forEach(r => {
                    const label = r.target || tgt;
                    (r.added || []).forEach(id => addChatLog('system', `↳ [${label}] added: ${id}`));
                    if (r.skipped && r.skipped.length) {
                        addChatLog('system', `↳ [${label}] skipped ${r.skipped.length}`);
                    }
                });
                refreshIntractPolicy();
                logEvent('MANIFEST_APPLY', `dry_run=${dryRun} target=${tgt} added=${addedTotal}`);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>Manifest apply error: ' + err.message + '</strong>');
            });
        }

        function verifyCapsuleWorkspace() {
            const btn = document.getElementById('btn-verify-capsule');
            if (btn) btn.disabled = true;
            addChatLog('system', '✓ <strong>Running nexu capsule verify…</strong>');
            fetch('/capsule/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Verify failed: ' + data.error + '</strong>');
                    return;
                }
                addChatLog('system', `✓ <strong>Capsule verify: ${data.status} (score ${data.score})</strong>`);
                (data.findings || []).slice(0, 5).forEach(f => {
                    addChatLog('system', `↳ ${f.status || ''}: ${f.message || f.code || ''}`);
                });
                logEvent('CAPSULE_VERIFY', `status=${data.status} score=${data.score}`);
            })
