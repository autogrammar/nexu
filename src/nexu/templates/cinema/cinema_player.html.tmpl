        function publishCurrentProject() {
            if (!activeProjectId) {
                addChatLog('system', '❌ <strong>Select a project first.</strong>');
                return;
            }
            const proj = activeProjectRecord();
            const btnIds = ['publish-btn', 'publish-btn-editor'];
            const buttons = btnIds.map(id => document.getElementById(id)).filter(Boolean);
            buttons.forEach(b => { b.disabled = true; b.innerText = '⏳ Publishing…'; });
            fetch('/services/publish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    stage: activeStage,
                    project_id: activeProjectId,
                    project_title: proj ? proj.title : activeProjectId,
                    goal: currentUserGoal()
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) throw new Error(data.error);
                const svc = data.service || {};
                addChatLog('system', `🚀 <strong>Published:</strong> ${svc.title || svc.id} on <a href="${svc.url}" target="_blank">${svc.url}</a>`);
                logEvent('SERVICE_PUBLISH', svc.id || '');
                loadServicesCatalog();
                switchMainTab('services', { skipLog: true });
            })
            .catch(err => {
                addChatLog('system', '❌ <strong>Publish failed: ' + err.message + '</strong>');
            })
            .finally(() => {
                buttons.forEach(b => { b.disabled = false; b.innerText = '🚀 Publish'; });
            });
