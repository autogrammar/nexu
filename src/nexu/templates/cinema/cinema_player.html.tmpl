            <div class="project-active-actions">
                <button type="button" class="btn btn-service btn-service-primary" onclick="switchMainTab('editor')" title="Edit workspace, options, and policy">Open editor →</button>
                <button type="button" class="btn btn-markpact" id="markpact-btn" onclick="downloadMarkpactExport()" title="Download Markpact README for current stage">⬇ Markpact</button>
                <button type="button" class="btn btn-publish" id="publish-btn" onclick="publishCurrentProject()" title="Deploy stage via Markpact to Services">🚀 Publish</button>
