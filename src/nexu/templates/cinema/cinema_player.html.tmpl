            llmProjectFilter = projectId;
            selectedLlmTraceId = '';
            switchMainTab('llm');
            loadLlmTraces(projectId);
        }

        function deleteImportedProject(projectId) {
            return deleteProject(projectId);
        }

        function deleteProject(projectId) {
            const project = projectCatalog.find(p => p.id === projectId);
            const label = (project && project.title) ? project.title : projectId;
            const requestUrl = '/projects/delete';
            sessionDiagnostics.delete_flow = {
                phase: 'clicked',
                project_id: projectId,
                deletable_from_catalog: !!(project && project.deletable),
                catalog_entry: snapshotCatalogEntry(projectId),
                timestamp: new Date().toISOString(),
            };
            recordProjectsAction('delete_click', projectId, {
                method: 'UI',
                requestUrl: requestUrl,
            });
            if (!confirm('Usunąć projekt „' + label + '” z tego workspace?')) {
                sessionDiagnostics.delete_flow.phase = 'cancelled';
                recordProjectsAction('delete_cancelled', projectId, { method: 'UI', requestUrl: requestUrl });
                return;
            }
            sessionDiagnostics.delete_flow.phase = 'confirmed';
            recordProjectsAction('delete_confirmed', projectId, {
                method: 'POST',
                requestUrl: requestUrl,
            });
            fetch(requestUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: projectId })
            })
                .then(async res => {
                    const text = await res.text();
                    let data = {};
                    try {
                        data = JSON.parse(text);
                    } catch (_) {
                        data = { raw: text.slice(0, 500) };
                    }
                    recordProjectsAction('delete_response', projectId, {
                        method: 'POST',
                        requestUrl: requestUrl,
                        status: res.status,
                        responseBody: JSON.stringify(data),
                        error: data.error || (!res.ok ? ('HTTP ' + res.status) : null),
                    });
                    sessionDiagnostics.delete_flow.phase =
                        res.ok && !data.error ? 'success' : 'failed';
                    if (data.error) throw new Error(data.error);
                    if (!res.ok) {
                        throw new Error('HTTP ' + res.status);
                    }
                    if (activeProjectId === projectId) {
                        activeProjectId = data.activated || '';
                        llmProjectFilter = '';
                    }
                    addChatLog('system', '🗑️ <strong>Usunięto projekt:</strong> ' + label);
                    return loadProjectsCatalog();
                })
                .catch(err => {
                    if (sessionDiagnostics.delete_flow) {
                        sessionDiagnostics.delete_flow.phase = 'error';
                        sessionDiagnostics.delete_flow.error = err.message;
                    }
                    recordProjectsAction('delete_error', projectId, {
                        method: 'DELETE',
                        requestUrl: requestUrl,
                        error: err.message,
                    });
                    addChatLog('system', '❌ <strong>Usuwanie nie powiodło się:</strong> ' + err.message);
                });
        }

        function renderProjectsGrid() {
            const grid = document.getElementById('projects-grid');
            if (!grid) return;
            const visible = projectCatalog.filter(projectMatchesFilters);
            if (!visible.length) {
                grid.innerHTML = '<div class="projects-empty">No examples match your filters.</div>';
                return;
            }
            grid.innerHTML = visible.map(p => {
                const importKind = p.import_kind ? `<span class="project-badge">${escapeHtml(p.import_kind)}</span>` : '';
                const idJson = JSON.stringify(p.id);
                return `
                <article class="project-card${p.id === activeProjectId ? ' selected' : ''}" data-id="${escapeHtml(p.id)}" onclick='activateProject(${idJson})'>
                    <div class="project-card-top">
                        <span class="project-emoji">${p.emoji || '📦'}</span>
                        <div class="project-badges">
                            <span class="project-badge">${escapeHtml(p.domain)}</span>
                            <span class="project-badge">${escapeHtml(p.kind)}</span>
                            ${importKind}
                            ${p.markpact ? '<span class="project-badge">markpact</span>' : ''}
                            ${p.imported ? '<span class="project-badge">imported</span>' : ''}
                        </div>
                    </div>
                    <h3 class="project-title">${escapeHtml(p.title)}</h3>
                    <p class="project-subtitle">${escapeHtml(p.subtitle)}</p>
                    ${renderImportedProjectMeta(p)}
                    ${renderImportedProjectActions(p)}
                </article>
            `;
            }).join('');
        }

        function activateProject(projectId, opts) {
            const options = opts || {};
            const card = document.querySelector('.project-card[data-id="' + projectId + '"]');
            if (card) card.classList.add('selected');
            return fetch('/projects/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: projectId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    if (!options.quiet) {
                        addChatLog('system', '❌ <strong>Project load failed: ' + data.error + '</strong>');
                    }
                    return data;
                }
                activeProjectId = projectId;
                const scopeMeta = data.scope || {};
                const defScope = scopeMeta.default_focus_scope
                    || defaultScopeForKind((data.project && data.project.kind) || 'web');
                normalizeFocusScopeForActiveProject({ defaultScope: defScope, force: true });
                clearGoalFields();
                requireGoalPrompt = projectNeedsGoalPrompt(data);
                pendingGoalOptions = !requireGoalPrompt;
                workspaceEngaged = false;
                resetScopedAnnotations();
                elementHints = [];
                lastTouchedElementIds = [];
                updateFeedbackList();
                updateElementHintButton();
                document.getElementById('tab-editor').disabled = false;
                const goalEl = document.getElementById('goal-input');
                const subtitle = (data.project && data.project.subtitle) ? data.project.subtitle : '';
                if (!requireGoalPrompt) {
                    if (goalEl && !goalEl.value.trim() && subtitle && !isPlaceholderGoal(subtitle)) {
                        goalEl.value = subtitle;
                    }
                    if (subtitle && !isPlaceholderGoal(subtitle)) {
                        projectGoal = subtitle;
                    }
                }
                const boot = data.goal_bootstrap || {};
                const bootOpts = boot.options_written || [];
                if (boot.status === 'goal_options_seeded' && bootOpts.length) {
                    reloadCinemaFrames(Date.now());
                    pendingGoalOptions = false;
                    if (!options.quiet) {
                        addChatLog('system', `✨ <strong>Options ready (${bootOpts.join(', ')}).</strong> Pick A, B, or C — marks apply on the workspace.`);
                    }
                } else {
                    reloadCinemaFrames();
                }
                if (!options.skipEditorSwitch) {
                    switchMainTab('editor');
                }
                updateWorkflowUI();
                if (!options.quiet) {
                    addChatLog('system', `✏️ <strong>Editor:</strong> ${data.project.title} — refine the workspace, then publish to Services.`);
                }
                logEvent('PROJECT_ACTIVATE', projectId);
                renderProjectsGrid();
                updateProjectActiveBar();
                refreshIntractPolicy();
                if (requireGoalPrompt) {
                    if (!options.skipEditorSwitch) {
                        promptForRequiredGoalOnEditor({ quiet: options.quiet });
                    }
                } else if (boot.status !== 'goal_options_seeded') {
                    scheduleAutoIteration('project_activate');
                }
                return data;
            })
            .catch(err => {
                if (!options.quiet) {
                    addChatLog('system', '❌ <strong>Project activate error: ' + err.message + '</strong>');
                }
                throw err;
            });
        }

        function pingCinemaServer(silent) {
            return fetch('/health', { method: 'GET' })
                .then(res => {
                    if (!res.ok) throw new Error('health ' + res.status);
                    cinemaServerOnline = true;
                    updateServerOfflineBanner(false);
                    flushPendingLogEvents();
                    return res.json();
                })
                .then(data => {
                    sessionDiagnostics.cinema_runtime = {
                        cinema_root: data.cinema_root || null,
                        capsule: data.capsule || data.cinema || null,
                        workspace_root: data.workspace_root || null,
                        cinema_player_mtime: data.cinema_player_mtime || null,
                        template_synced_hint: data.template_synced_hint || null,
                    };
                    return data;
                })
                .catch(() => {
                    cinemaServerOnline = false;
                    updateServerOfflineBanner(true);
                    if (!silent) {
                        addChatLog('system', '⚠️ <strong>Editor server offline.</strong> In terminal: <code>make cinema-stop && make cinema</code>, then open the new URL from the log.');
                    }
                    throw new Error('server offline');
                });
        }

        function refreshHistory() {
            fetch('/history')
                .then(res => {
                    if (!res.ok) throw new Error('history HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    historyCheckpoints = Array.isArray(data.checkpoints) ? data.checkpoints : [];
                    ledgerArchive = Array.isArray(data.ledger_archive) ? data.ledger_archive : [];
                    renderHistoryPanel();
                })
                .catch(err => {
                    const body = document.getElementById('history-panel-body');
                    const meta = document.getElementById('history-meta');
                    if (body) body.textContent = 'Could not load history: ' + err.message;
                    if (meta) meta.textContent = 'offline';
                });
        }

        function renderHistoryPanel() {
            const body = document.getElementById('history-panel-body');
            const meta = document.getElementById('history-meta');
            if (!body) return;
            let html = '';
            if (!historyCheckpoints.length && !ledgerArchive.length) {
                body.innerHTML = '<span class="policy-status-miss">No checkpoints yet — run an iteration or promote an option.</span>';
                if (meta) meta.textContent = '0 checkpoints';
                return;
            }
            html += '<div class="policy-section-title">Restorable checkpoints</div>';
            if (!historyCheckpoints.length) {
                html += '<span class="policy-status-miss">(none yet)</span><br>';
            }
            historyCheckpoints.forEach(cp => {
                const sel = cp.id === selectedHistoryId ? ' selected' : '';
                const ts = (cp.timestamp || '').replace('T', ' ').slice(0, 19);
                html += `<div class="history-entry${sel}" data-id="${cp.id}" onclick="selectHistoryEntry('${cp.id}')">`;
                html += `<div class="history-entry-label">${cp.label || cp.id}</div>`;
                html += `<div class="history-entry-meta">${ts} · ledger ${cp.ledger_length || 0} · ${cp.action || ''}</div>`;
                html += `<button type="button" class="btn-restore" onclick="event.stopPropagation(); restoreHistoryCheckpoint('${cp.id}')">↩ Restore UI + policy</button>`;
                html += '</div>';
            });
            if (ledgerArchive.length) {
                html += '<div class="policy-section-title">Ledger archive (no HTML snapshot)</div>';
                ledgerArchive.slice(0, 12).forEach(entry => {
                    const ts = (entry.timestamp || '').replace('T', ' ').slice(0, 19);
                    html += '<div class="history-entry" style="border-left-color:var(--nexu-text-muted);opacity:0.85;">';
                    html += `<div class="history-entry-label">${entry.label || entry.id}</div>`;
                    html += `<div class="history-entry-meta">${ts} · read-only</div>`;
                    html += '</div>';
                });
                if (ledgerArchive.length > 12) {
                    html += `<div class="history-entry-meta">… +${ledgerArchive.length - 12} older ledger entries</div>`;
                }
            }
            body.innerHTML = html;
            if (meta) {
                meta.textContent = `${historyCheckpoints.length} restore · ${ledgerArchive.length} archive`;
            }
        }

        function selectHistoryEntry(id) {
            selectedHistoryId = id;
            renderHistoryPanel();
            const cp = historyCheckpoints.find(c => c.id === id);
            if (cp) {
                addChatLog('system', `🕐 <strong>Selected:</strong> ${cp.label || id}`);
            }
        }

        function reloadCinemaFrames(stamp) {
            const t = stamp != null ? stamp : Date.now();
            const calc = calcEnabledForProject();
            const ws = {
                role: 'workspace',
                active: true,
                mark: 1,
                calc: calc,
                review: elementReviewMode ? 1 : 0,
                stage: activeStage,
                t: t
            };
            document.getElementById('active-frame').src = frameUrl('stage' + activeStage + '.html', ws);
            document.getElementById('alt-a-frame').src = frameUrl('alt_a.html', { role: 'option', pane: 'a', mark: 0, calc: calc, review: 0, t: t });
            document.getElementById('alt-b-frame').src = frameUrl('alt_b.html', { role: 'option', pane: 'b', mark: 0, calc: calc, review: 0, t: t });
            document.getElementById('alt-c-frame').src = frameUrl('alt_c.html', { role: 'option', pane: 'c', mark: 0, calc: calc, review: 0, t: t });
            logEvent('FRAMES_RELOAD', ws);
            updatePlayerUrl();
            lastIframeSyncKey = '';
            setTimeout(() => syncAllIframeVisuals(true), 120);
        }

        function restoreHistoryCheckpoint(checkpointId) {
            const btn = document.querySelector(`.history-entry[data-id="${checkpointId}"] .btn-restore`);
            if (btn) btn.disabled = true;
            addChatLog('system', `↩ <strong>Restoring checkpoint ${checkpointId}…</strong> (UI + ledger + manifest)`);
            fetch('/history/restore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    checkpoint_id: checkpointId,
                    apply_manifest: true,
                    target: 'both'
                })
            })
            .then(res => res.json())
            .then(data => {
                if (btn) btn.disabled = false;
                if (data.error) {
                    addChatLog('system', '❌ <strong>Restore failed: ' + data.error + '</strong>');
                    return;
                }
                selectedHistoryId = checkpointId;
                reloadCinemaFrames();
                refreshIntractPolicy();
                refreshHistory();
                const added = data.manifest && data.manifest.added_total != null
                    ? data.manifest.added_total
                    : 0;
                addChatLog('system', `✅ <strong>Restored:</strong> ${data.label || checkpointId}. Manifest +${added} contract(s).`);
                logEvent('HISTORY_RESTORE', checkpointId);
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                addChatLog('system', '❌ <strong>Restore error: ' + err.message + '</strong>');
            });
        }

        function refreshIntractPolicy() {
            const scopeQs = currentFocusScope
                ? '?focus_scope=' + encodeURIComponent(currentFocusScope)
                : '';
            fetch('/policy' + scopeQs)
                .then(res => {
                    if (!res.ok) throw new Error('policy HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    intractPolicyData = data;
                    syncGoalFromLedger(data);
                    renderIntractPolicy(data);
                    loadActiveScopeAnnotations(currentFocusScope, { preferLedger: true });
                    updateWorkflowUI();
                    updatePromptBox();
                })
                .catch(err => {
                    const body = document.getElementById('intract-policy-body');
                    const meta = document.getElementById('intract-policy-meta');
                    if (body) body.textContent = 'Could not load intract policy: ' + err.message;
                    if (meta) meta.textContent = 'offline';
                });
        }

        function renderIntractPolicy(data) {
            const body = document.getElementById('intract-policy-body');
            const meta = document.getElementById('intract-policy-meta');
            if (!body) return;

            const snap = data.snapshot || {};
            const ledger = Array.isArray(data.ledger) ? data.ledger : [];
            const project = snap.project || {};
            const capsule = snap.capsule || {};
            const baseline = snap.baseline_contracts || {};

            const yes = '<span class="policy-status-ok">yes</span>';
            const no = '<span class="policy-status-miss">no</span>';

            let html = '';
            html += '<div class="policy-section-title">Project</div>';
            html += `root: ${project.root || '—'}<br>`;
            html += `name: ${project.name || '—'} | nexu.yaml: ${project.has_nexu_yaml ? yes : no} | intract.yaml: ${project.has_intract_yaml ? yes : no} | .nexu/: ${project.has_nexu_dir ? yes : no}<br>`;
            if (project.intract_path) html += `manifest: ${project.intract_path}<br>`;

            html += '<div class="policy-section-title">Capsule</div>';
            html += `name: ${capsule.name || '—'} | exists: ${capsule.exists ? yes : no} | intract.yaml: ${capsule.has_intract_yaml ? yes : no}<br>`;
            if (capsule.path) html += `path: ${capsule.path}<br>`;
            if (capsule.intract_path) html += `manifest: ${capsule.intract_path}<br>`;

            const activeExample = snap.active_example_project || {};
            html += '<div class="policy-section-title">Active example (Cinema UI)</div>';
            if (activeExample.id) {
                html += `<span class="policy-status-ok">${activeExample.title || activeExample.id}</span> `;
                html += `(${activeExample.kind || '—'} / ${activeExample.domain || '—'})<br>`;
                if (activeExample.source) html += `source: ${activeExample.source}<br>`;
            } else {
                html += '<span class="policy-status-miss">(none — pick a project in the catalog)</span><br>';
            }

            const renderBaseline = (title, items) => {
                html += `<div class="policy-section-title">Baseline — ${title}</div>`;
                if (!items || !items.length) {
                    html += '<span class="policy-status-miss">(none — add contracts to intract.yaml)</span><br>';
                    return;
                }
                items.forEach(c => {
                    const line = c.line || `@intract.v1 id:${c.id} intent:${c.intent}`;
                    html += `<code class="policy-contract-line">${line}</code>`;
                });
            };
            renderBaseline('project', baseline.project);
            renderBaseline('capsule (frozen model)', baseline.capsule);

            const goalEntries = ledger.filter(e => e && e.status === 'goal_defined');
            const evolveEntries = ledger.filter(e => e && e.status !== 'goal_defined');

            html += '<div class="policy-section-title">Goal extensions (from project goal)</div>';
            if (!goalEntries.length) {
                html += '<span class="policy-status-miss">(none — set project goal to generate Intract extensions)</span><br>';
            } else {
                goalEntries.slice().reverse().forEach(entry => {
                    if (entry.user_goal) {
                        html += `<span class="policy-status-ok">goal:</span> ${entry.user_goal}<br>`;
                    }
                    (entry.proposed_contracts || []).forEach(p => {
                        const line = p.line || p.delta_text || `@intract.v1 id:${p.id || 'unknown'}`;
                        html += `<code class="policy-contract-line">${line}</code>`;
                    });
                });
            }

            html += '<div class="policy-section-title">UI deltas (marks / iterations)</div>';
            if (!evolveEntries.length) {
                html += '<span class="policy-status-miss">(none — mark elements or iterate)</span><br>';
            } else {
                evolveEntries.forEach(entry => {
                    (entry.proposed_contracts || []).forEach(p => {
                        const line = p.line || p.delta_text || `@intract.v1 id:${p.id || 'unknown'}`;
                        html += `<code class="policy-contract-line">${line}</code>`;
                    });
                });
            }

            body.innerHTML = html;
            if (meta) {
                const pCount = (baseline.project || []).length;
                const cCount = (baseline.capsule || []).length;
                meta.textContent = `baseline ${pCount}+${cCount} · goal ${goalEntries.length} · deltas ${evolveEntries.length}`;
            }
