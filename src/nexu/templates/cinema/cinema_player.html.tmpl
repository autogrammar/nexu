<!DOCTYPE html>
<html>
<head>
    <title>Nexu — Projects · Editor · Services</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            background: #05070c;
            color: #f1f5f9;
            font-family: 'Outfit', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .header {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 12px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            z-index: 10;
            flex-shrink: 0;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            min-width: 0;
        }
        .header h1 {
            margin: 0;
            font-size: 1.4rem;
            color: #38bdf8;
            font-weight: 600;
            white-space: nowrap;
        }
        .header-tabs {
            display: flex;
            gap: 4px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 3px;
        }
        .header-tab {
            padding: 6px 14px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: #94a3b8;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .header-tab:hover:not(:disabled) { color: #e2e8f0; background: rgba(255,255,255,0.05); }
        .header-tab.active { background: #38bdf8; color: #0f172a; }
        .header-tab:disabled { opacity: 0.35; cursor: not-allowed; }
        .projects-shell {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 24px 30px 32px;
            background: radial-gradient(ellipse at top, rgba(56, 189, 248, 0.08), transparent 55%), #090d16;
        }
        .projects-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .projects-search {
            flex: 1;
            min-width: 220px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(15, 23, 42, 0.9);
            color: #f1f5f9;
            font-family: inherit;
            font-size: 0.9rem;
        }
        .filter-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .filter-chip {
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(30, 41, 59, 0.8);
            color: #cbd5e1;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }
        .filter-chip.active {
            background: rgba(56, 189, 248, 0.2);
            border-color: #38bdf8;
            color: #7dd3fc;
        }
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }
        @media (max-width: 1100px) {
            .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .project-card {
            background: rgba(30, 41, 59, 0.65);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: 140px;
        }
        .project-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        }
        .project-card.selected {
            border-color: #38bdf8;
            box-shadow: 0 0 0 1px #38bdf8;
        }
        .project-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
        }
        .project-emoji { font-size: 1.6rem; line-height: 1; }
        .project-badges { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
        .project-badge {
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.9);
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .project-title { font-size: 1rem; font-weight: 600; color: #f8fafc; margin: 0; }
        .project-subtitle { font-size: 0.82rem; color: #94a3b8; margin: 0; line-height: 1.4; flex: 1; }
        .projects-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: #64748b;
            padding: 48px 16px;
        }
        .project-active-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(56, 189, 248, 0.35);
            background: rgba(15, 23, 42, 0.85);
        }
        .project-active-bar[hidden] { display: none !important; }
        .project-active-info { flex: 1; min-width: 200px; }
        .project-active-title { margin: 0; font-size: 1rem; color: #f8fafc; font-weight: 600; }
        .project-active-meta { margin: 4px 0 0; font-size: 0.8rem; color: #94a3b8; }
        .project-active-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
        .btn-publish {
            background: #22c55e;
            color: #052e16;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .btn-publish:hover { background: #4ade80; transform: scale(1.05); }
        .btn-publish:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
        .services-shell {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 24px 30px 32px;
            background: radial-gradient(ellipse at top, rgba(34, 197, 94, 0.06), transparent 55%), #090d16;
        }
        .services-shell[hidden] { display: none !important; }
        .llm-shell {
            flex: 1;
            min-height: 0;
            overflow: hidden;
            padding: 18px 22px 24px;
            background: #080c14;
            display: grid;
            grid-template-columns: minmax(260px, 28vw) 1fr;
            gap: 14px;
        }
        .llm-shell[hidden] { display: none !important; }
        .llm-trace-list {
            min-height: 0;
            overflow: auto;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.78);
        }
        .llm-trace-item {
            width: 100%;
            display: block;
            text-align: left;
            padding: 10px 12px;
            border: 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background: transparent;
            color: #dbeafe;
            cursor: pointer;
            font: inherit;
        }
        .llm-trace-item:hover,
        .llm-trace-item.active { background: rgba(56, 189, 248, 0.12); }
        .llm-trace-item strong {
            display: block;
            font-size: 0.78rem;
            color: #7dd3fc;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .llm-trace-item span {
            display: block;
            margin-top: 4px;
            color: #94a3b8;
            font-size: 0.68rem;
            line-height: 1.35;
        }
        .llm-trace-view {
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .llm-trace-toolbar {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .llm-trace-toolbar p {
            margin: 0;
            flex: 1;
            color: #94a3b8;
            font-size: 0.82rem;
        }
        .llm-trace-md {
            flex: 1;
            min-height: 0;
            overflow: auto;
            border: 1px solid rgba(56, 189, 248, 0.18);
            border-radius: 8px;
            padding: 14px 16px;
            background: #020617;
            color: #dbeafe;
            font-size: 0.82rem;
            line-height: 1.55;
        }
        .llm-trace-md h1, .llm-trace-md h2, .llm-trace-md h3 {
            color: #7dd3fc;
            margin: 0.8em 0 0.35em;
            font-size: 1rem;
        }
        .llm-trace-md h1 { font-size: 1.1rem; }
        .llm-trace-md p, .llm-trace-md ul { margin: 0.45em 0; color: #cbd5e1; }
        .llm-trace-md li { margin: 0.2em 0; }
        .llm-trace-md code {
            font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
            font-size: 0.76rem;
            background: rgba(15, 23, 42, 0.9);
            padding: 0.1em 0.35em;
            border-radius: 4px;
        }
        .llm-trace-md pre {
            margin: 0.55em 0;
            padding: 10px 12px;
            overflow: auto;
            border-radius: 6px;
            background: #0f172a;
            border: 1px solid rgba(255,255,255,0.08);
            white-space: pre-wrap;
            word-break: break-word;
            font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
            font-size: 0.74rem;
            line-height: 1.45;
        }
        .llm-trace-md pre code { background: transparent; padding: 0; }
        .services-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .services-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
        @media (max-width: 900px) {
            .services-grid { grid-template-columns: 1fr; }
        }
        .service-card {
            background: rgba(30, 41, 59, 0.65);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .service-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
        }
        .service-title { margin: 0; font-size: 1rem; font-weight: 600; color: #f8fafc; }
        .service-meta { font-size: 0.78rem; color: #94a3b8; margin: 0; line-height: 1.4; }
        .service-badges { display: flex; flex-wrap: wrap; gap: 6px; }
        .badge-publish {
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(34, 197, 94, 0.2);
            color: #86efac;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }
        .badge-status-running {
            background: rgba(34, 197, 94, 0.25);
            color: #4ade80;
        }
        .badge-status-stopped {
            background: rgba(148, 163, 184, 0.2);
            color: #94a3b8;
        }
        .service-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
        .btn-service {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(30, 41, 59, 0.9);
            color: #e2e8f0;
        }
        .btn-service:hover { border-color: #38bdf8; color: #7dd3fc; }
        .btn-service-primary { background: #0ea5e9; color: #0f172a; border-color: transparent; }
        .btn-service-primary:hover { background: #38bdf8; color: #0f172a; }
        .services-empty {
            grid-column: 1 / -1;
            text-align: center;
            color: #64748b;
            padding: 48px 16px;
        }
        .editor-app-shell {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .editor-app-shell[hidden],
        .projects-shell[hidden],
        .services-shell[hidden] { display: none !important; }
        .controls {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .llm-status-badge {
            max-width: 360px;
            padding: 7px 10px;
            border: 1px solid rgba(56, 189, 248, 0.28);
            border-radius: 6px;
            background: rgba(15, 23, 42, 0.72);
            color: #cbd5e1;
            font-size: 0.72rem;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .llm-status-badge.ready { border-color: rgba(46, 213, 115, 0.45); color: #86efac; }
        .llm-status-badge.warn { border-color: rgba(251, 191, 36, 0.45); color: #fbbf24; }
        .llm-status-badge.error { border-color: rgba(255, 71, 87, 0.5); color: #ff8a9a; }
        .btn {
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            font-size: 0.85rem;
        }
        .btn-stage { background: #334155; color: #fff; }
        .btn-stage.active { background: #38bdf8; color: #0f172a; }
        .btn-action { background: #2ed573; color: #fff; }
        .btn-action:disabled { background: #1e293b; color: #64748b; cursor: not-allowed; }
        
        .workspace-shell {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .main-container {
            display: grid;
            grid-template-columns: minmax(560px, 1fr) minmax(300px, 24vw) minmax(320px, 24vw);
            flex: 1;
            min-height: 0;
            overflow: hidden;
            background: #090d16;
        }
        .bottom-panels-row {
            flex: 0 0 18vh;
            min-height: 130px;
            max-height: 26vh;
            display: flex;
            border-top: 1px solid rgba(129, 140, 248, 0.35);
            background: rgba(2, 6, 23, 0.95);
            min-width: 0;
        }
        .history-panel,
        .intract-policy-panel {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .history-panel {
            border-right: 1px solid rgba(255,255,255,0.06);
        }
        .bottom-panel-header {
            flex: 0 0 auto;
            padding: 6px 12px;
            font-size: 0.72rem;
            font-weight: 600;
            color: #a5b4fc;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono', monospace;
        }
        .history-panel-body,
        .intract-policy-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 6px 10px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.66rem;
            line-height: 1.4;
            color: #cbd5e1;
        }
        .history-entry {
            padding: 6px 8px;
            margin-bottom: 6px;
            border-radius: 6px;
            background: rgba(56, 189, 248, 0.06);
            border-left: 3px solid #38bdf8;
            cursor: pointer;
        }
        .history-entry:hover { background: rgba(56, 189, 248, 0.12); }
        .history-entry.selected { border-left-color: #2ed573; background: rgba(46, 213, 115, 0.08); }
        .history-entry-label { color: #e2e8f0; font-weight: 600; font-size: 0.68rem; }
        .history-entry-meta { color: #64748b; font-size: 0.62rem; margin-top: 2px; }
        .btn-restore {
            margin-top: 4px;
            background: rgba(46, 213, 115, 0.2);
            color: #86efac;
            border: 1px solid rgba(46, 213, 115, 0.4);
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.62rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-restore:hover { background: rgba(46, 213, 115, 0.35); }
        .btn-restore:disabled { opacity: 0.45; cursor: not-allowed; }
        .intract-policy-panel {
            /* right column — contracts */
        }
        .intract-policy-header {
            flex: 0 0 auto;
            padding: 6px 16px;
            font-size: 0.72rem;
            font-weight: 600;
            color: #a5b4fc;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            font-family: 'JetBrains Mono', monospace;
        }
        .intract-policy-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .btn-policy {
            background: rgba(129, 140, 248, 0.2);
            color: #c7d2fe;
            border: 1px solid rgba(129, 140, 248, 0.35);
            border-radius: 4px;
            padding: 3px 8px;
            font-size: 0.62rem;
            font-weight: 600;
            cursor: pointer;
            text-transform: none;
            letter-spacing: 0;
        }
        .btn-policy:hover { background: rgba(129, 140, 248, 0.35); }
        .btn-policy:disabled { opacity: 0.5; cursor: not-allowed; }
        .intract-policy-meta {
            color: #64748b;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.68rem;
        }
        .policy-section-title {
            color: #818cf8;
            font-weight: 600;
            margin: 8px 0 4px;
        }
        .policy-section-title:first-child { margin-top: 0; }
        .policy-status-ok { color: #2ed573; }
        .policy-status-miss { color: #ff6b81; }
        .policy-contract-line {
            display: block;
            padding: 3px 0;
            border-bottom: 1px dashed rgba(255,255,255,0.04);
            word-break: break-word;
        }
        .policy-ledger-entry {
            margin-bottom: 8px;
            padding: 6px 8px;
            border-radius: 6px;
            background: rgba(129, 140, 248, 0.06);
            border-left: 3px solid #818cf8;
        }
        .policy-ledger-entry.skipped { border-left-color: #fbbf24; }
        .policy-ledger-entry.evolved { border-left-color: #2ed573; }
        
        /* Left Column: Active Workspace (Window 1) */
        .active-column {
            display: flex;
            flex-direction: column;
            padding: 15px;
            overflow: hidden;
            min-width: 0;
        }
        
        /* Middle Column: Stacked Options A, B, C (Windows 2-4) */
        .options-column {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 15px;
            border-left: 1px solid rgba(255,255,255,0.08);
            border-right: 1px solid rgba(255,255,255,0.08);
            background: rgba(2, 6, 23, 0.4);
            overflow: hidden;
            min-width: 0;
        }

        .scope-options-bar {
            flex: 0 0 auto;
            border: 1px solid rgba(56, 189, 248, 0.24);
            background: rgba(15, 23, 42, 0.82);
            border-radius: 10px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .scope-options-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            color: #94a3b8;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .scope-options-active {
            color: #38bdf8;
            font-size: 0.68rem;
            text-transform: none;
            letter-spacing: 0;
            white-space: nowrap;
        }
        .scope-options-chips {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px;
        }
        .scope-chip {
            min-width: 0;
            border: 1px solid rgba(148, 163, 184, 0.22);
            background: rgba(15, 23, 42, 0.95);
            color: #cbd5e1;
            border-radius: 6px;
            padding: 7px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            font-weight: 700;
            cursor: pointer;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .scope-chip:hover {
            border-color: rgba(56, 189, 248, 0.65);
            color: #7dd3fc;
        }
        .scope-chip.active {
            border-color: #fbbf24;
            background: rgba(251, 191, 36, 0.16);
            color: #facc15;
        }
        .scope-options-help {
            color: #64748b;
            font-size: 0.7rem;
            line-height: 1.35;
        }
        
        .panel {
            background: #020617;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            cursor: pointer;
        }
        
        /* Left main panel style */
        .active-panel {
            flex: 1;
            border: 2px solid #38bdf8;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
            cursor: default;
        }
        
        /* Middle panel stacked dynamic expansion */
        .option-panel {
            flex: 1;
            height: 0;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .option-panel:hover {
            flex: 2; /* dynamically grow while other panels shrink */
            border-color: #818cf8;
            box-shadow: 0 0 15px rgba(129, 140, 248, 0.2);
        }
        
        .panel-header {
            background: rgba(15,23,42,0.8);
            padding: 8px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #94a3b8;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            z-index: 200;
            gap: 8px;
        }
        .panel-header span:first-child {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .panel-body {
            flex: 1;
            position: relative;
            overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            transform-origin: center center;
        }
        
        .option-panel:hover .panel-body {
            transform: scale(1.08);
        }
        
        iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: transparent;
            pointer-events: auto;
        }
        
        /* Right Column: Chat & Feedback Controls */
        .side-panel {
            background: #05070c;
            display: flex;
            flex-direction: column;
            padding: 15px;
            overflow-y: auto;
            overflow-x: hidden;
            min-width: 0;
        }
